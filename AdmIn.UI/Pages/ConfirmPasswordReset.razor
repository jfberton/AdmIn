@page "/confirm-password-reset"
@using System.Net.Http.Json
@using Microsoft.AspNetCore.Authorization
@using AdmIn.UI.Components.Layout
@using Microsoft.AspNetCore.Components.Web
@using AdmIn.Common
@using AdmIn.Common.Entidades
@layout LoginLayout
@attribute [AllowAnonymous]
@inject IHttpClientFactory HttpClientFactory
@inject NavigationManager Nav
@inject IConfiguration Config
@inject IHostEnvironment Env

@if (loading)
{
    <div style="min-height:70vh;display:flex;align-items:center;justify-content:center;padding:2rem;">
   <div class="spinner-border text-primary" role="status">
 <span class="visually-hidden">Cargando...</span>
</div>
    </div>
}
else if (!tokenValido)
{
<div style="min-height:70vh;display:flex;align-items:center;justify-content:center;padding:2rem;">
   <div class="card reset-card p-4" style="width:420px;z-index:200;background:#fff;color:#111;border-radius:8px;box-shadow:0 8px 30px rgba(0,0,0,0.08);">
      <h4 class="mb-3 text-danger">Token Inválido</h4>
  
   <div class="alert alert-danger">
    @errorMessage
    </div>

<div class="text-muted mb-3" style="font-size:0.9rem;">
 El token puede haber expirado o ser inválido. Por favor, solicite un nuevo enlace de reseteo.
   </div>

   <div class="d-flex justify-content-end" style="gap:8px;">
 <button type="button" class="btn btn-outline-secondary" @onclick="@(() => Nav.NavigateTo("/"))">Ir al Login</button>
 <button type="button" class="btn btn-primary" @onclick="@(() => Nav.NavigateTo("/request-password-reset"))">Solicitar nuevo enlace</button>
        </div>
    </div>
</div>
}
else
{
<div style="min-height:70vh;display:flex;align-items:center;justify-content:center;padding:2rem;">
<div class="card reset-card p-4" style="width:420px;z-index:200;background:#fff;color:#111;border-radius:8px;box-shadow:0 8px 30px rgba(0,0,0,0.08);">
    <h4 class="mb-3">Restablecer contraseña</h4>

<div class="mb-3">
   <label class="form-label">Usuario</label>
   <input class="form-control" disabled value="@userName" />
     </div>

  <div class="mb-3">
   <label class="form-label">Email</label>
  <input class="form-control" disabled value="@email" />
 </div>

      <div class="mb-3">
      <label class="form-label">Nueva contraseña</label>
  <input type="password" 
     class="form-control" 
     @bind="nuevaPassword" 
        placeholder="Ingrese nueva contraseña"
 disabled="@enviando" />
        </div>

        <div class="mb-3">
       <label class="form-label">Repetir nueva contraseña</label>
     <input type="password" 
      class="form-control @(passwordsCoinciden ? "is-valid" : (!string.IsNullOrEmpty(confirmarPassword) ? "is-invalid" : ""))" 
     @bind="confirmarPassword"
  placeholder="Repita la nueva contraseña"
     disabled="@enviando" />
 @if (!string.IsNullOrEmpty(confirmarPassword) && !passwordsCoinciden)
  {
     <div class="invalid-feedback d-block">Las contraseñas no coinciden</div>
      }
        </div>

 @if (!string.IsNullOrEmpty(message))
   {
 <div class="alert @alertClass">@message</div>
 }

     <div class="d-flex justify-content-end" style="gap:8px;">
    <button type="button" class="btn btn-outline-secondary" @onclick="Cancelar" disabled="@enviando">Cancelar</button>
    <button type="button" 
 class="btn btn-primary" 
  @onclick="ActualizarPassword" 
         disabled="@(enviando || !FormularioValido)">
  @if (enviando)
     {
<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
    }
    Actualizar contraseña
     </button>
       </div>

            <div class="mt-3 text-muted" style="font-size:0.9rem;">
    Una vez actualizada la contraseña, será redirigido al login para iniciar sesión con sus nuevas credenciales.
            </div>
        </div>
  </div>
}

@code {
    private string? token;
    private string userName = string.Empty;
    private string email = string.Empty;
    private string apiBaseUrl = string.Empty;
    
    private string _nuevaPassword = string.Empty;
    private string nuevaPassword
    {
 get => _nuevaPassword;
        set
      {
_nuevaPassword = value;
  ValidatePasswordMatch();
 }
    }
  
    private string _confirmarPassword = string.Empty;
    private string confirmarPassword
 {
    get => _confirmarPassword;
  set
    {
    _confirmarPassword = value;
            ValidatePasswordMatch();
   }
    }
    
    private bool loading = true;
    private bool tokenValido = false;
private bool enviando = false;
  private string message = string.Empty;
    private string alertClass = "alert-info";
    private string errorMessage = string.Empty;
    private bool passwordsCoinciden = false;

    private bool FormularioValido => 
   !string.IsNullOrWhiteSpace(nuevaPassword) && 
    !string.IsNullOrWhiteSpace(confirmarPassword) && 
   passwordsCoinciden;

    protected override void OnInitialized()
    {
        // Get API base URL from configuration
   if (Env.IsDevelopment())
{
      apiBaseUrl = Config["Path_api_dev"] ?? "https://localhost:7189/api/";
     }
   else
        {
    apiBaseUrl = Config["Path_api_prod"] ?? "/api/";
        }
        
  // Ensure it ends with /
     if (!apiBaseUrl.EndsWith("/"))
     {
      apiBaseUrl += "/";
  }
    }

  protected override async Task OnInitializedAsync()
 {
  // Obtener el token de la URL
  var uri = Nav.ToAbsoluteUri(Nav.Uri);
 var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query);
 
   if (!query.TryGetValue("token", out var tokenValue))
    {
tokenValido = false;
  errorMessage = "No se proporcionó un token de reseteo.";
   loading = false;
    return;
      }

     token = tokenValue;

      try
 {
          var httpClient = HttpClientFactory.CreateClient();
      var url = $"{apiBaseUrl}usuario/token_info/{token}";
  
      // Validar el token con el servidor
      var resp = await httpClient.GetAsync(url);
    
  if (resp.IsSuccessStatusCode)
{
 var dto = await resp.Content.ReadFromJsonAsync<DTO<object>>();
  
      if (dto != null && dto.Correcto && dto.Datos != null)
     {
          // Deserializar el objeto Datos que contiene Usuario y Token
            var datosJson = System.Text.Json.JsonSerializer.Serialize(dto.Datos);
          var datosObj = System.Text.Json.JsonDocument.Parse(datosJson);
               
        if (datosObj.RootElement.TryGetProperty("Usuario", out var usuarioElement))
    {
           var usuarioJson = usuarioElement.GetRawText();
   var usuario = System.Text.Json.JsonSerializer.Deserialize<Usuario>(usuarioJson);
   
     if (usuario != null)
           {
                userName = usuario.Nombre ?? string.Empty;
    email = usuario.Email ?? string.Empty;
     tokenValido = true;
    }
else
{
              tokenValido = false;
         errorMessage = "No se pudo obtener información del usuario.";
        }
    }
         else
                {
   tokenValido = false;
      errorMessage = "Formato de respuesta inválido.";
     }
      }
   else
   {
tokenValido = false;
  errorMessage = dto?.Mensaje ?? "Token inválido o expirado.";
  }
   }
        else
    {
      tokenValido = false;
   errorMessage = "No se pudo validar el token. Por favor, solicite un nuevo enlace.";
      }
     }
catch (Exception ex)
    {
  tokenValido = false;
errorMessage = $"Error al validar el token: {ex.Message}";
 }
 finally
   {
    loading = false;
   StateHasChanged();
    }
 }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
   if (firstRender)
        {
      await InvokeAsync(StateHasChanged);
   }
    }

    private void ValidatePasswordMatch()
    {
 passwordsCoinciden = !string.IsNullOrWhiteSpace(nuevaPassword) && 
      !string.IsNullOrWhiteSpace(confirmarPassword) && 
    nuevaPassword == confirmarPassword;
   StateHasChanged();
    }

    private void Cancelar()
    {
 Nav.NavigateTo("/");
}

    private async Task ActualizarPassword()
    {
   message = string.Empty;
 alertClass = "alert-info";

   // Validaciones
   if (string.IsNullOrWhiteSpace(nuevaPassword))
{
  message = "Ingrese la nueva contraseña.";
       alertClass = "alert-danger";
     return;
    }

    if (string.IsNullOrWhiteSpace(confirmarPassword))
     {
   message = "Confirme la nueva contraseña.";
      alertClass = "alert-danger";
return;
      }

 if (nuevaPassword != confirmarPassword)
   {
      message = "Las contraseñas no coinciden.";
alertClass = "alert-danger";
 return;
}

   if (string.IsNullOrWhiteSpace(token))
   {
    message = "Token inválido o ausente.";
    alertClass = "alert-danger";
     return;
  }

  enviando = true;
        StateHasChanged();

   try
{
   var httpClient = HttpClientFactory.CreateClient();
   var url = $"{apiBaseUrl}usuario/reset_by_token";
      
     var resp = await httpClient.PostAsJsonAsync(url, new 
   { 
   token = token, 
  nuevaPassword = nuevaPassword 
    });
  
      if (resp.IsSuccessStatusCode)
  {
    var dto = await resp.Content.ReadFromJsonAsync<DTO<bool>>();
       
   if (dto != null && dto.Correcto)
    {
        message = "Contraseña actualizada correctamente. Redirigiendo al login...";
  alertClass = "alert-success";
 StateHasChanged();
      
   // Esperar para que el usuario vea el mensaje
     await Task.Delay(2000);
 Nav.NavigateTo("/", true);
   }
   else
   {
          message = dto?.Mensaje ?? "Error al restablecer la contraseña. Por favor, intente nuevamente.";
      alertClass = "alert-danger";
   }
    }
   else
        {
         message = "Error al procesar la solicitud. Por favor, intente nuevamente.";
     alertClass = "alert-danger";
   }
     }
      catch (Exception ex)
 {
   message = $"Error: {ex.Message}";
  alertClass = "alert-danger";
     }
        finally
   {
    enviando = false;
   StateHasChanged();
        }
    }
}
