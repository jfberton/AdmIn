@page "/request-password-reset"
@using System.Net.Http.Json
@using Microsoft.AspNetCore.Authorization
@using AdmIn.UI.Components.Layout
@using Microsoft.AspNetCore.Components.Web
@using AdmIn.Common
@layout LoginLayout
@attribute [AllowAnonymous]
@inject IHttpClientFactory HttpClientFactory
@inject NavigationManager Nav
@inject IConfiguration Config
@inject IHostEnvironment Env

<div style="min-height:70vh;display:flex;align-items:center;justify-content:center;padding:2rem;">
    <div class="card reset-card p-4" style="width:420px;z-index:200;background:#fff;color:#111;border-radius:8px;box-shadow:0 8px 30px rgba(0,0,0,0.08);">
        <h4 class="mb-3">Recuperar contraseña</h4>

        <div class="mb-3">
            <label class="form-label">Email registrado</label>
            <input type="email"
                   class="form-control @(isEmailValid ? "is-valid" : (!string.IsNullOrEmpty(email) ? "is-invalid" : ""))"
                   @bind="email"
                   placeholder="usuario@dominio.com"
                   autofocus
                   disabled="@enviando" />
            <div class="form-text">Ingrese el email asociado a su cuenta.</div>
        </div>

        @if (!string.IsNullOrEmpty(message))
        {
            <div class="alert @alertClass">@message</div>
        }

        <div class="d-flex justify-content-end" style="gap:8px;">
            <button type="button" class="btn btn-outline-secondary" @onclick="Cancelar" disabled="@enviando">Cancelar</button>
            <button type="button" class="btn btn-primary" @onclick="EnviarSolicitud" disabled="@(enviando || !isEmailValid)">
                @if (enviando)
                {
                    <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                }
                Solicitar enlace
            </button>
        </div>

        <div class="mt-3 text-muted" style="font-size:0.9rem;">
            Si el email existe en el sistema recibirás un correo con instrucciones. El link contendrá un token válido por un tiempo limitado.
        </div>
    </div>
</div>

@code {
    private string _email = string.Empty;
    private string email
    {
        get => _email;
        set
        {
            _email = value;
            ValidateEmail();
        }
    }

    private bool enviando = false;
    private string message = string.Empty;
    private string alertClass = "alert-info";
    private bool isEmailValid = false;
    private string apiBaseUrl = string.Empty;

    // Request model class
    private class RequestResetModel
    {
        public string email { get; set; } = string.Empty;
    }

    protected override void OnInitialized()
    {
        // Get API base URL from configuration
        if (Env.IsDevelopment())
        {
            apiBaseUrl = Config["Path_api_dev"] ?? "https://localhost:7189/api/";
        }
        else
        {
            apiBaseUrl = Config["Path_api_prod"] ?? "/api/";
        }

        // Ensure it ends with /
        if (!apiBaseUrl.EndsWith("/"))
        {
            apiBaseUrl += "/";
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await InvokeAsync(StateHasChanged);
        }
    }

    private void Cancelar()
    {
        Nav.NavigateTo("/");
    }

    private async Task EnviarSolicitud()
    {
        message = string.Empty;
        alertClass = "alert-info";

        if (string.IsNullOrWhiteSpace(email))
        {
            message = "Ingrese su email registrado";
            alertClass = "alert-danger";
            return;
        }

        if (!isEmailValid)
        {
            message = "Ingrese un email con formato válido.";
            alertClass = "alert-danger";
            return;
        }

        enviando = true;
        StateHasChanged();

        try
        {
            var httpClient = HttpClientFactory.CreateClient();
            var url = $"{apiBaseUrl}usuario/request_reset";

            var requestModel = new RequestResetModel { email = this.email };

            var resp = await httpClient.PostAsJsonAsync(url, requestModel);

            if (resp.IsSuccessStatusCode)
            {
                var dto = await resp.Content.ReadFromJsonAsync<DTO<bool>>();

                if (dto != null && dto.Correcto)
                {
                    message = "Se ha enviado un correo con instrucciones si el email está registrado.";
                    alertClass = "alert-success";
                    StateHasChanged();

                    // Esperar un momento para que el usuario vea el mensaje
                    await Task.Delay(2500);
                    Nav.NavigateTo("/", true);
                }
                else
                {
                    message = dto?.Mensaje ?? "Error enviando email";
                    alertClass = "alert-danger";
                }
            }
            else
            {
                message = "Error al procesar la solicitud. Por favor, intente nuevamente.";
                alertClass = "alert-danger";
            }
        }
        catch (Exception ex)
        {
            message = $"Error: {ex.Message}";
            alertClass = "alert-danger";
        }
        finally
        {
            enviando = false;
            StateHasChanged();
        }
    }

    private void ValidateEmail()
    {
        isEmailValid = IsValidEmail(email);

        if (!isEmailValid && !string.IsNullOrEmpty(email))
        {
            message = "Formato de email inválido.";
            alertClass = "alert-danger";
        }
        else
        {
            if (message == "Formato de email inválido." || message == "Ingrese un email con formato válido.")
            {
                message = string.Empty;
            }
        }
        StateHasChanged();
    }

    private static bool IsValidEmail(string email)
    {
        if (string.IsNullOrWhiteSpace(email)) return false;

        try
        {
            var pattern = @"^[^\s@]+@[^\s@]+\.[^\s@]+$";
            return System.Text.RegularExpressions.Regex.IsMatch(email, pattern, System.Text.RegularExpressions.RegexOptions.IgnoreCase);
        }
        catch
        {
            return false;
        }
    }
}
