@page "/email-test"
@using System.Net.Http.Json
@using AdmIn.Common
@inject IHttpClientFactory HttpClientFactory
@inject NavigationManager Nav
@inject IConfiguration Config
@inject IHostEnvironment Env

<h3>?? Prueba de Envío de Email</h3>

<div class="card mt-4" style="max-width: 600px;">
    <div class="card-body">
        <div class="mb-3">
            <label class="form-label">Email de destino</label>
            <input type="email" class="form-control" @bind="emailDestino" placeholder="tu@email.com" />
    </div>

        <div class="mb-3">
      <label class="form-label">Asunto</label>
 <input type="text" class="form-control" @bind="asunto" placeholder="Prueba de email" />
        </div>

        <div class="mb-3">
      <label class="form-label">Mensaje</label>
            <textarea class="form-control" @bind="mensaje" rows="4" placeholder="Contenido del email de prueba"></textarea>
        </div>

  <div class="mb-3">
  <label class="form-label">Tipo de prueba</label>
            <select class="form-select" @bind="tipoPrueba">
          <option value="simple">Email Simple</option>
       <option value="password_reset">Template Password Reset</option>
             <option value="new_user">Template Nuevo Usuario</option>
     </select>
    </div>

  @if (!string.IsNullOrEmpty(resultado))
        {
            <div class="alert @alertClass">
         <strong>@resultadoTitulo</strong>
           <pre style="margin-top: 10px; white-space: pre-wrap;">@resultado</pre>
   </div>
        }

        <div class="d-flex gap-2">
 <button class="btn btn-primary" @onclick="EnviarEmail" disabled="@enviando">
            @if (enviando)
       {
        <span class="spinner-border spinner-border-sm me-2"></span>
                }
        Enviar Prueba
     </button>
  
    <button class="btn btn-secondary" @onclick="VerConfiguracion" disabled="@enviando">
    Ver Configuración SMTP
            </button>

       <button class="btn btn-outline-secondary" @onclick="@(() => Nav.NavigateTo("/"))">
    Volver
         </button>
        </div>
    </div>
</div>

@if (mostrarConfiguracion)
{
    <div class="card mt-4" style="max-width: 600px;">
        <div class="card-header">
            <h5>?? Configuración SMTP Actual</h5>
        </div>
        <div class="card-body">
      <table class="table table-sm">
          <tbody>
            <tr>
     <td><strong>Host:</strong></td>
            <td>@smtpHost</td>
    </tr>
          <tr>
            <td><strong>Port:</strong></td>
            <td>@smtpPort</td>
  </tr>
      <tr>
     <td><strong>User:</strong></td>
      <td>@smtpUser</td>
            </tr>
      <tr>
     <td><strong>Password:</strong></td>
            <td>@(string.IsNullOrEmpty(smtpPass) ? "(no configurado)" : "????????")</td>
         </tr>
         <tr>
       <td><strong>EnableSSL:</strong></td>
         <td>@smtpEnableSsl</td>
      </tr>
              <tr>
            <td><strong>From:</strong></td>
          <td>@smtpFrom</td>
   </tr>
         </tbody>
   </table>

    <div class="alert alert-info mt-3">
  <strong>?? Nota:</strong> Para Gmail, necesitas:
     <ul class="mb-0">
         <li>Usar "smtp.gmail.com" como Host</li>
      <li>Puerto 587 (TLS) o 465 (SSL)</li>
      <li>EnableSSL = true</li>
      <li>Usar una "Contraseña de aplicación" (no tu contraseña normal)</li>
            <li>Generar en: <a href="https://myaccount.google.com/apppasswords" target="_blank">https://myaccount.google.com/apppasswords</a></li>
  </ul>
            </div>
        </div>
    </div>
}

@code {
    private string emailDestino = "fede.berton1@gmail.com";
    private string asunto = "Prueba de Email";
    private string mensaje = "Este es un email de prueba del sistema.";
  private string tipoPrueba = "simple";
    private bool enviando = false;
  private string resultado = string.Empty;
    private string resultadoTitulo = string.Empty;
    private string alertClass = "alert-info";
    private bool mostrarConfiguracion = false;
    private string apiBaseUrl = string.Empty;

    // Configuración SMTP
    private string smtpHost = "";
    private string smtpPort = "";
    private string smtpUser = "";
    private string smtpPass = "";
    private string smtpEnableSsl = "";
    private string smtpFrom = "";

    protected override void OnInitialized()
    {
   // Get API base URL
        if (Env.IsDevelopment())
        {
          apiBaseUrl = Config["Path_api_dev"] ?? "https://localhost:7189/api/";
        }
        else
     {
            apiBaseUrl = Config["Path_api_prod"] ?? "/api/";
    }

        if (!apiBaseUrl.EndsWith("/"))
        {
            apiBaseUrl += "/";
        }

        // Cargar configuración SMTP del UI (puede diferir del API)
  smtpHost = Config["Smtp:Host"] ?? "(no configurado)";
        smtpPort = Config["Smtp:Port"] ?? "(no configurado)";
        smtpUser = Config["Smtp:User"] ?? "(no configurado)";
        smtpPass = Config["Smtp:Pass"] ?? "";
        smtpEnableSsl = Config["Smtp:EnableSsl"] ?? "(no configurado)";
        smtpFrom = Config["Smtp:From"] ?? "(no configurado)";
    }

    private void VerConfiguracion()
    {
    mostrarConfiguracion = !mostrarConfiguracion;
    }

    private async Task EnviarEmail()
    {
        resultado = string.Empty;
     enviando = true;

 try
        {
     var httpClient = HttpClientFactory.CreateClient();
         var url = $"{apiBaseUrl}emailtest/send";

   var request = new
        {
    to = emailDestino,
     subject = asunto,
          body = mensaje,
                testType = tipoPrueba
  };

            var response = await httpClient.PostAsJsonAsync(url, request);

        if (response.IsSuccessStatusCode)
        {
     var dto = await response.Content.ReadFromJsonAsync<DTO<string>>();
        
           if (dto != null && dto.Correcto)
      {
              resultadoTitulo = "? Email enviado correctamente";
    resultado = dto.Mensaje;
           alertClass = "alert-success";
        }
       else
      {
    resultadoTitulo = "? Error al enviar email";
        resultado = dto?.Mensaje ?? "Error desconocido";
        alertClass = "alert-danger";
         }
            }
          else
            {
     var errorContent = await response.Content.ReadAsStringAsync();
      resultadoTitulo = $"? Error HTTP {response.StatusCode}";
  resultado = errorContent;
  alertClass = "alert-danger";
  }
        }
        catch (Exception ex)
   {
            resultadoTitulo = "? Excepción al enviar email";
            resultado = $"Tipo: {ex.GetType().Name}\nMensaje: {ex.Message}\nStack: {ex.StackTrace}";
            alertClass = "alert-danger";
        }
     finally
  {
         enviando = false;
        }
    }
}
