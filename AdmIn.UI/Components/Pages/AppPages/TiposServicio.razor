@page "/tipos-servicio"

@inherits BaseComponent

@using AdmIn.Common.Entidades
@using AdmIn.Common
@using AdmIn.UI.Services
@using AdmIn.UI.Services.UtilityServices
@using Microsoft.AspNetCore.Components.Authorization

@inject IServ_TipoServicio Serv_tipoServicio;

<MiRadzenButton ButtonStyle="ButtonStyle.Primary" Text="Agregar tipo de servicio" OnClick="@(() => Agregar())" />

<RadzenDataGrid class="rz-m-2" @ref="grilla" IsLoading=@isLoading Count="@count" Data="@items" EmptyText="No hay registros para mostrar"
LoadData="@LoadData" AllowSorting="true" AllowFiltering="true" FilterMode="FilterMode.Simple" AllowPaging="true" PageSize="5"
PagerHorizontalAlign="HorizontalAlign.Center" TItem="TipoServicio">
    <Columns>
        <RadzenDataGridColumn TItem="TipoServicio" Property="Nombre" Title="Nombre" MinWidth="200px" />
        <RadzenDataGridColumn TItem="TipoServicio" Property="Descripcion" Title="Descripción" MinWidth="300px">
            <Template Context="tipoServicio">
                @if (!string.IsNullOrWhiteSpace(tipoServicio.Descripcion))
                {
                    <span>@tipoServicio.Descripcion</span>
                }
                else
                {
                    <em class="text-muted">Sin descripción</em>
                }
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Width="250px" TItem="TipoServicio" Context="tipoServicio" MinWidth="250px">
            <Template>
                <MiRadzenButton ButtonStyle="ButtonStyle.Primary" Variant="Variant.Outlined" Shade="Shade.Lighter" Title="Ver" Icon="visibility" Size="ButtonSize.ExtraSmall" OnClick=@(() => Ver(tipoServicio)) />
                <AuthorizeView Roles="admin_usuario">
                    <Authorized>
                        <MiRadzenButton ButtonStyle="ButtonStyle.Primary" Variant="Variant.Outlined" Shade="Shade.Lighter" Title="Editar" Icon="edit" Size="ButtonSize.ExtraSmall" OnClick=@(() => Editar(tipoServicio)) />
                        <MiRadzenButton ButtonStyle="ButtonStyle.Danger" Variant="Variant.Outlined" Shade="Shade.Lighter" Title="Eliminar" Icon="delete" Size="ButtonSize.ExtraSmall" OnClick=@(() => Eliminar(tipoServicio)) />
                    </Authorized>
                </AuthorizeView>
            </Template>
        </RadzenDataGridColumn>
    </Columns>
</RadzenDataGrid>

@code {
    RadzenDataGrid<TipoServicio> grilla;

    bool isLoading = false;
    int count;
    IEnumerable<TipoServicio> items;

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        base.EstablecerTituloPagina("Tipos de Servicio", "Listado");
    }

    async Task LoadData(LoadDataArgs args)
    {
        isLoading = true;

        try
        {
            Filtros_paginado filtros = new Filtros_paginado
            {
                Skip = args.Skip.HasValue ? args.Skip.Value : 0,
                Top = args.Top.HasValue ? args.Top.Value : 5,
                OrderBy = !string.IsNullOrEmpty(args.OrderBy) ? args.OrderBy : "Nombre",
                Filter = args.Filter
            };

            var rta = await Serv_tipoServicio.Obtener_paginado(filtros);

            if (rta.Correcto)
            {
                items = rta.Datos.Items;
                count = rta.Datos.Total_items;
            }
            else
            {
                base.MostrarNotificacion(NotificationSeverity.Error, "Error!", rta.Mensaje);
            }
        }
        catch (Exception ex)
        {
            base.MostrarNotificacion(NotificationSeverity.Error, "Error!", $"Error al cargar tipos de servicio: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    void Agregar()
    {
        base.IrA("/tipos-servicio/nuevo");
    }

    void Ver(TipoServicio tipoServicio)
    {
        base.IrA($"/tipos-servicio/detalle/{tipoServicio.Id}");
    }

    void Editar(TipoServicio tipoServicio)
    {
        base.IrA($"/tipos-servicio/modificar/{tipoServicio.Id}");
    }

    async Task Eliminar(TipoServicio tipoServicio)
    {
        try
        {
            var confirmResult = await base.MostrarConfirmacion("¿Está seguro de eliminar el tipo de servicio '" + tipoServicio.Nombre + "'?", "Confirmar eliminación");

            if (confirmResult == true)
            {
                var rta = await Serv_tipoServicio.Eliminar(tipoServicio.Id);

                if (rta.Correcto)
                {
                    base.MostrarNotificacion(NotificationSeverity.Success, "Éxito!", "Tipo de servicio eliminado correctamente");
                    await grilla.Reload();
                }
                else
                {
                    base.MostrarNotificacion(NotificationSeverity.Error, "Error!", rta.Mensaje);
                }
            }
        }
        catch (Exception ex)
        {
            base.MostrarNotificacion(NotificationSeverity.Error, "Error!", $"Error al eliminar tipo de servicio: {ex.Message}");
        }
    }
}