@page "/proveedores"

@inherits BaseComponent

@using AdmIn.Common
@using AdmIn.Common.Entidades
@using AdmIn.UI.Services
@using AdmIn.UI.Services.UtilityServices
@using Microsoft.AspNetCore.Components.Authorization

@inject IServ_Proveedor ServicioProveedor
@inject IServ_Usuario ServicioUsuario

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3>Gestión de Proveedores</h3>
    <button class="btn btn-primary" @onclick="NuevoProveedor">
        <i class="fas fa-plus"></i> Nuevo Proveedor
    </button>
</div>

<!-- Filtros Avanzados -->
<div class="card mb-4">
    <div class="card-body">
        <div class="row g-3">
            <div class="col-md-4">
                <label class="form-label">Buscar:</label>
                <input type="text" class="form-control" @bind="filtroTexto" 
                       @onkeypress="@(async (e) => { if (e.Key == "Enter") await RecargarGrilla(); })"
                       placeholder="Nombre, RFC o Email..." />
            </div>
            <div class="col-md-2">
                <label class="form-label">Ordenar por:</label>
                <select class="form-select" @bind="ordenarPor" @bind:after="RecargarGrilla">
                    <option value="Nombre">Nombre</option>
                    <option value="RFC">RFC</option>
                    <option value="Email">Email</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label">Estado:</label>
                <select class="form-select" @bind="filtroEstado" @bind:after="RecargarGrilla">
                    <option value="todos">Todos</option>
                    <option value="activos">Activos</option>
                    <option value="inactivos">Inactivos</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label">Por página:</label>
                <select class="form-select" @bind="tamanioPagina" @bind:after="RecargarGrilla">
                    <option value="5">5</option>
                    <option value="10">10</option>
                    <option value="25">25</option>
                    <option value="50">50</option>
                </select>
            </div>
            <div class="col-md-2 d-flex align-items-end">
                <button class="btn btn-outline-primary w-100" @onclick="RecargarGrilla">
                    <i class="fas fa-search"></i> Buscar
                </button>
            </div>
        </div>
    </div>
</div>

<RadzenDataGrid class="rz-m-2 modern-grid" @ref="grilla" IsLoading=@isLoading Count="@count" Data="@itemsConUsuarios" EmptyText="No hay registros para mostrar"
LoadData="@LoadData" AllowSorting="false" AllowFiltering="false" AllowPaging="true" PageSize="@tamanioPagina"
PagerHorizontalAlign="HorizontalAlign.Center" TItem="ProveedorConUsuario">
    <Columns>
        <RadzenDataGridColumn TItem="ProveedorConUsuario" Width="60px" Title="ID" MinWidth="60px" Sortable="false">
            <Template Context="item">
                <div class="id-cell">
                    @item.Proveedor.Id
                </div>
            </Template>
        </RadzenDataGridColumn>
        
        <RadzenDataGridColumn TItem="ProveedorConUsuario" Width="80px" Title="Foto" MinWidth="80px" Sortable="false">
            <Template Context="item">
                <div class="photo-cell">
                    @if (item.Usuario?.ImagenPerfil != null)
                    {
                        <img src="@ObtenerUrlImagenPerfil(item.Usuario)" 
                             alt="@item.Proveedor.Nombre" 
                             class="profile-photo" />
                    }
                    else
                    {
                        <div class="profile-photo-placeholder">
                            <i class="fas fa-user"></i>
                        </div>
                    }
                </div>
            </Template>
        </RadzenDataGridColumn>
        
        <RadzenDataGridColumn TItem="ProveedorConUsuario" Title="Nombre" MinWidth="180px">
            <Template Context="item">
                <div class="name-cell">
                    <strong>@item.Proveedor.Nombre</strong>
                </div>
            </Template>
        </RadzenDataGridColumn>
        
        <RadzenDataGridColumn TItem="ProveedorConUsuario" Title="RFC" MinWidth="120px">
            <Template Context="item">
                <div class="rfc-cell">
                    @item.Proveedor.RFC
                </div>
            </Template>
        </RadzenDataGridColumn>
        
        <RadzenDataGridColumn TItem="ProveedorConUsuario" Title="Email" MinWidth="220px">
            <Template Context="item">
                <div class="email-cell">
                    @if (!string.IsNullOrEmpty(item.Proveedor.Email))
                    {
                        <a href="mailto:@item.Proveedor.Email" class="email-link">@item.Proveedor.Email</a>
                    }
                    else
                    {
                        <span class="text-muted">No especificado</span>
                    }
                </div>
            </Template>
        </RadzenDataGridColumn>
        
        <RadzenDataGridColumn TItem="ProveedorConUsuario" Title="Teléfono" MinWidth="140px">
            <Template Context="item">
                <div class="phone-cell">
                    @if (!string.IsNullOrEmpty(item.Proveedor.Telefono))
                    {
                        <a href="tel:@item.Proveedor.Telefono" class="phone-link">@item.Proveedor.Telefono</a>
                    }
                    else
                    {
                        <span class="text-muted">No especificado</span>
                    }
                </div>
            </Template>
        </RadzenDataGridColumn>
        
        <RadzenDataGridColumn TItem="ProveedorConUsuario" Title="Estado" MinWidth="100px" Sortable="false">
            <Template Context="item">
                <div class="status-cell">
                    <span class="badge status-badge @(item.Proveedor.Activo ? "bg-success" : "bg-secondary")">
                        @(item.Proveedor.Activo ? "Activo" : "Inactivo")
                    </span>
                </div>
            </Template>
        </RadzenDataGridColumn>
        
        <RadzenDataGridColumn TItem="ProveedorConUsuario" Title="Fecha Creación" MinWidth="130px" Sortable="false">
            <Template Context="item">
                <div class="date-cell">
                    @item.Proveedor.FechaCreacion.ToString("dd/MM/yyyy")
                </div>
            </Template>
        </RadzenDataGridColumn>
        
        <RadzenDataGridColumn Width="180px" TItem="ProveedorConUsuario" Title="Acciones" MinWidth="180px" Sortable="false">
            <Template Context="item">
                <div class="actions-cell">
                    <MiRadzenButton ButtonStyle="ButtonStyle.Primary" Variant="Variant.Outlined" Shade="Shade.Lighter" 
                                   Title="Ver" Icon="visibility" Size="ButtonSize.ExtraSmall" 
                                   OnClick=@(() => VerDetalle(item.Proveedor)) />
                    <AuthorizeView Roles="admin_usuario">
                        <Authorized>
                            <MiRadzenButton ButtonStyle="ButtonStyle.Primary" Variant="Variant.Outlined" Shade="Shade.Lighter" 
                                           Title="Editar" Icon="edit" Size="ButtonSize.ExtraSmall" 
                                           OnClick=@(() => EditarProveedor(item.Proveedor)) />
                            <MiRadzenButton ButtonStyle="ButtonStyle.Danger" Variant="Variant.Outlined" Shade="Shade.Lighter" 
                                           Title="Eliminar" Icon="delete" Size="ButtonSize.ExtraSmall" 
                                           OnClick=@(() => EliminarProveedor(item.Proveedor)) />
                        </Authorized>
                    </AuthorizeView>
                </div>
            </Template>
        </RadzenDataGridColumn>
    </Columns>
</RadzenDataGrid>

<style>
