    /* Mejorar el estilo general de la grilla */
    .modern-grid .rz-data-grid-header {
        background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
        border-bottom: 2px solid #dee2e6;
    }

    .modern-grid .rz-data-grid-header th {
