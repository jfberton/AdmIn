        font-size: 0.9rem;
        color: #495057;
    }

    .email-cell .email-link {
        color: #007bff;
        text-decoration: none;
        font-size: 0.9rem;
    }

    .email-cell .email-link:hover {
        text-decoration: underline;
    }

    .phone-cell .phone-link {
        color: #28a745;
