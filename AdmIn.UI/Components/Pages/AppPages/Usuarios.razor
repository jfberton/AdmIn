@page "/usuarios"

@inherits BaseComponent

@using AdmIn.Common.Entidades
@using AdmIn.Common
@using AdmIn.UI.Services
@using AdmIn.UI.Services.UtilityServices
@using Microsoft.AspNetCore.Components.Authorization

@inject IServ_Usuario Serv_usuario;

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3>Gestión de Usuarios</h3>
    <button class="btn btn-primary" @onclick="NuevoUsuario">
        <i class="fas fa-plus"></i> Nuevo Usuario
    </button>
</div>

<!-- Filtros Avanzados -->
<div class="card mb-4">
    <div class="card-body">
        <div class="row g-3">
            <div class="col-md-4">
                <label class="form-label">Buscar:</label>
                <input type="text" class="form-control" @bind="filtroTexto" 
                       @onkeypress="@(async (e) => { if (e.Key == "Enter") await RecargarGrilla(); })"
                       placeholder="Nombre, email o teléfono..." />
            </div>
            <div class="col-md-2">
                <label class="form-label">Ordenar por:</label>
                <select class="form-select" @bind="ordenarPor" @bind:after="RecargarGrilla">
                    <option value="Nombre">Nombre</option>
                    <option value="Email">Email</option>
                    <option value="FechaCreacion">Fecha Creación</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label">Estado:</label>
                <select class="form-select" @bind="filtroEstado" @bind:after="RecargarGrilla">
                    <option value="todos">Todos</option>
                    <option value="activos">Activos</option>
                    <option value="inactivos">Inactivos</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label">Por página:</label>
                <select class="form-select" @bind="tamanioPagina" @bind:after="RecargarGrilla">
                    <option value="5">5</option>
                    <option value="10">10</option>
                    <option value="25">25</option>
                    <option value="50">50</option>
                </select>
            </div>
            <div class="col-md-2 d-flex align-items-end">
                <button class="btn btn-outline-primary w-100" @onclick="RecargarGrilla">
                    <i class="fas fa-search"></i> Buscar
                </button>
            </div>
        </div>
    </div>
</div>

<RadzenDataGrid class="rz-m-2" @ref="grilla" IsLoading=@isLoading Count="@count" Data="@items" EmptyText="No hay registros para mostrar"
LoadData="@LoadData" AllowSorting="false" AllowFiltering="false" AllowPaging="true" PageSize="@tamanioPagina"
PagerHorizontalAlign="HorizontalAlign.Center" TItem="Usuario">
    <Columns>
        <RadzenDataGridColumn TItem="Usuario" Property="Nombre" Title="Nombre" MinWidth="150px" />
        <RadzenDataGridColumn TItem="Usuario" Property="Email" Title="Email" MinWidth="200px" />
        <RadzenDataGridColumn TItem="Usuario" Property="Pais" Title="País" MinWidth="120px" />
        <RadzenDataGridColumn TItem="Usuario" Property="Telefono" Title="Teléfono" MinWidth="120px" />
        <RadzenDataGridColumn TItem="Usuario" Title="Moneda" MinWidth="100px" Filterable="false">
            <Template Context="usu">
                @(usu.Moneda?.Nombre ?? "No asignada")
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="Usuario" Title="Activo" MinWidth="80px" Filterable="false">
            <Template Context="usu">
                <span class="badge @(usu.Activo ? "bg-success" : "bg-secondary")">
                    @(usu.Activo ? "Activo" : "Inactivo")
                </span>
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="Usuario" Property="RolString" Title="Roles" MinWidth="150px" />
        <RadzenDataGridColumn Width="250px" TItem="Usuario" Context="usu" MinWidth="250px">
            <Template>
                <MiRadzenButton ButtonStyle="ButtonStyle.Primary" Variant="Variant.Outlined" Shade="Shade.Lighter" Title="Ver" Icon="visibility" Size="ButtonSize.ExtraSmall" OnClick=@(() => Ver(usu)) />
                <AuthorizeView Roles="admin_usuario">
                    <Authorized>
                        <MiRadzenButton ButtonStyle="ButtonStyle.Success" Variant="Variant.Outlined" Shade="Shade.Lighter" Title="Modificar" Icon="edit" Size="ButtonSize.ExtraSmall" OnClick=@(() => Modificar(usu)) />
                        <MiRadzenButton ButtonStyle="ButtonStyle.Success" Variant="Variant.Outlined" Shade="Shade.Lighter" Title="Modificar contraseña" Icon="password" Size="ButtonSize.ExtraSmall" OnClick=@(() => ModificarContraseña(usu)) />
                        <MiRadzenButton ButtonStyle="ButtonStyle.Danger" Variant="Variant.Outlined" Shade="Shade.Lighter" Title="Eliminar" Icon="delete" Size="ButtonSize.ExtraSmall" OnClick=@(() => Eliminar(usu)) />
                    </Authorized>
                </AuthorizeView>
            </Template>
        </RadzenDataGridColumn>
    </Columns>
</RadzenDataGrid>

@code {
    private bool isLoading = false;
    private RadzenDataGrid<Usuario> grilla;
    private int count;
    private IEnumerable<Usuario> items;
    
    // Filtros avanzados
    string filtroTexto = "";
    string ordenarPor = "Nombre";
    string filtroEstado = "todos";
    int tamanioPagina = 10;

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        base.EstablecerTituloPagina("Usuarios", "Principal");
    }

    private async Task LoadData(LoadDataArgs args)
    {
        if (!isLoading)
        {
            isLoading = true;

            await Task.Yield();

            try
            {
                Filtros_paginado filtros = new Filtros_paginado
                {
                    Filter = filtroTexto,
                    OrderBy = ordenarPor,
                    Skip = args.Skip != null ? args.Skip.Value : 0,
                    Top = args.Top != null ? args.Top.Value : tamanioPagina
                };

                DTO<Items_pagina<Usuario>> respuesta = await Serv_usuario.Obtener_paginado(filtros);

                if (respuesta != null && respuesta.Correcto)
                {
                    var usuarios = respuesta.Datos.Items.ToList();

                    // Aplicar filtro por estado si es necesario
                    if (filtroEstado != "todos")
                    {
                        usuarios = usuarios.Where(u => 
                            filtroEstado == "activos" ? u.Activo : !u.Activo).ToList();
                    }

                    items = usuarios;
                    count = usuarios.Count; // Para simplicidad, usamos el conteo filtrado
                }
                else
                {
                    if (respuesta != null && !respuesta.Correcto)
                        base.MostrarNotificacion(NotificationSeverity.Error, "Error al obtener los usuarios", $"Error: {respuesta.Mensaje}");

                    items = null;
                    count = 0;
                }
            }
            catch (Exception ex)
            {
                base.MostrarNotificacion(NotificationSeverity.Error, "Error!", $"Error al cargar usuarios: {ex.Message}");
                items = null;
                count = 0;
            }
        }

        isLoading = false;
    }

    async Task RecargarGrilla()
    {
        if (grilla != null)
        {
            await grilla.FirstPage();
        }
    }

    private void NuevoUsuario()
    {
        base.IrA("/usuarios/new");
    }

    private async Task Ver(Usuario usuario)
    {
        base.IrA($"/usuarios/view/{usuario.Id}");
    }

    private async Task Modificar(Usuario usuario)
    {
        base.IrA($"/usuarios/update/{usuario.Id}");
    }

    private async Task ModificarContraseña(Usuario usuario)
    {
        base.IrA($"/usuarios/update-password/{usuario.Id}/usuarios");
    }

    private async Task Eliminar(Usuario usuario)
    {
        try
        {
            var confirmResult = await base.MostrarConfirmacion("¿Está seguro de eliminar el usuario '" + usuario.Nombre + "'?", "Confirmar eliminación");

            if (confirmResult == true)
            {
                // TODO: Implementar eliminación de usuario
                base.MostrarNotificacion(NotificationSeverity.Info, "Pendiente", "Funcionalidad de eliminación pendiente de implementar");
            }
        }
        catch (Exception ex)
        {
            base.MostrarNotificacion(NotificationSeverity.Error, "Error!", $"Error al eliminar usuario: {ex.Message}");
        }
    }
}