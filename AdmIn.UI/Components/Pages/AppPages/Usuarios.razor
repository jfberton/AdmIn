@page "/usuarios"

@inherits BaseComponent

@using AdmIn.Common.Entidades
@using AdmIn.Common
@using AdmIn.UI.Services
@using AdmIn.UI.Services.UtilityServices
@using Microsoft.AspNetCore.Components.Authorization

@inject IServ_Usuario Serv_usuario;

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3>Gestión de Usuarios</h3>
    <button class="btn btn-primary" @onclick="NuevoUsuario">
        <i class="fas fa-plus"></i> Nuevo Usuario
    </button>
</div>

<!-- Filtros Avanzados -->
<div class="card mb-4">
    <div class="card-body">
        <div class="row g-3">
            <div class="col-md-4">
                <label class="form-label">Buscar:</label>
                <input type="text" class="form-control" @bind="filtroTexto" 
                       @onkeypress="@(async (e) => { if (e.Key == "Enter") await RecargarGrilla(); })"
                       placeholder="Nombre, email o teléfono..." />
            </div>
            <div class="col-md-2">
                <label class="form-label">Ordenar por:</label>
                <select class="form-select" @bind="ordenarPor" @bind:after="RecargarGrilla">
                    <option value="Nombre">Nombre</option>
                    <option value="Email">Email</option>
                    <option value="FechaCreacion">Fecha Creación</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label">Estado:</label>
                <select class="form-select" @bind="filtroEstado" @bind:after="RecargarGrilla">
                    <option value="todos">Todos</option>
                    <option value="activos">Activos</option>
                    <option value="inactivos">Inactivos</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label">Por página:</label>
                <select class="form-select" @bind="tamanioPagina" @bind:after="RecargarGrilla">
                    <option value="5">5</option>
                    <option value="10">10</option>
                    <option value="25">25</option>
                    <option value="50">50</option>
                </select>
            </div>
            <div class="col-md-2 d-flex align-items-end">
                <button class="btn btn-outline-primary w-100" @onclick="RecargarGrilla">
                    <i class="fas fa-search"></i> Buscar
                </button>
            </div>
        </div>
    </div>
</div>

<RadzenDataGrid class="rz-m-2 modern-grid" @ref="grilla" IsLoading=@isLoading Count="@count" Data="@items" EmptyText="No hay registros para mostrar"
LoadData="@LoadData" AllowSorting="false" AllowFiltering="false" AllowPaging="true" PageSize="@tamanioPagina"
PagerHorizontalAlign="HorizontalAlign.Center" TItem="Usuario">
    <Columns>
        <RadzenDataGridColumn TItem="Usuario" Width="60px" Title="ID" MinWidth="60px" Sortable="false">
            <Template Context="usuario">
                <div class="id-cell">
                    @usuario.Id
                </div>
            </Template>
        </RadzenDataGridColumn>
        
        <RadzenDataGridColumn TItem="Usuario" Width="80px" Title="Foto" MinWidth="80px" Sortable="false">
            <Template Context="usuario">
                <div class="photo-cell">
                    @{
                        var urlImagen = ObtenerUrlImagenPerfil(usuario);
                    }
                    @if (!string.IsNullOrEmpty(urlImagen))
                    {
                        <img src="@urlImagen" 
                             alt="@usuario.Nombre" 
                             class="profile-photo"
                             onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />
                        <div class="profile-photo-placeholder" style="display: none;">
                            <i class="fas fa-user"></i>
                        </div>
                    }
                    else
                    {
                        <div class="profile-photo-placeholder">
                            <i class="fas fa-user"></i>
                        </div>
                    }
                </div>
            </Template>
        </RadzenDataGridColumn>
        
        <RadzenDataGridColumn TItem="Usuario" Title="Nombre" MinWidth="180px">
            <Template Context="usuario">
                <div class="name-cell">
                    <strong>@usuario.Nombre</strong>
                </div>
            </Template>
        </RadzenDataGridColumn>
        
        <RadzenDataGridColumn TItem="Usuario" Title="Email" MinWidth="220px">
            <Template Context="usuario">
                <div class="email-cell">
                    @if (!string.IsNullOrEmpty(usuario.Email))
                    {
                        <a href="mailto:@usuario.Email" class="email-link">@usuario.Email</a>
                    }
                    else
                    {
                        <span class="text-muted">No especificado</span>
                    }
                </div>
            </Template>
        </RadzenDataGridColumn>
        
        <RadzenDataGridColumn TItem="Usuario" Title="País" MinWidth="120px">
            <Template Context="usuario">
                <div class="country-cell">
                    @if (!string.IsNullOrEmpty(usuario.Pais))
                    {
                        <span class="country-badge">@usuario.Pais</span>
                    }
                    else
                    {
                        <span class="text-muted">No especificado</span>
                    }
                </div>
            </Template>
        </RadzenDataGridColumn>
        
        <RadzenDataGridColumn TItem="Usuario" Title="Teléfono" MinWidth="140px">
            <Template Context="usuario">
                <div class="phone-cell">
                    @if (!string.IsNullOrEmpty(usuario.Telefono))
                    {
                        <a href="tel:@usuario.Telefono" class="phone-link">@usuario.Telefono</a>
                    }
                    else
                    {
                        <span class="text-muted">No especificado</span>
                    }
                </div>
            </Template>
        </RadzenDataGridColumn>
        
        <RadzenDataGridColumn TItem="Usuario" Title="Moneda" MinWidth="100px" Sortable="false">
            <Template Context="usuario">
                <div class="currency-cell">
                    @if (usuario.Moneda != null)
                    {
                        <span class="currency-badge">@usuario.Moneda.Codigo</span>
                    }
                    else
                    {
                        <span class="text-muted">No asignada</span>
                    }
                </div>
            </Template>
        </RadzenDataGridColumn>
        
        <RadzenDataGridColumn TItem="Usuario" Title="Estado" MinWidth="100px" Sortable="false">
            <Template Context="usuario">
                <div class="status-cell">
                    <span class="badge status-badge @(usuario.Activo ? "bg-success" : "bg-secondary")">
                        @(usuario.Activo ? "Activo" : "Inactivo")
                    </span>
                </div>
            </Template>
        </RadzenDataGridColumn>
        
        <RadzenDataGridColumn TItem="Usuario" Title="Roles" MinWidth="150px">
            <Template Context="usuario">
                <div class="roles-cell">
                    @if (!string.IsNullOrEmpty(usuario.RolString))
                    {
                        <span class="roles-text">@usuario.RolString</span>
                    }
                    else
                    {
                        <span class="text-muted">Sin roles</span>
                    }
                </div>
            </Template>
        </RadzenDataGridColumn>
        
        <RadzenDataGridColumn Width="200px" TItem="Usuario" Title="Acciones" MinWidth="200px" Sortable="false">
            <Template Context="usuario">
                <div class="actions-cell">
                    <MiRadzenButton ButtonStyle="ButtonStyle.Primary" Variant="Variant.Outlined" Shade="Shade.Lighter" 
                                   Title="Ver" Icon="visibility" Size="ButtonSize.ExtraSmall" 
                                   OnClick=@(() => Ver(usuario)) />
                    <AuthorizeView Roles="admin_usuario">
                        <Authorized>
                            <MiRadzenButton ButtonStyle="ButtonStyle.Success" Variant="Variant.Outlined" Shade="Shade.Lighter" 
                                           Title="Modificar" Icon="edit" Size="ButtonSize.ExtraSmall" 
                                           OnClick=@(() => Modificar(usuario)) />
                            <MiRadzenButton ButtonStyle="ButtonStyle.Warning" Variant="Variant.Outlined" Shade="Shade.Lighter" 
                                           Title="Modificar contraseña" Icon="password" Size="ButtonSize.ExtraSmall" 
                                           OnClick=@(() => ModificarContraseña(usuario)) />
                            <MiRadzenButton ButtonStyle="ButtonStyle.Danger" Variant="Variant.Outlined" Shade="Shade.Lighter" 
                                           Title="Eliminar" Icon="delete" Size="ButtonSize.ExtraSmall" 
                                           OnClick=@(() => Eliminar(usuario)) />
                        </Authorized>
                    </AuthorizeView>
                </div>
            </Template>
        </RadzenDataGridColumn>
    </Columns>
</RadzenDataGrid>

<style>
    .modern-grid {
        border-radius: 8px;
        overflow: hidden;
        box-shadow: 0 2px 8px rgba(0,0,0,0.1);
    }

    .photo-cell {
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 8px;
    }

    .profile-photo {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        object-fit: cover;
        border: 2px solid #e9ecef;
        transition: border-color 0.3s ease;
