    .profile-photo:hover {
        border-color: #007bff;
    }

    .profile-photo-placeholder {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        background-color: #f8f9fa;
        border: 2px solid #e9ecef;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #6c757d;
        font-size: 16px;
    }

    .id-cell {
        font-weight: 600;
        color: #6c757d;
        font-size: 0.9rem;
    }

    .name-cell strong {
        color: #2c3e50;
        font-size: 0.95rem;
    }

    .email-cell .email-link {
        color: #007bff;
        text-decoration: none;
        font-size: 0.9rem;
    }

    .email-cell .email-link:hover {
        text-decoration: underline;
    }

    .country-cell .country-badge {
        background-color: #e3f2fd;
        color: #1976d2;
        padding: 0.25rem 0.5rem;
        border-radius: 0.5rem;
        font-size: 0.8rem;
        font-weight: 500;
    }

    .phone-cell .phone-link {
        color: #28a745;
        text-decoration: none;
        font-size: 0.9rem;
    }

    .phone-cell .phone-link:hover {
        text-decoration: underline;
    }

    .currency-cell .currency-badge {
        background-color: #fff3cd;
        color: #856404;
        padding: 0.25rem 0.5rem;
        border-radius: 0.5rem;
        font-size: 0.8rem;
        font-weight: 600;
        font-family: 'Courier New', monospace;
    }

    .status-cell {
        display: flex;
        justify-content: center;
    }

    .status-badge {
        font-size: 0.8rem;
        padding: 0.35rem 0.65rem;
        border-radius: 1rem;
    }

    .roles-cell .roles-text {
        background-color: #f8f9fa;
        color: #495057;
        padding: 0.25rem 0.5rem;
        border-radius: 0.5rem;
        font-size: 0.8rem;
        border: 1px solid #dee2e6;
    }

    .actions-cell {
        display: flex;
        gap: 4px;
        justify-content: center;
        align-items: center;
        flex-wrap: wrap;
    }

    /* Mejorar el estilo general de la grilla */
    .modern-grid .rz-data-grid-header {
        background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
        border-bottom: 2px solid #dee2e6;
    }

    .modern-grid .rz-data-grid-header th {
        font-weight: 600;
        color: #495057;
        font-size: 0.9rem;
        padding: 1rem 0.75rem;
    }

    .modern-grid .rz-data-grid-data tr:nth-child(even) {
