@page "/proveedores/modificar/{ProveedorId:int}"
@using AdmIn.Common
@using AdmIn.Common.Entidades
@using AdmIn.UI.Services
@using AdmIn.UI.Components.Shared
@inject IServ_Proveedor ServicioProveedor
@inject IServ_Usuario ServicioUsuario
@inject IServ_TipoServicio ServicioTipoServicio
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@inject DialogService dialogService

<PageTitle>Modificar Proveedor</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3>Modificar Proveedor</h3>
    <button class="btn btn-outline-secondary" @onclick="Regresar">
        <i class="fas fa-arrow-left"></i> Regresar
    </button>
</div>

@if (cargando)
{
    <div class="d-flex justify-content-center">
        <div class="spinner-border" role="status">
            <span class="visually-hidden">Cargando...</span>
        </div>
    </div>
}
else if (proveedor == null)
{
    <div class="alert alert-danger">
        <h5>Error</h5>
        <p>No se pudo cargar la información del proveedor.</p>
    </div>
}
else
{
    <div class="row">
        <div class="col-lg-8">
            <div class="card">
                <div class="card-body">
                    <EditForm Model="proveedor" OnValidSubmit="GuardarProveedor">
                        <DataAnnotationsValidator />
                        
                        <!-- Información básica -->
                        <h5 class="card-title mb-3">
                            <i class="fas fa-user"></i> Información Básica
                        </h5>
                        
                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <label class="form-label">Nombre <span class="text-danger">*</span></label>
                                <InputText class="form-control" @bind-Value="proveedor.Nombre" 
                                           placeholder="Ingrese el nombre del proveedor" />
                                <ValidationMessage For="@(() => proveedor.Nombre)" class="text-danger" />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label">RFC <span class="text-danger">*</span></label>
                                <InputText class="form-control" @bind-Value="proveedor.RFC" 
                                           @onblur="ValidarRFC"
                                           placeholder="Ingrese el RFC" />
                                <ValidationMessage For="@(() => proveedor.RFC)" class="text-danger" />
                                @if (!string.IsNullOrEmpty(mensajeValidacionRFC))
                                {
                                    <div class="text-danger small">@mensajeValidacionRFC</div>
                                }
                            </div>

                            <div class="col-md-6">
                                <label class="form-label">Email <span class="text-danger">*</span></label>
                                <InputText class="form-control" @bind-Value="proveedor.Email" 
                                           @onblur="ValidarEmail"
                                           type="email" 
                                           placeholder="Ingrese el email" />
                                <ValidationMessage For="@(() => proveedor.Email)" class="text-danger" />
                                @if (!string.IsNullOrEmpty(mensajeValidacionEmail))
                                {
                                    <div class="text-danger small">@mensajeValidacionEmail</div>
                                }
                            </div>

                            <div class="col-md-6">
                                <label class="form-label">Teléfono</label>
                                <InputText class="form-control" @bind-Value="proveedor.Telefono" 
                                           placeholder="Ingrese el teléfono" />
                                <ValidationMessage For="@(() => proveedor.Telefono)" class="text-danger" />
                            </div>

                            <div class="col-12">
                                <label class="form-label">Dirección</label>
                                <InputTextArea class="form-control" @bind-Value="proveedor.Direccion" 
                                               rows="3" 
                                               placeholder="Ingrese la dirección completa" />
                                <ValidationMessage For="@(() => proveedor.Direccion)" class="text-danger" />
                            </div>

                            <div class="col-12">
                                <div class="form-check">
                                    <InputCheckbox class="form-check-input" @bind-Value="proveedor.Activo" />
                                    <label class="form-check-label">
                                        Proveedor Activo
                                    </label>
                                </div>
                            </div>
                        </div>

                        <!-- Servicios que ofrece -->
                        <h5 class="card-title mb-3">
                            <i class="fas fa-tools"></i> Servicios que Ofrece
                        </h5>
                        
                        @if (cargandoServicios)
                        {
                            <div class="d-flex justify-content-center mb-4">
                                <div class="spinner-border spinner-border-sm" role="status">
                                    <span class="visually-hidden">Cargando servicios...</span>
                                </div>
                            </div>
                        }
                        else if (todosLosServicios?.Any() == true)
                        {
                            <div class="row g-2 mb-4">
                                @foreach (var servicio in todosLosServicios)
                                {
                                    <div class="col-md-6 col-lg-4">
                                        <div class="form-check">
                                            <input class="form-check-input" 
                                                   type="checkbox" 
                                                   id="servicio_@servicio.Id"
                                                   @onchange="@((e) => CambiarSeleccionServicio(servicio.Id, (bool)e.Value!))" 
                                                   checked="@(serviciosSeleccionados.ContainsKey(servicio.Id) && serviciosSeleccionados[servicio.Id])" />
                                            <label class="form-check-label" for="servicio_@servicio.Id">
                                                @servicio.Nombre
                                            </label>
                                            @if (!string.IsNullOrEmpty(servicio.Descripcion))
                                            {
                                                <div class="form-text small">@servicio.Descripcion</div>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="alert alert-warning mb-4">
                                <i class="fas fa-exclamation-triangle"></i>
                                No hay servicios disponibles para asignar.
                            </div>
                        }

                        <hr />

                        <div class="d-flex justify-content-end gap-2">
                            <button type="button" class="btn btn-outline-secondary" @onclick="Regresar">
                                <i class="fas fa-times"></i> Cancelar
                            </button>
                            <button type="submit" class="btn btn-primary" disabled="@guardando">
                                @if (guardando)
                                {
                                    <span class="spinner-border spinner-border-sm me-2"></span>
                                }
                                <i class="fas fa-save"></i> Guardar Cambios
                            </button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <!-- Imagen de Perfil -->
            <div class="card mb-4">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="card-title mb-0">
                        <i class="fas fa-camera"></i> Imagen de Perfil
                    </h5>
                    @if (proveedor.UsuarioId.HasValue)
                    {
                        <button type="button" class="btn btn-sm btn-outline-primary" @onclick="CambiarImagenPerfil">
                            <i class="fas fa-camera"></i> Cambiar
                        </button>
                    }
                </div>
                <div class="card-body text-center">
                    @if (usuarioAsociado?.ImagenPerfil != null)
                    {
                        <img src="@ObtenerUrlImagenPerfil()" 
                             alt="Imagen de perfil" 
                             class="img-fluid rounded-circle mb-3" 
                             style="width: 150px; height: 150px; object-fit: cover;" />
                    }
                    else
                    {
                        <div class="bg-light rounded-circle d-flex align-items-center justify-content-center mb-3 mx-auto" 
                             style="width: 150px; height: 150px;">
                            <i class="fas fa-user-circle text-muted" style="font-size: 100px;"></i>
                        </div>
                    }
                    <p class="text-muted small">
                        @if (usuarioAsociado?.ImagenPerfil != null)
                        {
                            <span>Imagen actual del perfil</span>
                        }
                        else
                        {
                            <span>Sin imagen de perfil</span>
                        }
                    </p>
                </div>
            </div>

            <!-- Información del Usuario Asociado -->
            @if (usuarioAsociado != null)
            {
                <div class="card">
                    <div class="card-header">
                        <h6 class="card-title mb-0">
                            <i class="fas fa-user"></i> Usuario Asociado
                        </h6>
                    </div>
                    <div class="card-body">
                        <p class="small"><strong>ID:</strong> @usuarioAsociado.Id</p>
                        <p class="small"><strong>Email:</strong> @usuarioAsociado.Email</p>
                        <p class="small"><strong>Estado:</strong> 
                            <span class="badge @(usuarioAsociado.Activo ? "bg-success" : "bg-secondary") badge-sm">
                                @(usuarioAsociado.Activo ? "Activo" : "Inactivo")
                            </span>
                        </p>
                    </div>
                </div>
            }
        </div>
    </div>
}

@code {
    [Parameter] public int ProveedorId { get; set; }

    private Proveedor? proveedor;
    private Usuario? usuarioAsociado;
    private List<TipoServicio>? todosLosServicios;
    private Dictionary<int, bool> serviciosSeleccionados = new();
    private bool cargando = true;
    private bool cargandoServicios = true;
    private bool guardando = false;
    private string mensajeValidacionRFC = "";
    private string mensajeValidacionEmail = "";

    protected override async Task OnInitializedAsync()
    {
        await CargarProveedor();
        await CargarServicios();
    }

    private async Task CargarProveedor()
    {
        try
        {
            var resultado = await ServicioProveedor.Obtener_por_id(ProveedorId);

            if (resultado.Correcto && resultado.Datos != null)
            {
                proveedor = resultado.Datos;

                // Cargar usuario asociado si existe
                if (proveedor.UsuarioId.HasValue)
                {
                    var usuarioResult = await ServicioUsuario.Obtener_por_id(proveedor.UsuarioId.Value);
                    if (usuarioResult.Correcto)
                    {
                        usuarioAsociado = usuarioResult.Datos;
                    }
                }
            }
            else
            {
                await JSRuntime.InvokeVoidAsync("alert", $"Error al cargar proveedor: {resultado.Mensaje}");
            }
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Error: {ex.Message}");
        }
        finally
        {
            cargando = false;
            StateHasChanged();
        }
    }

    private async Task CargarServicios()
    {
        try
        {
            cargandoServicios = true;
            StateHasChanged();

            var resultado = await ServicioTipoServicio.Obtener_todos();
            
            if (resultado.Correcto && resultado.Datos != null)
            {
                todosLosServicios = resultado.Datos.ToList();
                
                // Inicializar diccionario de servicios seleccionados
                serviciosSeleccionados.Clear();
                foreach (var servicio in todosLosServicios)
                {
                    // TODO: Cargar servicios actuales del proveedor
                    serviciosSeleccionados[servicio.Id] = false;
                }
            }
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Error al cargar servicios: {ex.Message}");
        }
        finally
        {
            cargandoServicios = false;
            StateHasChanged();
        }
    }

    private void CambiarSeleccionServicio(int servicioId, bool seleccionado)
    {
        serviciosSeleccionados[servicioId] = seleccionado;
        StateHasChanged();
    }

    private string ObtenerUrlImagenPerfil()
    {
        if (usuarioAsociado?.ImagenPerfil?.Url != null)
        {
            if (usuarioAsociado.ImagenPerfil.Url.StartsWith("http"))
                return usuarioAsociado.ImagenPerfil.Url;
                
            return $"/{usuarioAsociado.ImagenPerfil.Url.TrimStart('/')}";
        }
        return "/img/default-user.png";
    }

    private async Task CambiarImagenPerfil()
    {
        if (usuarioAsociado == null) return;

        try
        {
            var resultado = await dialogService.OpenAsync<CambiarFotoDialog>("Cambiar Imagen de Perfil",
                new Dictionary<string, object>
                {
                    { "Usuario", usuarioAsociado }
                },
                new DialogOptions { Width = "500px", Height = "400px" });

            if (resultado is bool cambiado && cambiado)
            {
                // Recargar el usuario para mostrar la nueva imagen
                await CargarProveedor();
            }
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Error al cambiar imagen: {ex.Message}");
        }
    }

    private async Task GuardarProveedor()
    {
        if (proveedor == null) return;

        // Validaciones finales
        if (string.IsNullOrWhiteSpace(proveedor.Nombre))
        {
            await JSRuntime.InvokeVoidAsync("alert", "El nombre es requerido.");
            return;
        }

        if (string.IsNullOrWhiteSpace(proveedor.RFC))
        {
            await JSRuntime.InvokeVoidAsync("alert", "El RFC es requerido.");
            return;
        }

        if (string.IsNullOrWhiteSpace(proveedor.Email))
        {
            await JSRuntime.InvokeVoidAsync("alert", "El email es requerido.");
            return;
        }

        if (!string.IsNullOrEmpty(mensajeValidacionRFC) || !string.IsNullOrEmpty(mensajeValidacionEmail))
        {
            await JSRuntime.InvokeVoidAsync("alert", "Por favor corrija los errores de validación antes de continuar.");
            return;
        }

        guardando = true;
        StateHasChanged();

        try
        {
            var resultado = await ServicioProveedor.Actualizar(proveedor);

            if (resultado.Correcto)
            {
                // TODO: Guardar servicios seleccionados
                var serviciosSeleccionadosList = serviciosSeleccionados
                    .Where(kvp => kvp.Value)
                    .Select(kvp => kvp.Key)
                    .ToList();

                await JSRuntime.InvokeVoidAsync("alert", 
                    $"Proveedor actualizado correctamente.\n\n" +
                    $"Servicios seleccionados: {serviciosSeleccionadosList.Count}\n" +
                    "Nota: La funcionalidad de servicios está en desarrollo.");
                    
                Navigation.NavigateTo("/proveedores");
            }
            else
            {
                await JSRuntime.InvokeVoidAsync("alert", $"Error al actualizar proveedor: {resultado.Mensaje}");
            }
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Error: {ex.Message}");
        }
        finally
        {
            guardando = false;
            StateHasChanged();
        }
    }

    private async Task ValidarRFC()
    {
        if (proveedor == null) return;
        
        mensajeValidacionRFC = "";

        if (!string.IsNullOrWhiteSpace(proveedor.RFC))
        {
            try
            {
                var resultado = await ServicioProveedor.Validar_rfc_unico(proveedor.RFC, proveedor.Id);
                if (!resultado.Correcto || !resultado.Datos)
                {
                    mensajeValidacionRFC = "Este RFC ya está en uso por otro proveedor.";
                }
            }
            catch (Exception ex)
            {
                mensajeValidacionRFC = $"Error al validar RFC: {ex.Message}";
            }
        }

        StateHasChanged();
    }

    private async Task ValidarEmail()
    {
        if (proveedor == null) return;
        
        mensajeValidacionEmail = "";

        if (!string.IsNullOrWhiteSpace(proveedor.Email))
        {
            try
            {
                var resultado = await ServicioProveedor.Validar_email_unico(proveedor.Email, proveedor.Id);
                if (!resultado.Correcto || !resultado.Datos)
                {
                    mensajeValidacionEmail = "Este email ya está en uso por otro proveedor o usuario.";
                }
            }
            catch (Exception ex)
            {
                mensajeValidacionEmail = $"Error al validar email: {ex.Message}";
            }
        }

        StateHasChanged();
    }

    private void Regresar()
    {
        Navigation.NavigateTo("/proveedores");
    }
}