@page "/usuarios/new"
@inherits BaseComponent

@using AdmIn.Common.Entidades
@using System.Text.RegularExpressions
@using AdmIn.Common
@using AdmIn.UI.Services
@using AdmIn.UI.Services.UtilityServices
@using AdmIn.UI.Components.Shared

@inject IServ_Usuario serv_usuario;
@inject IServ_Rol serv_rol;
@inject IServ_Moneda serv_moneda;
@inject IServ_Imagen serv_imagen;

<RadzenTemplateForm @ref="form" TItem="Usuario" Data="@usuario">
    <RadzenRow class="rz-mx-2 rz-mb-8">
        <RadzenColumn>
            <RadzenFormField Text="Nombre" Variant="Variant.Outlined" Style="width:100%">
                <ChildContent>
                    <RadzenTextBox @bind-Value=usuario.Nombre MaxLength="50" Name="componente_nombre" TValue="string" />
                </ChildContent>
                <Helper>
                    <RadzenCustomValidator Component="componente_nombre" Validator="@(() => Validar_nombre(usuario.Nombre))" Text="Ingrese nombre" Popup=true />
                </Helper>
            </RadzenFormField>
        </RadzenColumn>
    </RadzenRow>

    <RadzenRow class="rz-mx-2 rz-mb-8">
        <RadzenColumn>
            <RadzenFormField Text="Password" Variant="Variant.Outlined" Style="width:100%">
                <ChildContent>
                    <RadzenPassword @bind-Value=usuario.Password Name="componente_password" TValue="string" />
                </ChildContent>
                <Helper>
                    <RadzenCustomValidator Component="componente_password" Validator="@(() => Validar_Password(usuario.Password))" Text="Ingrese la contraseña" Popup=true />
                </Helper>
            </RadzenFormField>
        </RadzenColumn>
    </RadzenRow>

    <RadzenRow class="rz-mx-2 rz-mb-8">
        <RadzenColumn>
            <RadzenFormField Text="E-mail" Variant="Variant.Outlined" Style="width:100%">
                <ChildContent>
                    <RadzenTextBox @bind-Value=usuario.Email MaxLength="50" Name="componente_email" TValue="string" />
                </ChildContent>
                <Helper>
                    <RadzenCustomValidator Component="componente_email" Validator="@(() => Validar_email(usuario.Email))" Text="Ingrese un email válido" Popup=true />
                </Helper>
            </RadzenFormField>
        </RadzenColumn>
    </RadzenRow>

    <RadzenRow class="rz-mx-2 rz-mb-8">
        <RadzenColumn Size="6">
            <RadzenFormField Text="País" Variant="Variant.Outlined" Style="width:100%">
                <ChildContent>
                    <RadzenTextBox @bind-Value=usuario.Pais MaxLength="100" Name="componente_pais" TValue="string" />
                </ChildContent>
            </RadzenFormField>
        </RadzenColumn>
        <RadzenColumn Size="6">
            <RadzenFormField Text="Teléfono" Variant="Variant.Outlined" Style="width:100%">
                <ChildContent>
                    <RadzenTextBox @bind-Value=usuario.Telefono MaxLength="20" Name="componente_telefono" TValue="string" />
                </ChildContent>
            </RadzenFormField>
        </RadzenColumn>
    </RadzenRow>

    <RadzenRow class="rz-mx-2 rz-mb-8">
        <RadzenColumn Size="6">
            <RadzenFormField Text="Moneda" Variant="Variant.Outlined" Style="width:100%">
                <ChildContent>
                    <RadzenDropDown @bind-Value="usuario.MonedaId" Data="@monedas" AllowClear="false"
                                    TextProperty="Nombre" ValueProperty="Id" Style="width:100%" Name="componente_moneda" />
                </ChildContent>
                <Helper>
                    <RadzenCustomValidator Component="componente_moneda" Validator="@(() => Validar_moneda(usuario.MonedaId))" Text="Seleccione una moneda" Popup=true />
                </Helper>
            </RadzenFormField>
        </RadzenColumn>
        <RadzenColumn Size="6">
            <RadzenFormField Text="Estado">
                <Start>
                    <RadzenCheckBox @bind-Value="usuario.Activo" Name="componente_activo" />
                </Start>
                <ChildContent>
                    <RadzenLabel Text="Activo" Component="CheckBox1" Class="rz-mx-4" />
                </ChildContent>
            </RadzenFormField>
        </RadzenColumn>
    </RadzenRow>

    <RadzenRow class="rz-mx-2 rz-mb-8">
        <RadzenColumn>
            <RadzenLabel Text="Roles" />
            <RadzenListBox @bind-Value="valuesRoles" TValue="IEnumerable<int>" Data="@roles" AllowSelectAll="false"
                           TextProperty="Nombre" ValueProperty="Id" Style="width:100%" Multiple="true" />
        </RadzenColumn>
    </RadzenRow>

    <!-- Sección de Imagen de Perfil -->
    <RadzenRow class="rz-mx-2 rz-mb-8">
        <RadzenColumn>
            <RadzenCard>
                <RadzenStack Gap="1rem">
                    <RadzenText TextStyle="TextStyle.H6" Text="Imagen de Perfil" />
                    
                    <div class="text-center">
                        @if (imagenPerfilSeleccionada != null)
                        {
                            <img src="@imagenPerfilSeleccionada.UrlThumb" 
                                 alt="Vista previa" 
                                 class="img-fluid rounded-circle mb-3" 
                                 style="width: 120px; height: 120px; object-fit: cover; border: 3px solid #e9ecef;" />
                        }
                        else
                        {
                            <div class="bg-light rounded-circle d-flex align-items-center justify-content-center mb-3 mx-auto" 
                                 style="width: 120px; height: 120px; border: 3px solid #e9ecef;">
                                <i class="fas fa-user-circle text-muted" style="font-size: 80px;"></i>
                            </div>
                        }
                        
                        <div class="text-muted small">
                            @if (imagenPerfilSeleccionada != null)
                            {
                                <i class="fas fa-check-circle text-success me-1"></i>
                                <span>Imagen seleccionada: @imagenPerfilSeleccionada.Nombre</span>
                            }
                            else
                            {
                                <i class="fas fa-info-circle me-1"></i>
                                <span>Sin imagen seleccionada</span>
                            }
                        </div>
                    </div>

                    <div class="mb-3">
                        <ImageUploadComponent 
                            PermitirMultiples="false"
                            MostrarVistaPrevia="false"
                            MostrarBotones="true"
                            OnImagenesSubidas="@OnImagenPerfilSubida"
                            OnError="@OnErrorSubida" />
                    </div>

                    @if (imagenPerfilSeleccionada != null)
                    {
                        <button type="button" 
                                class="btn btn-outline-danger btn-sm w-100" 
                                @onclick="EliminarImagenSeleccionada">
                            <i class="fas fa-trash me-1"></i>
                            Quitar Imagen Seleccionada
                        </button>
                    }

                    <div class="alert alert-info mt-3 small">
                        <i class="fas fa-lightbulb me-1"></i>
                        <strong>Opcional:</strong> La imagen de perfil se mostrará en toda la aplicación. Puedes agregarla ahora o más tarde.
                    </div>
                </RadzenStack>
            </RadzenCard>
        </RadzenColumn>
    </RadzenRow>

    <RadzenRow class="rz-mx-2 rz-mb-8" JustifyContent="JustifyContent.End">
        <RadzenColumn>
            <MiRadzenButton ButtonStyle="ButtonStyle.Primary" Text="Guardar" OnClick="@OnSubmit" />
            <MiRadzenButton ButtonStyle="ButtonStyle.Primary" Text="Cancelar" OnClick="@OnCancel" />
        </RadzenColumn>
    </RadzenRow>
</RadzenTemplateForm>

@code {
    RadzenTemplateForm<Usuario> form;
    Usuario usuario = new Usuario();

    private List<Rol> roles { get; set; }
    private List<Moneda> monedas { get; set; }
    private Imagen? imagenPerfilSeleccionada;

    IEnumerable<int> valuesPermisos;
    IEnumerable<int> valuesRoles;

    #region Validaciones

    public bool Is_valid()
    {
        form.EditContext.Validate();
        return form.IsValid;
    }

    bool Validar_nombre(string nombre)
    {
        return !string.IsNullOrEmpty(nombre);
    }

    bool Validar_Password(string password)
    {
        return !string.IsNullOrEmpty(password);
    }

    bool Validar_email(string email)
    {
        bool valid = !string.IsNullOrEmpty(email);
        string pattern = @"^\S+@\S+\.\S+$";
        Regex regex = new Regex(pattern);

        return valid && regex.IsMatch(email);
    }

    bool Validar_moneda(int monedaId)
    {
        return monedaId > 0;
    }

    #endregion

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        base.EstablecerTituloPagina("Usuarios", "Nuevo");

        if (usuario.Roles == null)
        {
            usuario.Roles = new List<Rol>();
        }

        // Inicializar campos por defecto
        usuario.Activo = true;
        usuario.MonedaId = 1; // Moneda por defecto

        var rta_roles = await serv_rol.Obtener_todos();
        if (rta_roles.Correcto)
        {
            roles = rta_roles.Datos.ToList();
        }

        var rta_monedas = await serv_moneda.Obtener_todos();
        if (rta_monedas.Correcto)
        {
            monedas = rta_monedas.Datos.ToList();
        }
    }

    private async Task OnImagenPerfilSubida(List<Imagen> imagenes)
    {
        if (imagenes.Any())
        {
            imagenPerfilSeleccionada = imagenes.First();
            base.MostrarNotificacion(NotificationSeverity.Success, "Éxito", 
                "Imagen seleccionada. Se asignará después de crear el usuario.");
            StateHasChanged();
        }
    }

    private async Task OnErrorSubida(string error)
    {
        base.MostrarNotificacion(NotificationSeverity.Error, "Error", error);
    }

    private void EliminarImagenSeleccionada()
    {
        imagenPerfilSeleccionada = null;
        base.MostrarNotificacion(NotificationSeverity.Info, "Info", "Imagen removida");
        StateHasChanged();
    }

    async Task OnSubmit()
    {
        if (Is_valid())
        {
            try
            {
                usuario.Roles.Clear();

                foreach (int id_rol in valuesRoles)
                {
                    Rol rol = roles.FirstOrDefault(x => x.Id == id_rol);
                    usuario.Roles.Add(rol);
                }

                DTO<Usuario> usuario_respuesta = await serv_usuario.Crear(usuario);
                if (usuario_respuesta != null && usuario_respuesta.Correcto)
                {
                    // Si hay imagen seleccionada, asignarla al usuario creado
                    if (imagenPerfilSeleccionada != null && usuario_respuesta.Datos != null)
                    {
                        try
                        {
                            var resultadoImagen = await serv_imagen.EstablecerImagenPerfil(
                                imagenPerfilSeleccionada.Id, usuario_respuesta.Datos.Id);
                                
                            if (!resultadoImagen.Correcto)
                            {
                                base.MostrarNotificacion(NotificationSeverity.Warning, "Advertencia", 
                                    "Usuario creado, pero no se pudo asignar la imagen de perfil.");
                            }
                        }
                        catch (Exception imgEx)
                        {
                            base.MostrarNotificacion(NotificationSeverity.Warning, "Advertencia", 
                                $"Usuario creado, pero error al asignar imagen: {imgEx.Message}");
                        }
                    }

                    base.MostrarNotificacion(NotificationSeverity.Success, "Alta correcta", 
                        "Se ha agregado un nuevo usuario al sistema", "/usuarios");
                }
                else
                {
                    base.MostrarNotificacion(NotificationSeverity.Error, "Error!", 
                        $"Error al agregar el usuario: {usuario_respuesta.Mensaje}");
                }
            }
            catch (Exception ex)
            {
                base.MostrarNotificacion(NotificationSeverity.Error, "Error!", 
                    $"Error al agregar el usuario: {ex.Message}");
            }
        }
    }

    async Task OnCancel()
    {
        base.IrA("/usuarios");
    }
}