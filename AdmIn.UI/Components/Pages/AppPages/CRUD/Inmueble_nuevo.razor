@page "/inmuebles/nuevo"
@inherits BaseComponent

@using AdmIn.Common.Entidades
@using AdmIn.Common
@using AdmIn.UI.Services
@using Microsoft.AspNetCore.Components.Authorization

@inject IServ_Inmueble serv_inmueble
@inject AuthenticationStateProvider authStateProvider

<PageTitle>Nuevo Inmueble</PageTitle>

<RadzenStack Gap="2rem" Class="p-4">
    <!-- Header -->
    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="1rem">
        <RadzenButton ButtonStyle="ButtonStyle.Light" 
                     Icon="arrow_back" 
                     Click="@(() => IrA("/inmuebles"))"
                     Size="ButtonSize.Medium" />
        <RadzenText TextStyle="TextStyle.H4" Text="Crear Nuevo Inmueble" />
    </RadzenStack>

    <!-- Breadcrumb -->
    <RadzenBreadCrumb>
        <RadzenBreadCrumbItem Path="/inmuebles" Text="Inmuebles" Icon="apartment" />
        <RadzenBreadCrumbItem Text="Nuevo" Icon="add" />
    </RadzenBreadCrumb>

    <!-- Botón para mostrar debug -->
    <RadzenButton Text="@(mostrarDebug ? "Ocultar Debug" : "Mostrar Debug")" 
                 ButtonStyle="ButtonStyle.Info" 
                 Click="@(() => mostrarDebug = !mostrarDebug)" />

    <!-- Debug Info -->
    @if (mostrarDebug)
    {
        <RadzenCard>
            <RadzenText TextStyle="TextStyle.H6" Text="Estado de Debug" />
            <ul>
                <li>Usuario actual ID: @usuarioActualId</li>
                <li>Cargando: @cargando</li>
                <li>Error de carga: @(string.IsNullOrEmpty(errorCarga) ? "Ninguno" : errorCarga)</li>
                <li>Componente inicializado: @componenteInicializado</li>
                <li>Inmueble ID: @nuevoInmueble.Id</li>
                <li>Inmueble Activo: @nuevoInmueble.Activo</li>
            </ul>
        </RadzenCard>
    }

    <!-- Formulario Principal -->
    @if (cargando)
    {
        <RadzenCard Class="form-container">
            <RadzenStack AlignItems="AlignItems.Center" Gap="1rem">
                <RadzenProgressBarCircular ProgressBarStyle="ProgressBarStyle.Primary" 
                                         Value="100" 
                                         ShowValue="false" 
                                         Mode="ProgressBarMode.Indeterminate" />
                <RadzenText Text="Cargando formulario..." />
            </RadzenStack>
        </RadzenCard>
    }
    else if (!string.IsNullOrEmpty(errorCarga))
    {
        <RadzenCard Class="form-container">
            <RadzenAlert AlertStyle="AlertStyle.Danger" ShowIcon="true">
                <RadzenText Text="@($"Error al cargar el formulario: {errorCarga}")" />
                <RadzenButton Text="Reintentar" 
                             ButtonStyle="ButtonStyle.Primary" 
                             Click="@RecargarFormulario" 
                             Style="margin-top: 1rem;" />
            </RadzenAlert>
        </RadzenCard>
    }
    else if (!componenteInicializado)
    {
        <RadzenCard Class="form-container">
            <RadzenAlert AlertStyle="AlertStyle.Warning" ShowIcon="true">
                <RadzenText Text="El componente no se ha inicializado correctamente." />
                <RadzenButton Text="Forzar Inicialización" 
                             ButtonStyle="ButtonStyle.Primary" 
                             Click="@ForzarInicializacion" 
                             Style="margin-top: 1rem;" />
            </RadzenAlert>
        </RadzenCard>
    }
    else
    {
        <RadzenCard Class="form-container">
            <!-- Formulario Directo -->
            <RadzenTemplateForm TItem="Inmueble" Data="@nuevoInmueble" Submit="@CrearInmueble">
                <RadzenFieldset Text="Información Básica" class="mb-4">
                    <!-- Nombre del Inmueble -->
                    <RadzenRow class="mb-3">
                        <RadzenColumn>
                            <RadzenFormField Text="Nombre del Inmueble" Variant="Variant.Outlined" Style="width:100%">
                                <ChildContent>
                                    <RadzenTextBox @bind-Value="@nuevoInmueble.Nombre" 
                                                  MaxLength="255" 
                                                  Name="nombre" 
                                                  Placeholder="Ej: Casa en Palermo, Departamento Centro"
                                                  TValue="string" />
                                </ChildContent>
                                <Helper>
                                    <RadzenRequiredValidator Component="nombre" Text="El nombre del inmueble es requerido" />
                                </Helper>
                            </RadzenFormField>
                        </RadzenColumn>
                    </RadzenRow>

                    <!-- Descripción -->
                    <RadzenRow class="mb-3">
                        <RadzenColumn>
                            <RadzenFormField Text="Descripción" Variant="Variant.Outlined" Style="width:100%">
                                <ChildContent>
                                    <RadzenTextArea @bind-Value="@nuevoInmueble.Descripcion" 
                                                   MaxLength="1000" 
                                                   Rows="4"
                                                   Name="descripcion"
                                                   Placeholder="Descripción detallada del inmueble"
                                                   TValue="string" />
                                </ChildContent>
                            </RadzenFormField>
                        </RadzenColumn>
                    </RadzenRow>

                    <!-- Dirección -->
                    <RadzenRow class="mb-3">
                        <RadzenColumn>
                            <RadzenFormField Text="Dirección" Variant="Variant.Outlined" Style="width:100%">
                                <ChildContent>
                                    <RadzenTextBox @bind-Value="@nuevoInmueble.Direccion" 
                                                  MaxLength="500" 
                                                  Name="direccion"
                                                  Placeholder="Ej: Av. Corrientes 1234, Piso 5 Dpto A"
                                                  TValue="string" />
                                </ChildContent>
                                <Helper>
                                    <RadzenRequiredValidator Component="direccion" Text="La dirección es requerida" />
                                </Helper>
                            </RadzenFormField>
                        </RadzenColumn>
                    </RadzenRow>
                </RadzenFieldset>

                <RadzenFieldset Text="Ubicación" class="mb-4">
                    <RadzenRow class="mb-3">
                        <RadzenColumn Size="4">
                            <RadzenFormField Text="País" Variant="Variant.Outlined" Style="width:100%">
                                <RadzenTextBox @bind-Value="@nuevoInmueble.Pais" 
                                              Name="pais" 
                                              Placeholder="Ej: Argentina" />
                            </RadzenFormField>
                        </RadzenColumn>
                        <RadzenColumn Size="4">
                            <RadzenFormField Text="Estado" Variant="Variant.Outlined" Style="width:100%">
                                <RadzenTextBox @bind-Value="@nuevoInmueble.Estado" 
                                              Name="estado" 
                                              Placeholder="Ej: Buenos Aires" />
                            </RadzenFormField>
                        </RadzenColumn>
                        <RadzenColumn Size="4">
                            <RadzenFormField Text="Ciudad" Variant="Variant.Outlined" Style="width:100%">
                                <RadzenTextBox @bind-Value="@nuevoInmueble.Ciudad" 
                                              Name="ciudad" 
                                              Placeholder="Ej: La Plata" />
                            </RadzenFormField>
                        </RadzenColumn>
                    </RadzenRow>
                    
                    <RadzenRow class="mb-3">
                        <RadzenColumn>
                            <RadzenFormField Text="Código Postal" Variant="Variant.Outlined" Style="width:100%">
                                <RadzenTextBox @bind-Value="@nuevoInmueble.CodigoPostal" 
                                              Name="codigoPostal" 
                                              Placeholder="Ej: 1900" />
                            </RadzenFormField>
                        </RadzenColumn>
                    </RadzenRow>
                </RadzenFieldset>

                <RadzenFieldset Text="Información Económica" class="mb-4">
                    <RadzenRow class="mb-3">
                        <!-- Valor del Inmueble -->
                        <RadzenColumn Size="6">
                            <RadzenFormField Text="Valor del Inmueble" Variant="Variant.Outlined" Style="width:100%">
                                <ChildContent>
                                    <RadzenNumeric @bind-Value="@nuevoInmueble.Valor" 
                                                  Format="C2" 
                                                  Min="0"
                                                  Name="valor"
                                                  Placeholder="0.00"
                                                  TValue="decimal" />
                                </ChildContent>
                                <Helper>
                                    <RadzenRequiredValidator Component="valor" Text="El valor es requerido" />
                                    <RadzenNumericRangeValidator Component="valor" Min="1" Text="El valor debe ser mayor a 0" />
                                </Helper>
                            </RadzenFormField>
                        </RadzenColumn>

                        <!-- Renta Mensual -->
                        <RadzenColumn Size="6">
                            <RadzenFormField Text="Renta Mensual" Variant="Variant.Outlined" Style="width:100%">
                                <ChildContent>
                                    <RadzenNumeric @bind-Value="@nuevoInmueble.RentaMensual" 
                                                  Format="C2" 
                                                  Min="0"
                                                  Name="rentaMensual"
                                                  Placeholder="0.00"
                                                  TValue="decimal" />
                                </ChildContent>
                            </RadzenFormField>
                        </RadzenColumn>
                    </RadzenRow>

                    <RadzenRow class="mb-3">
                        <!-- Construcción M2 -->
                        <RadzenColumn Size="6">
                            <RadzenFormField Text="Construcción (m²)" Variant="Variant.Outlined" Style="width:100%">
                                <ChildContent>
                                    <RadzenNumeric @bind-Value="@nuevoInmueble.ConstruccionM2" 
                                                  Format="N2" 
                                                  Min="0"
                                                  Name="construccionM2"
                                                  Placeholder="0.00"
                                                  TValue="decimal" />
                                </ChildContent>
                            </RadzenFormField>
                        </RadzenColumn>
                        
                        <!-- Estado Activo -->
                        <RadzenColumn Size="6">
                            <RadzenFormField Text="Estado" Variant="Variant.Outlined" Style="width:100%">
                                <ChildContent>
                                    <RadzenCheckBox @bind-Value="@nuevoInmueble.Activo" Name="activo" />
                                    <RadzenLabel Text="Inmueble Activo" Component="activo" Style="margin-left: 8px;" />
                                </ChildContent>
                            </RadzenFormField>
                        </RadzenColumn>
                    </RadzenRow>
                </RadzenFieldset>

                <RadzenFieldset Text="Coordenadas (Opcional)" class="mb-4">
                    <RadzenRow class="mb-3">
                        <RadzenColumn Size="6">
                            <RadzenFormField Text="Latitud" Variant="Variant.Outlined" Style="width:100%">
                                <ChildContent>
                                    <RadzenNumeric @bind-Value="@nuevoInmueble.Latitud" 
                                                  Format="N6" 
                                                  Min="-90" 
                                                  Max="90"
                                                  Name="latitud"
                                                  Placeholder="Ej: -34.603722"
                                                  TValue="decimal" />
                                </ChildContent>
                            </RadzenFormField>
                        </RadzenColumn>
                        <RadzenColumn Size="6">
                            <RadzenFormField Text="Longitud" Variant="Variant.Outlined" Style="width:100%">
                                <ChildContent>
                                    <RadzenNumeric @bind-Value="@nuevoInmueble.Longitud" 
                                                  Format="N6" 
                                                  Min="-180" 
                                                  Max="180"
                                                  Name="longitud"
                                                  Placeholder="Ej: -58.381592"
                                                  TValue="decimal" />
                                </ChildContent>
                            </RadzenFormField>
                        </RadzenColumn>
                    </RadzenRow>
                </RadzenFieldset>

                <!-- Botones de Acción -->
                <RadzenStack Orientation="Orientation.Horizontal" Gap="1rem" JustifyContent="JustifyContent.End" class="mt-4">
                    <RadzenButton ButtonStyle="ButtonStyle.Secondary" 
                                 Icon="cancel" 
                                 Text="Cancelar" 
                                 Click="@(() => IrA("/inmuebles"))" />
                    <RadzenButton ButtonStyle="ButtonStyle.Primary" 
                                 Icon="save" 
                                 Text="Crear" 
                                 ButtonType="ButtonType.Submit"
                                 IsBusy="@guardando" />
                </RadzenStack>
            </RadzenTemplateForm>
        </RadzenCard>
    }

    <!-- Información Adicional -->
    <RadzenCard Class="info-card">
        <RadzenStack Gap="1rem">
            <RadzenText TextStyle="TextStyle.H6" Text="Información Importante" />
            <RadzenAlert AlertStyle="AlertStyle.Info" Variant="Variant.Flat" ShowIcon="true">
                <RadzenStack Gap="0.5rem">
                    <RadzenText TextStyle="TextStyle.Body2">
                        • Todos los campos marcados con (*) son obligatorios
                    </RadzenText>
                    <RadzenText TextStyle="TextStyle.Body2">
                        • Las coordenadas de latitud y longitud son opcionales pero recomendadas para mapas
                    </RadzenText>
                    <RadzenText TextStyle="TextStyle.Body2">
                        • Después de crear el inmueble podrás agregar imágenes y características
                    </RadzenText>
                </RadzenStack>
            </RadzenAlert>
        </RadzenStack>
    </RadzenCard>
</RadzenStack>

<style>
    .form-container {
        max-width: 1200px;
        margin: 0 auto;
    }
    
    .info-card {
        max-width: 1200px;
        margin: 0 auto;
        background: #f8fafc;
    }
</style>

@code {
    private Inmueble nuevoInmueble = new();
    private int? usuarioActualId;
    private bool cargando = true;
    private string? errorCarga = null;
    private bool mostrarDebug = false;
    private bool componenteInicializado = false;
    private bool componenteInformado = false;
    private string? errorComponente = null;
    private bool guardando = false;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await base.OnInitializedAsync();
            EstablecerTituloPagina("Inmuebles", "Nuevo");
            
            await ObtenerUsuarioActual();
            InicializarInmueble();
            componenteInicializado = true;
        }
        catch (Exception ex)
        {
            errorCarga = ex.Message;
            await LogHelper.Error($"Error en OnInitializedAsync: {ex.Message}");
        }
        finally
        {
            cargando = false;
            StateHasChanged();
        }
    }

    private async Task ForzarInicializacion()
    {
        componenteInicializado = false;
        cargando = true;
        errorCarga = null;
        StateHasChanged();
        
        await Task.Delay(100);
        
        try
        {
            await ObtenerUsuarioActual();
            InicializarInmueble();
            componenteInicializado = true;
        }
        catch (Exception ex)
        {
            errorCarga = ex.Message;
        }
        finally
        {
            cargando = false;
            StateHasChanged();
        }
    }

    private async Task RecargarFormulario()
    {
        cargando = true;
        errorCarga = null;
        componenteInicializado = false;
        StateHasChanged();
        
        await Task.Delay(500);
        await OnInitializedAsync();
    }

    private async Task ObtenerUsuarioActual()
    {
        try
        {
            var authState = await authStateProvider.GetAuthenticationStateAsync();
            var userIdClaim = authState.User.FindFirst("Id");
            
            if (userIdClaim != null && int.TryParse(userIdClaim.Value, out int userId))
            {
                usuarioActualId = userId;
            }
        }
        catch (Exception ex)
        {
            await LogHelper.Error($"Error obteniendo usuario actual: {ex.Message}");
            // No lanzar excepción aquí, permitir que la app continúe
        }
    }

    private void InicializarInmueble()
    {
        nuevoInmueble = new Inmueble
        {
            Activo = true,
            FechaCreacion = DateTime.Now,
            FechaModificacion = DateTime.Now,
            UsuarioCreadorId = usuarioActualId,
            UsuarioModificadorId = usuarioActualId
        };
    }

    private async Task CrearInmueble(Inmueble inmueble)
    {
        if (guardando) return;
        
        try
        {
            guardando = true;
            await LogHelper.Info("Iniciando creación de inmueble");

            // Establecer usuario creador
            inmueble.UsuarioCreadorId = usuarioActualId;
            inmueble.UsuarioModificadorId = usuarioActualId;
            inmueble.FechaCreacion = DateTime.Now;
            inmueble.FechaModificacion = DateTime.Now;
            inmueble.MonedaId = 1; // Moneda por defecto (Peso Argentino)

            var resultado = await serv_inmueble.Crear(inmueble);
            
            if (resultado.Correcto && resultado.Datos != null)
            {
                await LogHelper.Info($"Inmueble creado exitosamente con ID: {resultado.Datos.Id}");
                
                MostrarNotificacion(
                    NotificationSeverity.Success, 
                    "¡Inmueble Creado!", 
                    $"El inmueble '{inmueble.Nombre}' ha sido creado exitosamente.",
                    $"/inmuebles/{resultado.Datos.Id}"
                );
            }
            else
            {
                await LogHelper.Warn($"Error al crear inmueble: {resultado.Mensaje}");
                MostrarNotificacion(
                    NotificationSeverity.Error, 
                    "Error al Crear", 
                    resultado.Mensaje ?? "Error desconocido al crear el inmueble"
                );
            }
        }
        catch (Exception ex)
        {
            await LogHelper.Error($"Excepción al crear inmueble: {ex.Message}");
            MostrarNotificacion(
                NotificationSeverity.Error, 
                "Error Inesperado", 
                $"Ocurrió un error inesperado: {ex.Message}"
            );
        }
        finally
        {
            guardando = false;
        }
    }
}