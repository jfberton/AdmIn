@page "/inmuebles/editar/{id:int}"
@inherits BaseComponent

@using AdmIn.Common.Entidades
@using AdmIn.Common
@using AdmIn.UI.Services
@using Microsoft.AspNetCore.Components.Authorization
@using AdmIn.UI.Components.Shared

@inject IServ_Inmueble serv_inmueble
@inject IServ_InmuebleCondicion serv_condicion
@inject IServ_Moneda serv_moneda
@inject AuthenticationStateProvider authStateProvider
@inject IServ_Imagen serv_imagen

<PageTitle>Editar Inmueble</PageTitle>

@if (inmueble != null)
{
    <RadzenStack Gap="2rem" Class="p-4">
        <!-- Header -->
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="1rem">
            <RadzenButton ButtonStyle="ButtonStyle.Light" 
                         Icon="arrow_back" 
                         Click="@Cancelar"
                         Size="ButtonSize.Medium" />
            <RadzenText TextStyle="TextStyle.H4" Text="@($"Editar: {inmueble.Nombre}")" />
        </RadzenStack>

        <!-- Breadcrumb -->
        <RadzenBreadCrumb>
            <RadzenBreadCrumbItem Path="/inmuebles" Text="Inmuebles" Icon="apartment" />
            <RadzenBreadCrumbItem Path="@($"/inmuebles/{inmueble.Id}")" Text="@inmueble.Nombre" Icon="home" />
            <RadzenBreadCrumbItem Text="Editar" Icon="edit" />
        </RadzenBreadCrumb>

        <!-- Formulario Principal (full width) -->
        <RadzenCard Class="form-container">
            <RadzenTemplateForm TItem="Inmueble" Data="@inmuebleEditando" Submit="@ActualizarInmueble">
                <!-- Información Básica (mantener igual) -->
                <RadzenFieldset Text="Informaci?n B?sica" class="mb-4">
                    <!-- Nombre del Inmueble -->
                    <RadzenRow class="mb-3">
                        <RadzenColumn>
                            <RadzenFormField Text="Nombre del Inmueble" Variant="Variant.Outlined" Style="width:100%">
                                <ChildContent>
                                    <RadzenTextBox @bind-Value="@inmuebleEditando.Nombre" 
                                                  MaxLength="255" 
                                                  Name="nombre" 
                                                  Placeholder="Ej: Casa en Palermo, Departamento Centro"
                                                  TValue="string" />
                                </ChildContent>
                                <Helper>
                                    <RadzenRequiredValidator Component="nombre" Text="El nombre del inmueble es requerido" />
                                </Helper>
                            </RadzenFormField>
                        </RadzenColumn>
                    </RadzenRow>

                    <!-- Descripción -->
                    <RadzenRow class="mb-3">
                        <RadzenColumn>
                            <RadzenFormField Text="Descripci?n" Variant="Variant.Outlined" Style="width:100%">
                                <ChildContent>
                                    <RadzenTextArea @bind-Value="@inmuebleEditando.Descripcion" 
                                                   MaxLength="1000" 
                                                   Rows="4"
                                                   Name="descripcion"
                                                   Placeholder="Descripci?n detallada del inmueble"
                                                   TValue="string" />
                                </ChildContent>
                            </RadzenFormField>
                        </RadzenColumn>
                    </RadzenRow>

                    <!-- Dirección -->
                    <RadzenRow class="mb-3">
                        <RadzenColumn>
                            <RadzenFormField Text="Direcci?n" Variant="Variant.Outlined" Style="width:100%">
                                <ChildContent>
                                    <RadzenTextBox @bind-Value="@inmuebleEditando.Direccion" 
                                                  MaxLength="500" 
                                                  Name="direccion"
                                                  Placeholder="Ej: Av. Corrientes 1234, Piso 5 Dpto A"
                                                  TValue="string" />
                                </ChildContent>
                                <Helper>
                                    <RadzenRequiredValidator Component="direccion" Text="La direcci?n es requerida" />
                                </Helper>
                            </RadzenFormField>
                        </RadzenColumn>
                    </RadzenRow>
                </RadzenFieldset>

                <RadzenFieldset Text="Ubicaci?n Geogr?fica" class="mb-4">
                    <RadzenRow class="mb-3">
                        <RadzenColumn Size="4">
                            <RadzenFormField Text="Pa?s" Variant="Variant.Outlined" Style="width:100%">
                                <RadzenTextBox @bind-Value="@inmuebleEditando.Pais" Name="pais" Placeholder="Ej: Argentina" />
                            </RadzenFormField>
                        </RadzenColumn>
                        <RadzenColumn Size="4">
                            <RadzenFormField Text="Estado/Provincia" Variant="Variant.Outlined" Style="width:100%">
                                <RadzenTextBox @bind-Value="@inmuebleEditando.Estado" Name="estadoGeografico" Placeholder="Ej: Buenos Aires" />
                            </RadzenFormField>
                        </RadzenColumn>
                        <RadzenColumn Size="4">
                            <RadzenFormField Text="Ciudad" Variant="Variant.Outlined" Style="width:100%">
                                <RadzenTextBox @bind-Value="@inmuebleEditando.Ciudad" Name="ciudad" Placeholder="Ej: La Plata" />
                            </RadzenFormField>
                        </RadzenColumn>
                    </RadzenRow>
                    <RadzenRow class="mb-3">
                        <RadzenColumn>
                            <RadzenFormField Text="C?digo Postal" Variant="Variant.Outlined" Style="width:100%">
                                <RadzenTextBox @bind-Value="@inmuebleEditando.CodigoPostal" Name="codigoPostal" Placeholder="Ej: 1900" />
                            </RadzenFormField>
                        </RadzenColumn>
                    </RadzenRow>
                </RadzenFieldset>

                <RadzenFieldset Text="Condici?n y Disponibilidad" class="mb-4">
                    <RadzenRow class="mb-3">
                        <!-- Condición del Inmueble -->
                        <RadzenColumn Size="6">
                            <RadzenFormField Text="Condici?n del Inmueble" Variant="Variant.Outlined" Style="width:100%">
                                <ChildContent>
                                    <RadzenDropDown @bind-Value="@condicionSeleccionada" Data="@condicionesDisponibles" TextProperty="Nombre" ValueProperty="Id" Placeholder="Seleccione la condici?n del inmueble" Name="condicionInmueble" Change="@OnCondicionChanged" />
                                </ChildContent>
                                <Helper>
                                    <RadzenRequiredValidator Component="condicionInmueble" Text="La condici?n del inmueble es requerida" />
                                </Helper>
                            </RadzenFormField>
                        </RadzenColumn>

                        <!-- Estado Activo -->
                        <RadzenColumn Size="6">
                            <RadzenFormField Text="Disponibilidad" Variant="Variant.Outlined" Style="width:100%">
                                <ChildContent>
                                    <RadzenCheckBox @bind-Value="@inmuebleEditando.Activo" Name="activo" />
                                    <RadzenLabel Text="Inmueble Activo" Component="activo" Style="margin-left: 8px;" />
                                </ChildContent>
                                <Helper>
                                    <RadzenText TextStyle="TextStyle.Caption" Style="color: #6b7280; margin-top: 4px;">Un inmueble inactivo no aparecer? en las b?squedas</RadzenText>
                                </Helper>
                            </RadzenFormField>
                        </RadzenColumn>
                    </RadzenRow>

                    @if (condicionSeleccionada != null)
                    {
                        <RadzenRow class="mb-3">
                            <RadzenColumn>
                                <RadzenAlert AlertStyle="AlertStyle.Info" ShowIcon="true">
                                    <RadzenText TextStyle="TextStyle.Body2">Condici?n seleccionada: <strong>@condicionesDisponibles.FirstOrDefault(c => c.Id == condicionSeleccionada)?.Nombre</strong>
                                        @if (!string.IsNullOrEmpty(condicionesDisponibles.FirstOrDefault(c => c.Id == condicionSeleccionada)?.Descripcion)) { <br />@condicionesDisponibles.FirstOrDefault(c => c.Id == condicionSeleccionada)?.Descripcion }
                                    </RadzenText>
                                </RadzenAlert>
                            </RadzenColumn>
                        </RadzenRow>
                    }
                </RadzenFieldset>

                <RadzenFieldset Text="Informaci?n Econ?mica" class="mb-4">
                    <RadzenRow class="mb-3">
                        <RadzenColumn Size="6">
                            <RadzenFormField Text="Valor del Inmueble" Variant="Variant.Outlined" Style="width:100%">
                                <ChildContent>
                                    <RadzenNumeric @bind-Value="@inmuebleEditando.Valor" Format="C2" Min="0" Name="valor" Placeholder="0.00" TValue="decimal" />
                                </ChildContent>
                                <Helper>
                                    <RadzenRequiredValidator Component="valor" Text="El valor es requerido" />
                                    <RadzenNumericRangeValidator Component="valor" Min="1" Text="El valor debe ser mayor a 0" />
                                </Helper>
                            </RadzenFormField>
                        </RadzenColumn>

                        <RadzenColumn Size="6">
                            <RadzenFormField Text="Renta Mensual" Variant="Variant.Outlined" Style="width:100%">
                                <ChildContent>
                                    <RadzenNumeric @bind-Value="@inmuebleEditando.RentaMensual" Format="C2" Min="0" Name="rentaMensual" Placeholder="0.00" TValue="decimal" />
                                </ChildContent>
                            </RadzenFormField>
                        </RadzenColumn>
                    </RadzenRow>

                    <RadzenRow class="mb-3">
                        <RadzenColumn Size="6">
                            <RadzenFormField Text="Moneda" Variant="Variant.Outlined" Style="width:100%">
                                <ChildContent>
                                    @if (ListaMonedas.Any())
                                    {
                                        <RadzenDropDown @bind-Value="@inmuebleEditando.MonedaId" Data="@ListaMonedas" TextProperty="Nombre" ValueProperty="Id" Placeholder="Seleccione una moneda" Name="moneda" />
                                    }
                                    else
                                    {
                                        <RadzenTextBox Value="Cargando monedas..." ReadOnly="true" />
                                    }
                                </ChildContent>
                                <Helper>
                                    <RadzenRequiredValidator Component="moneda" Text="La moneda es requerida" />
                                </Helper>
                            </RadzenFormField>
                        </RadzenColumn>

                        <RadzenColumn Size="6">
                            <RadzenFormField Text="Construcci?n (m?)" Variant="Variant.Outlined" Style="width:100%">
                                <ChildContent>
                                    <RadzenNumeric @bind-Value="@inmuebleEditando.ConstruccionM2" Format="N2" Min="0" Name="construccionM2" Placeholder="0.00" TValue="decimal" />
                                </ChildContent>
                            </RadzenFormField>
                        </RadzenColumn>
                    </RadzenRow>
                </RadzenFieldset>

                <RadzenFieldset Text="Coordenadas (Opcional)" class="mb-4">
                    <RadzenRow class="mb-3">
                        <RadzenColumn Size="6">
                            <RadzenFormField Text="Latitud" Variant="Variant.Outlined" Style="width:100%">
                                <ChildContent>
                                    <RadzenNumeric @bind-Value="@inmuebleEditando.Latitud" Format="N6" Min="-90" Max="90" Name="latitud" Placeholder="Ej: -34.603722" TValue="decimal" />
                                </ChildContent>
                            </RadzenFormField>
                        </RadzenColumn>
                        <RadzenColumn Size="6">
                            <RadzenFormField Text="Longitud" Variant="Variant.Outlined" Style="width:100%">
                                <ChildContent>
                                    <RadzenNumeric @bind-Value="@inmuebleEditando.Longitud" Format="N6" Min="-180" Max="180" Name="longitud" Placeholder="Ej: -58.381592" TValue="decimal" />
                                </ChildContent>
                            </RadzenFormField>
                        </RadzenColumn>
                    </RadzenRow>
                </RadzenFieldset>

                <!-- Botones de Acci?n -->
                <RadzenStack Orientation="Orientation.Horizontal" Gap="1rem" JustifyContent="JustifyContent.End" class="mt-4">
                    <RadzenButton ButtonStyle="ButtonStyle.Secondary" Icon="cancel" Text="Cancelar" Click="@Cancelar" />
                    <RadzenButton ButtonStyle="ButtonStyle.Primary" Icon="save" Text="Actualizar" ButtonType="ButtonType.Submit" IsBusy="@guardando" />
                </RadzenStack>
            </RadzenTemplateForm>
        </RadzenCard>

        <!-- Sección para editar características e imágenes (debajo del formulario) -->
        <RadzenRow Gap="2rem">
            <RadzenColumn Size="12" SizeMD="6">
                <RadzenCard>
                    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center">
                        <RadzenText TextStyle="TextStyle.H6" Text="Características" />
                        <RadzenButton ButtonStyle="ButtonStyle.Info" Icon="featured_play_list" Text="Gestionar" Click="@(()=> GestionarCaracteristicas())" Size="ButtonSize.Small" />
                    </RadzenStack>

                    <CaracteristicasViewer InmuebleId="@inmueble.Id" @ref="caracteristicasViewer" MostrarBotonGestionar="false" />
                </RadzenCard>
            </RadzenColumn>

            <RadzenColumn Size="12" SizeMD="6">
                <RadzenCard>
                    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center">
                        <RadzenText TextStyle="TextStyle.H6" Text="Imágenes" />
                        <RadzenButton ButtonStyle="ButtonStyle.Secondary" Icon="photo_library" Text="Gestionar" Click="@(()=> GestionarImagenes())" Size="ButtonSize.Small" />
                    </RadzenStack>

                    <ImageGalleryComponent Imagenes="imagenGaleriaPreview" ImagenPrincipalId="@inmueble.ImagenPrincipalId" EntidadId="@inmueble.Id" TipoEntidad="inmueble" PermitirEstablecerPrincipal="false" MensajeSinImagenes="Este inmueble no tiene imágenes" />
                </RadzenCard>
            </RadzenColumn>
        </RadzenRow>

        <!-- Información de Auditoría (ELIMINADA) -->
    </RadzenStack>
}
else if (cargando)
{
    <RadzenStack AlignItems="AlignItems.Center" JustifyContent="JustifyContent.Center" Gap="1rem" Class="p-8">
        <RadzenProgressBarCircular ProgressBarStyle="ProgressBarStyle.Primary" Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate" />
        <RadzenText TextStyle="TextStyle.Body1" Text="Cargando inmueble..." />
    </RadzenStack>
}
else
{
    <RadzenStack AlignItems="AlignItems.Center" JustifyContent="JustifyContent.Center" Gap="1rem" Class="p-8">
        <RadzenIcon Icon="error_outline" Style="font-size: 64px; color: var(--rz-danger);" />
        <RadzenText TextStyle="TextStyle.H5" Text="Inmueble no encontrado" />
        <RadzenText TextStyle="TextStyle.Body1" Text="El inmueble solicitado no existe o no tienes permisos para editarlo." />
        <RadzenButton ButtonStyle="ButtonStyle.Primary" Text="Volver a Inmuebles" Click="@(() => IrA("/inmuebles"))" />
    </RadzenStack>
}

<style>
    .form-container {
        width: 100%;
        max-width: none;
        margin: 0; /* use full container width */
    }
    
    .audit-info {
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
    }

    .audit-info .rz-text:first-child {
        color: #6b7280;
        font-weight: 600;
        letter-spacing: 0.05em;
    }
</style>

@code {
    [Parameter] public int Id { get; set; }
    
    private Inmueble? inmueble;
    private Inmueble inmuebleEditando = new();
    private bool cargando = true;
    private bool guardando = false;
    private int? usuarioActualId;

    // Condiciones del inmueble
    private List<InmuebleCondicion> condicionesDisponibles = new();
    private int? condicionSeleccionada = null;
    
    // Monedas disponibles
    private List<Moneda> ListaMonedas = new();

    // preview images for card
    private List<Imagen> imagenGaleriaPreview = new();
    private CaracteristicasViewer? caracteristicasViewer;

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        
        await ObtenerUsuarioActual();
        await CargarCondicionesDisponibles();
        await CargarMonedas();
        await CargarInmueble();
        await CargarImagenesPreview();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (inmueble?.Id != Id)
        {
            await CargarInmueble();
        }
    }

    private async Task CargarMonedas()
    {
        try
        {
            var resultado = await serv_moneda.Obtener_todos();
            if (resultado.Correcto && resultado.Datos != null)
            {
                ListaMonedas = resultado.Datos.ToList();
            }
            else
            {
                await LogHelper.Warn($"No se pudieron cargar las monedas: {resultado.Mensaje}");
                ListaMonedas = new List<Moneda> { new Moneda { Id = 1, Nombre = "Peso Argentino", Codigo = "ARS" } };
            }
        }
        catch (Exception ex)
        {
            await LogHelper.Error($"Error al cargar monedas: {ex.Message}");
            ListaMonedas = new List<Moneda> { new Moneda { Id = 1, Nombre = "Peso Argentino", Codigo = "ARS" } };
        }
    }

    private async Task CargarCondicionesDisponibles()
    {
        try
        {
            var resultado = await serv_condicion.Obtener_activos();
            if (resultado.Correcto && resultado.Datos != null)
            {
                condicionesDisponibles = resultado.Datos.ToList();
            }
            else
            {
                await LogHelper.Warn($"No se pudieron cargar las condiciones: {resultado.Mensaje}");
                condicionesDisponibles = new List<InmuebleCondicion> { new InmuebleCondicion { Id = 1, Nombre = "Disponible", Descripcion = "Condici?n por defecto" } };
            }
        }
        catch (Exception ex)
        {
            await LogHelper.Error($"Error al cargar condiciones: {ex.Message}");
            condicionesDisponibles = new List<InmuebleCondicion> { new InmuebleCondicion { Id = 1, Nombre = "Disponible", Descripcion = "Condici?n por defecto" } };
        }
    }

    private async Task ObtenerUsuarioActual()
    {
        try
        {
            var authState = await authStateProvider.GetAuthenticationStateAsync();
            var userIdClaim = authState.User.FindFirst("Id");
            
            if (userIdClaim != null && int.TryParse(userIdClaim.Value, out int userId))
            {
                usuarioActualId = userId;
            }
        }
        catch (Exception ex)
        {
            await LogHelper.Error($"Error obteniendo usuario actual: {ex.Message}");
        }
    }

    private async Task CargarInmueble()
    {
        try
        {
            cargando = true;
            await LogHelper.Info($"Cargando inmueble para edici?n con ID: {Id}");

            var resultado = await serv_inmueble.Obtener_por_id(Id);
            
            if (resultado.Correcto && resultado.Datos != null)
            {
                inmueble = resultado.Datos;
                
                // Crear copia para edici?n
                inmuebleEditando = new Inmueble
                {
                    Id = inmueble.Id,
                    Nombre = inmueble.Nombre,
                    Direccion = inmueble.Direccion,
                    Pais = inmueble.Pais,
                    Estado = inmueble.Estado,
                    Ciudad = inmueble.Ciudad,
                    CodigoPostal = inmueble.CodigoPostal,
                    Latitud = inmueble.Latitud,
                    Longitud = inmueble.Longitud,
                    Valor = inmueble.Valor,
                    ConstruccionM2 = inmueble.ConstruccionM2,
                    RentaMensual = inmueble.RentaMensual,
                    AdministradorId = inmueble.AdministradorId,
                    Descripcion = inmueble.Descripcion,
                    ImagenPrincipalId = inmueble.ImagenPrincipalId,
                    MonedaId = inmueble.MonedaId,
                    CondicionId = inmueble.CondicionId,
                    Activo = inmueble.Activo,
                    FechaCreacion = inmueble.FechaCreacion,
                    FechaModificacion = inmueble.FechaModificacion,
                    UsuarioCreadorId = inmueble.UsuarioCreadorId,
                    UsuarioModificadorId = inmueble.UsuarioModificadorId
                };

                // Establecer condici?n seleccionada
                condicionSeleccionada = inmueble.CondicionId > 0 ? inmueble.CondicionId : 1;
                
                EstablecerTituloPagina("Inmuebles", $"Editar: {inmueble.Nombre}");
                await LogHelper.Info($"Inmueble cargado para edici?n: {inmueble.Nombre}");
            }
            else
            {
                await LogHelper.Warn($"No se pudo cargar el inmueble para edici?n con ID: {Id}. Mensaje: {resultado.Mensaje}");
                EstablecerTituloPagina("Inmuebles", "No encontrado");
            }
        }
        catch (Exception ex)
        {
            await LogHelper.Error($"Error al cargar inmueble para edici?n: {ex.Message}");
            MostrarNotificacion(
                NotificationSeverity.Error,
                "Error",
                "No se pudo cargar la informaci?n del inmueble para editar"
            );
        }
        finally
        {
            cargando = false;
        }
    }

    private async Task CargarImagenesPreview()
    {
        try
        {
            var r = await serv_imagen.ObtenerPorInmueble(Id);
            if (r != null && r.Correcto && r.Datos != null)
            {
                imagenGaleriaPreview = r.Datos.ToList();
            }
            else
            {
                imagenGaleriaPreview = new List<Imagen>();
            }
        }
        catch
        {
            imagenGaleriaPreview = new List<Imagen>();
        }
    }

    private void OnCondicionChanged(object value)
    {
        if (value != null && int.TryParse(value.ToString(), out int condicionId))
        {
            condicionSeleccionada = condicionId;
            inmuebleEditando.CondicionId = condicionId;
            StateHasChanged();
        }
    }

    private async Task ActualizarInmueble(Inmueble inmuebleActualizado)
    {
        if (guardando) return;
        
        try
        {
            guardando = true;
            await LogHelper.Info($"Iniciando actualizaci?n de inmueble ID: {inmuebleActualizado.Id}");

            // Asegurar que la condici?n est? asignada al modelo
            inmuebleActualizado.CondicionId = condicionSeleccionada ?? 1;

            // Mantener informaci?n de auditor?a
            inmuebleActualizado.FechaModificacion = DateTime.Now;
            inmuebleActualizado.UsuarioModificadorId = usuarioActualId;

            var resultado = await serv_inmueble.Actualizar(inmuebleActualizado);
            
            if (resultado.Correcto && resultado.Datos != null)
            {
                await LogHelper.Info($"Inmueble actualizado exitosamente: {resultado.Datos.Nombre}");
                
                MostrarNotificacion(
                    NotificationSeverity.Success, 
                    "?Inmueble Actualizado!", 
                    $"El inmueble '{inmuebleActualizado.Nombre}' ha sido actualizado exitosamente.",
                    $"/inmuebles/{resultado.Datos.Id}"
                );
            }
            else
            {
                await LogHelper.Warn($"Error al actualizar inmueble: {resultado.Mensaje}");
                MostrarNotificacion(
                    NotificationSeverity.Error, 
                    "Error al Actualizar", 
                    resultado.Mensaje ?? "Error desconocido al actualizar el inmueble"
                );
            }
        }
        catch (Exception ex)
        {
            await LogHelper.Error($"Excepci?n al actualizar inmueble: {ex.Message}");
            MostrarNotificacion(
                NotificationSeverity.Error, 
                "Error Inesperado", 
                $"Ocurri? un error inesperado: {ex.Message}"
            );
        }
        finally
        {
            guardando = false;
        }
    }

    private async Task Cancelar()
    {
        await LogHelper.Info("Usuario cancel? la edici?n de inmueble");
        
        var confirmar = await MostrarConfirmacion(
            "?Est?s seguro de que quieres cancelar? Se perder?n todos los cambios no guardados.",
            "Confirmar Cancelaci?n",
            "S?, cancelar",
            "No, continuar"
        );

        if (confirmar)
        {
            IrA($"/inmuebles/{Id}");
        }
    }

    private async Task GestionarCaracteristicas()
    {
        try
        {
            var result = await DialogService.OpenAsync<GestionarCaracteristicasDialog>(
                $"Características - {inmueble?.Nombre}",
                new Dictionary<string, object>() 
                { 
                    { "Inmueble", inmueble! }
                },
                new DialogOptions() 
                { 
                    Width = "800px", 
                    Height = "600px", 
                    Resizable = true, 
                    Draggable = true,
                    CloseDialogOnOverlayClick = false
                });

            if (result == true)
            {
                if (caracteristicasViewer != null)
                {
                    await caracteristicasViewer.RefreshCaracteristicas();
                }
                MostrarNotificacion(NotificationSeverity.Success, "?xito", "Características actualizadas correctamente");
            }
        }
        catch (Exception ex)
        {
            MostrarNotificacion(NotificationSeverity.Error, "Error", $"Error al abrir gestión de características: {ex.Message}");
        }
    }

    private async Task GestionarImagenes()
    {
        try
        {
            var result = await DialogService.OpenAsync<AgregarImagenesDialog>(
                $"Gestionar Imágenes - {inmueble?.Nombre}",
                new Dictionary<string, object>() 
                { 
                    { "InmuebleId", inmueble!.Id },
                    { "NombreInmueble", inmueble.Nombre }
                },
                new DialogOptions() 
                { 
                    Width = "900px", 
                    Height = "700px", 
                    Resizable = true, 
                    Draggable = true,
                    CloseDialogOnOverlayClick = false
                });

            if (result == true)
            {
                await CargarImagenesPreview();
                await CargarInmueble(); // Para actualizar la imagen principal
                MostrarNotificacion(NotificationSeverity.Success, "?xito", "Imágenes actualizadas correctamente");
            }
        }
        catch (Exception ex)
        {
            MostrarNotificacion(NotificationSeverity.Error, "Error", $"Error al abrir gestión de imágenes: {ex.Message}");
        }
    }

}