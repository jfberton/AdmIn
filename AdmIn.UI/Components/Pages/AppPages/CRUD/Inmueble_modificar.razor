@page "/inmuebles/editar/{id:int}"
@inherits BaseComponent

@using AdmIn.Common.Entidades
@using AdmIn.Common
@using AdmIn.UI.Services
@using Microsoft.AspNetCore.Components.Authorization

@inject IServ_Inmueble serv_inmueble
@inject IServ_InmuebleCondicion serv_condicion
@inject IServ_Moneda serv_moneda
@inject AuthenticationStateProvider authStateProvider

<PageTitle>Editar Inmueble</PageTitle>

@if (inmueble != null)
{
    <RadzenStack Gap="2rem" Class="p-4">
        <!-- Header -->
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="1rem">
            <RadzenButton ButtonStyle="ButtonStyle.Light" 
                         Icon="arrow_back" 
                         Click="@Cancelar"
                         Size="ButtonSize.Medium" />
            <RadzenText TextStyle="TextStyle.H4" Text="@($"Editar: {inmueble.Nombre}")" />
        </RadzenStack>

        <!-- Breadcrumb -->
        <RadzenBreadCrumb>
            <RadzenBreadCrumbItem Path="/inmuebles" Text="Inmuebles" Icon="apartment" />
            <RadzenBreadCrumbItem Path="@($"/inmuebles/{inmueble.Id}")" Text="@inmueble.Nombre" Icon="home" />
            <RadzenBreadCrumbItem Text="Editar" Icon="edit" />
        </RadzenBreadCrumb>

        <!-- Formulario Principal -->
        <RadzenCard Class="form-container">
            <RadzenTemplateForm TItem="Inmueble" Data="@inmuebleEditando" Submit="@ActualizarInmueble">
                <RadzenFieldset Text="Información Básica" class="mb-4">
                    <!-- Nombre del Inmueble -->
                    <RadzenRow class="mb-3">
                        <RadzenColumn>
                            <RadzenFormField Text="Nombre del Inmueble" Variant="Variant.Outlined" Style="width:100%">
                                <ChildContent>
                                    <RadzenTextBox @bind-Value="@inmuebleEditando.Nombre" 
                                                  MaxLength="255" 
                                                  Name="nombre" 
                                                  Placeholder="Ej: Casa en Palermo, Departamento Centro"
                                                  TValue="string" />
                                </ChildContent>
                                <Helper>
                                    <RadzenRequiredValidator Component="nombre" Text="El nombre del inmueble es requerido" />
                                </Helper>
                            </RadzenFormField>
                        </RadzenColumn>
                    </RadzenRow>

                    <!-- Descripción -->
                    <RadzenRow class="mb-3">
                        <RadzenColumn>
                            <RadzenFormField Text="Descripción" Variant="Variant.Outlined" Style="width:100%">
                                <ChildContent>
                                    <RadzenTextArea @bind-Value="@inmuebleEditando.Descripcion" 
                                                   MaxLength="1000" 
                                                   Rows="4"
                                                   Name="descripcion"
                                                   Placeholder="Descripción detallada del inmueble"
                                                   TValue="string" />
                                </ChildContent>
                            </RadzenFormField>
                        </RadzenColumn>
                    </RadzenRow>

                    <!-- Dirección -->
                    <RadzenRow class="mb-3">
                        <RadzenColumn>
                            <RadzenFormField Text="Dirección" Variant="Variant.Outlined" Style="width:100%">
                                <ChildContent>
                                    <RadzenTextBox @bind-Value="@inmuebleEditando.Direccion" 
                                                  MaxLength="500" 
                                                  Name="direccion"
                                                  Placeholder="Ej: Av. Corrientes 1234, Piso 5 Dpto A"
                                                  TValue="string" />
                                </ChildContent>
                                <Helper>
                                    <RadzenRequiredValidator Component="direccion" Text="La dirección es requerida" />
                                </Helper>
                            </RadzenFormField>
                        </RadzenColumn>
                    </RadzenRow>
                </RadzenFieldset>

                <RadzenFieldset Text="Ubicación Geográfica" class="mb-4">
                    <RadzenRow class="mb-3">
                        <RadzenColumn Size="4">
                            <RadzenFormField Text="País" Variant="Variant.Outlined" Style="width:100%">
                                <RadzenTextBox @bind-Value="@inmuebleEditando.Pais" 
                                              Name="pais" 
                                              Placeholder="Ej: Argentina" />
                            </RadzenFormField>
                        </RadzenColumn>
                        <RadzenColumn Size="4">
                            <RadzenFormField Text="Estado/Provincia" Variant="Variant.Outlined" Style="width:100%">
                                <RadzenTextBox @bind-Value="@inmuebleEditando.Estado" 
                                              Name="estadoGeografico" 
                                              Placeholder="Ej: Buenos Aires" />
                            </RadzenFormField>
                        </RadzenColumn>
                        <RadzenColumn Size="4">
                            <RadzenFormField Text="Ciudad" Variant="Variant.Outlined" Style="width:100%">
                                <RadzenTextBox @bind-Value="@inmuebleEditando.Ciudad" 
                                              Name="ciudad" 
                                              Placeholder="Ej: La Plata" />
                            </RadzenFormField>
                        </RadzenColumn>
                    </RadzenRow>
                    
                    <RadzenRow class="mb-3">
                        <RadzenColumn>
                            <RadzenFormField Text="Código Postal" Variant="Variant.Outlined" Style="width:100%">
                                <RadzenTextBox @bind-Value="@inmuebleEditando.CodigoPostal" 
                                              Name="codigoPostal" 
                                              Placeholder="Ej: 1900" />
                            </RadzenFormField>
                        </RadzenColumn>
                    </RadzenRow>
                </RadzenFieldset>

                <RadzenFieldset Text="Condición y Disponibilidad" class="mb-4">
                    <RadzenRow class="mb-3">
                        <!-- Condición del Inmueble -->
                        <RadzenColumn Size="6">
                            <RadzenFormField Text="Condición del Inmueble" Variant="Variant.Outlined" Style="width:100%">
                                <ChildContent>
                                    <RadzenDropDown @bind-Value="@condicionSeleccionada" 
                                                   Data="@condicionesDisponibles" 
                                                   TextProperty="Nombre"
                                                   ValueProperty="Id"
                                                   Placeholder="Seleccione la condición del inmueble"
                                                   Name="condicionInmueble"
                                                   Change="@OnCondicionChanged" />
                                </ChildContent>
                                <Helper>
                                    <RadzenRequiredValidator Component="condicionInmueble" Text="La condición del inmueble es requerida" />
                                </Helper>
                            </RadzenFormField>
                        </RadzenColumn>

                        <!-- Estado Activo -->
                        <RadzenColumn Size="6">
                            <RadzenFormField Text="Disponibilidad" Variant="Variant.Outlined" Style="width:100%">
                                <ChildContent>
                                    <RadzenCheckBox @bind-Value="@inmuebleEditando.Activo" Name="activo" />
                                    <RadzenLabel Text="Inmueble Activo" Component="activo" Style="margin-left: 8px;" />
                                </ChildContent>
                                <Helper>
                                    <RadzenText TextStyle="TextStyle.Caption" Style="color: #6b7280; margin-top: 4px;">
                                        Un inmueble inactivo no aparecerá en las búsquedas
                                    </RadzenText>
                                </Helper>
                            </RadzenFormField>
                        </RadzenColumn>
                    </RadzenRow>

                    @if (condicionSeleccionada != null)
                    {
                        <RadzenRow class="mb-3">
                            <RadzenColumn>
                                <RadzenAlert AlertStyle="AlertStyle.Info" ShowIcon="true">
                                    <RadzenText TextStyle="TextStyle.Body2">
                                        Condición seleccionada: <strong>@condicionesDisponibles.FirstOrDefault(c => c.Id == condicionSeleccionada)?.Nombre</strong>
                                        @if (!string.IsNullOrEmpty(condicionesDisponibles.FirstOrDefault(c => c.Id == condicionSeleccionada)?.Descripcion))
                                        {
                                            <br />@condicionesDisponibles.FirstOrDefault(c => c.Id == condicionSeleccionada)?.Descripcion
                                        }
                                    </RadzenText>
                                </RadzenAlert>
                            </RadzenColumn>
                        </RadzenRow>
                    }
                </RadzenFieldset>

                <RadzenFieldset Text="Información Económica" class="mb-4">
                    <RadzenRow class="mb-3">
                        <!-- Valor del Inmueble -->
                        <RadzenColumn Size="6">
                            <RadzenFormField Text="Valor del Inmueble" Variant="Variant.Outlined" Style="width:100%">
                                <ChildContent>
                                    <RadzenNumeric @bind-Value="@inmuebleEditando.Valor" 
                                                  Format="C2" 
                                                  Min="0"
                                                  Name="valor"
                                                  Placeholder="0.00"
                                                  TValue="decimal" />
                                </ChildContent>
                                <Helper>
                                    <RadzenRequiredValidator Component="valor" Text="El valor es requerido" />
                                    <RadzenNumericRangeValidator Component="valor" Min="1" Text="El valor debe ser mayor a 0" />
                                </Helper>
                            </RadzenFormField>
                        </RadzenColumn>

                        <!-- Renta Mensual -->
                        <RadzenColumn Size="6">
                            <RadzenFormField Text="Renta Mensual" Variant="Variant.Outlined" Style="width:100%">
                                <ChildContent>
                                    <RadzenNumeric @bind-Value="@inmuebleEditando.RentaMensual" 
                                                  Format="C2" 
                                                  Min="0"
                                                  Name="rentaMensual"
                                                  Placeholder="0.00"
                                                  TValue="decimal" />
                                </ChildContent>
                            </RadzenFormField>
                        </RadzenColumn>
                    </RadzenRow>

                    <RadzenRow class="mb-3">
                        <!-- Moneda -->
                        <RadzenColumn Size="6">
                            <RadzenFormField Text="Moneda" Variant="Variant.Outlined" Style="width:100%">
                                <ChildContent>
                                    @if (ListaMonedas.Any())
                                    {
                                        <RadzenDropDown @bind-Value="@inmuebleEditando.MonedaId" 
                                                       Data="@ListaMonedas" 
                                                       TextProperty="Nombre" 
                                                       ValueProperty="Id"
                                                       Placeholder="Seleccione una moneda"
                                                       Name="moneda" />
                                    }
                                    else
                                    {
                                        <RadzenTextBox Value="Cargando monedas..." ReadOnly="true" />
                                    }
                                </ChildContent>
                                <Helper>
                                    <RadzenRequiredValidator Component="moneda" Text="La moneda es requerida" />
                                </Helper>
                            </RadzenFormField>
                        </RadzenColumn>

                        <!-- Construcción M2 -->
                        <RadzenColumn Size="6">
                            <RadzenFormField Text="Construcción (m²)" Variant="Variant.Outlined" Style="width:100%">
                                <ChildContent>
                                    <RadzenNumeric @bind-Value="@inmuebleEditando.ConstruccionM2" 
                                                  Format="N2" 
                                                  Min="0"
                                                  Name="construccionM2"
                                                  Placeholder="0.00"
                                                  TValue="decimal" />
                                </ChildContent>
                            </RadzenFormField>
                        </RadzenColumn>
                    </RadzenRow>
                </RadzenFieldset>

                <RadzenFieldset Text="Coordenadas (Opcional)" class="mb-4">
                    <RadzenRow class="mb-3">
                        <RadzenColumn Size="6">
                            <RadzenFormField Text="Latitud" Variant="Variant.Outlined" Style="width:100%">
                                <ChildContent>
                                    <RadzenNumeric @bind-Value="@inmuebleEditando.Latitud" 
                                                  Format="N6" 
                                                  Min="-90" 
                                                  Max="90"
                                                  Name="latitud"
                                                  Placeholder="Ej: -34.603722"
                                                  TValue="decimal" />
                                </ChildContent>
                            </RadzenFormField>
                        </RadzenColumn>
                        <RadzenColumn Size="6">
                            <RadzenFormField Text="Longitud" Variant="Variant.Outlined" Style="width:100%">
                                <ChildContent>
                                    <RadzenNumeric @bind-Value="@inmuebleEditando.Longitud" 
                                                  Format="N6" 
                                                  Min="-180" 
                                                  Max="180"
                                                  Name="longitud"
                                                  Placeholder="Ej: -58.381592"
                                                  TValue="decimal" />
                                </ChildContent>
                            </RadzenFormField>
                        </RadzenColumn>
                    </RadzenRow>
                </RadzenFieldset>

                <!-- Botones de Acción -->
                <RadzenStack Orientation="Orientation.Horizontal" Gap="1rem" JustifyContent="JustifyContent.End" class="mt-4">
                    <RadzenButton ButtonStyle="ButtonStyle.Secondary" 
                                 Icon="cancel" 
                                 Text="Cancelar" 
                                 Click="@Cancelar" />
                    <RadzenButton ButtonStyle="ButtonStyle.Primary" 
                                 Icon="save" 
                                 Text="Actualizar" 
                                 ButtonType="ButtonType.Submit"
                                 IsBusy="@guardando" />
                </RadzenStack>
            </RadzenTemplateForm>
        </RadzenCard>

        <!-- Información de Auditoría -->
        <RadzenCard Class="info-card">
            <RadzenStack Gap="1rem">
                <RadzenText TextStyle="TextStyle.H6" Text="Información de Auditoría" />
                <RadzenRow Gap="1rem">
                    <RadzenColumn Size="6" SizeMD="3">
                        <div class="audit-info">
                            <RadzenText TextStyle="TextStyle.Caption" Text="CREADO EL" />
                            <RadzenText TextStyle="TextStyle.Body2" Text="@inmueble.FechaCreacion.ToString("dd/MM/yyyy HH:mm")" />
                        </div>
                    </RadzenColumn>
                    <RadzenColumn Size="6" SizeMD="3">
                        <div class="audit-info">
                            <RadzenText TextStyle="TextStyle.Caption" Text="MODIFICADO EL" />
                            <RadzenText TextStyle="TextStyle.Body2" Text="@inmueble.FechaModificacion.ToString("dd/MM/yyyy HH:mm")" />
                        </div>
                    </RadzenColumn>
                    @if (inmueble.UsuarioCreador != null)
                    {
                        <RadzenColumn Size="6" SizeMD="3">
                            <div class="audit-info">
                                <RadzenText TextStyle="TextStyle.Caption" Text="CREADO POR" />
                                <RadzenText TextStyle="TextStyle.Body2" Text="@inmueble.UsuarioCreador.Nombre" />
                            </div>
                        </RadzenColumn>
                    }
                    @if (inmueble.UsuarioModificador != null)
                    {
                        <RadzenColumn Size="6" SizeMD="3">
                            <div class="audit-info">
                                <RadzenText TextStyle="TextStyle.Caption" Text="MODIFICADO POR" />
                                <RadzenText TextStyle="TextStyle.Body2" Text="@inmueble.UsuarioModificador.Nombre" />
                            </div>
                        </RadzenColumn>
                    }
                </RadzenRow>
            </RadzenStack>
        </RadzenCard>
    </RadzenStack>
}
else if (cargando)
{
    <RadzenStack AlignItems="AlignItems.Center" JustifyContent="JustifyContent.Center" Gap="1rem" Class="p-8">
        <RadzenProgressBarCircular ProgressBarStyle="ProgressBarStyle.Primary" Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate" />
        <RadzenText TextStyle="TextStyle.Body1" Text="Cargando inmueble..." />
    </RadzenStack>
}
else
{
    <RadzenStack AlignItems="AlignItems.Center" JustifyContent="JustifyContent.Center" Gap="1rem" Class="p-8">
        <RadzenIcon Icon="error_outline" Style="font-size: 64px; color: var(--rz-danger);" />
        <RadzenText TextStyle="TextStyle.H5" Text="Inmueble no encontrado" />
        <RadzenText TextStyle="TextStyle.Body1" Text="El inmueble solicitado no existe o no tienes permisos para editarlo." />
        <RadzenButton ButtonStyle="ButtonStyle.Primary" Text="Volver a Inmuebles" Click="@(() => IrA("/inmuebles"))" />
    </RadzenStack>
}

<style>
    .form-container {
        max-width: 1200px;
        margin: 0 auto;
    }
    
    .info-card {
        max-width: 1200px;
        margin: 0 auto;
        background: #f8fafc;
    }
    
    .audit-info {
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
    }

    .audit-info .rz-text:first-child {
        color: #6b7280;
        font-weight: 600;
        letter-spacing: 0.05em;
    }
</style>

@code {
    [Parameter] public int Id { get; set; }
    
    private Inmueble? inmueble;
    private Inmueble inmuebleEditando = new();
    private bool cargando = true;
    private bool guardando = false;
    private int? usuarioActualId;

    // Condiciones del inmueble
    private List<InmuebleCondicion> condicionesDisponibles = new();
    private int? condicionSeleccionada = null;
    
    // Monedas disponibles
    private List<Moneda> ListaMonedas = new();

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        
        await ObtenerUsuarioActual();
        await CargarCondicionesDisponibles();
        await CargarMonedas();
        await CargarInmueble();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (inmueble?.Id != Id)
        {
            await CargarInmueble();
        }
    }

    private async Task CargarMonedas()
    {
        try
        {
            var resultado = await serv_moneda.Obtener_todos();
            if (resultado.Correcto && resultado.Datos != null)
            {
                ListaMonedas = resultado.Datos.ToList();
            }
            else
            {
                await LogHelper.Warn($"No se pudieron cargar las monedas: {resultado.Mensaje}");
                // Crear una moneda por defecto si no hay ninguna
                ListaMonedas = new List<Moneda>
                {
                    new Moneda { Id = 1, Nombre = "Peso Argentino", Codigo = "ARS" }
                };
            }
        }
        catch (Exception ex)
        {
            await LogHelper.Error($"Error al cargar monedas: {ex.Message}");
            ListaMonedas = new List<Moneda>
            {
                new Moneda { Id = 1, Nombre = "Peso Argentino", Codigo = "ARS" }
            };
        }
    }

    private async Task CargarCondicionesDisponibles()
    {
        try
        {
            var resultado = await serv_condicion.Obtener_activos();
            if (resultado.Correcto && resultado.Datos != null)
            {
                condicionesDisponibles = resultado.Datos.ToList();
            }
            else
            {
                await LogHelper.Warn($"No se pudieron cargar las condiciones: {resultado.Mensaje}");
                // Crear una condición por defecto si no hay ninguna
                condicionesDisponibles = new List<InmuebleCondicion>
                {
                    new InmuebleCondicion { Id = 1, Nombre = "Disponible", Descripcion = "Condición por defecto" }
                };
            }
        }
        catch (Exception ex)
        {
            await LogHelper.Error($"Error al cargar condiciones: {ex.Message}");
            condicionesDisponibles = new List<InmuebleCondicion>
            {
                new InmuebleCondicion { Id = 1, Nombre = "Disponible", Descripcion = "Condición por defecto" }
            };
        }
    }

    private async Task ObtenerUsuarioActual()
    {
        try
        {
            var authState = await authStateProvider.GetAuthenticationStateAsync();
            var userIdClaim = authState.User.FindFirst("Id");
            
            if (userIdClaim != null && int.TryParse(userIdClaim.Value, out int userId))
            {
                usuarioActualId = userId;
            }
        }
        catch (Exception ex)
        {
            await LogHelper.Error($"Error obteniendo usuario actual: {ex.Message}");
        }
    }

    private async Task CargarInmueble()
    {
        try
        {
            cargando = true;
            await LogHelper.Info($"Cargando inmueble para edición con ID: {Id}");

            var resultado = await serv_inmueble.Obtener_por_id(Id);
            
            if (resultado.Correcto && resultado.Datos != null)
            {
                inmueble = resultado.Datos;
                
                // Crear copia para edición
                inmuebleEditando = new Inmueble
                {
                    Id = inmueble.Id,
                    Nombre = inmueble.Nombre,
                    Direccion = inmueble.Direccion,
                    Pais = inmueble.Pais,
                    Estado = inmueble.Estado,
                    Ciudad = inmueble.Ciudad,
                    CodigoPostal = inmueble.CodigoPostal,
                    Latitud = inmueble.Latitud,
                    Longitud = inmueble.Longitud,
                    Valor = inmueble.Valor,
                    ConstruccionM2 = inmueble.ConstruccionM2,
                    RentaMensual = inmueble.RentaMensual,
                    AdministradorId = inmueble.AdministradorId,
                    Descripcion = inmueble.Descripcion,
                    ImagenPrincipalId = inmueble.ImagenPrincipalId,
                    MonedaId = inmueble.MonedaId,
                    CondicionId = inmueble.CondicionId,
                    Activo = inmueble.Activo,
                    FechaCreacion = inmueble.FechaCreacion,
                    FechaModificacion = inmueble.FechaModificacion,
                    UsuarioCreadorId = inmueble.UsuarioCreadorId,
                    UsuarioModificadorId = inmueble.UsuarioModificadorId
                };

                // Establecer condición seleccionada
                condicionSeleccionada = inmueble.CondicionId > 0 ? inmueble.CondicionId : 1;
                
                EstablecerTituloPagina("Inmuebles", $"Editar: {inmueble.Nombre}");
                await LogHelper.Info($"Inmueble cargado para edición: {inmueble.Nombre}");
            }
            else
            {
                await LogHelper.Warn($"No se pudo cargar el inmueble para edición con ID: {Id}. Mensaje: {resultado.Mensaje}");
                EstablecerTituloPagina("Inmuebles", "No encontrado");
            }
        }
        catch (Exception ex)
        {
            await LogHelper.Error($"Error al cargar inmueble para edición: {ex.Message}");
            MostrarNotificacion(
                NotificationSeverity.Error,
                "Error",
                "No se pudo cargar la información del inmueble para editar"
            );
        }
        finally
        {
            cargando = false;
        }
    }

    private void OnCondicionChanged(object value)
    {
        if (value != null && int.TryParse(value.ToString(), out int condicionId))
        {
            condicionSeleccionada = condicionId;
            inmuebleEditando.CondicionId = condicionId;
            StateHasChanged();
        }
    }

    private async Task ActualizarInmueble(Inmueble inmuebleActualizado)
    {
        if (guardando) return;
        
        try
        {
            guardando = true;
            await LogHelper.Info($"Iniciando actualización de inmueble ID: {inmuebleActualizado.Id}");

            // Asegurar que la condición esté asignada al modelo
            inmuebleActualizado.CondicionId = condicionSeleccionada ?? 1;

            // Mantener información de auditoría
            inmuebleActualizado.FechaModificacion = DateTime.Now;
            inmuebleActualizado.UsuarioModificadorId = usuarioActualId;

            var resultado = await serv_inmueble.Actualizar(inmuebleActualizado);
            
            if (resultado.Correcto && resultado.Datos != null)
            {
                await LogHelper.Info($"Inmueble actualizado exitosamente: {resultado.Datos.Nombre}");
                
                MostrarNotificacion(
                    NotificationSeverity.Success, 
                    "¡Inmueble Actualizado!", 
                    $"El inmueble '{inmuebleActualizado.Nombre}' ha sido actualizado exitosamente.",
                    $"/inmuebles/{resultado.Datos.Id}"
                );
            }
            else
            {
                await LogHelper.Warn($"Error al actualizar inmueble: {resultado.Mensaje}");
                MostrarNotificacion(
                    NotificationSeverity.Error, 
                    "Error al Actualizar", 
                    resultado.Mensaje ?? "Error desconocido al actualizar el inmueble"
                );
            }
        }
        catch (Exception ex)
        {
            await LogHelper.Error($"Excepción al actualizar inmueble: {ex.Message}");
            MostrarNotificacion(
                NotificationSeverity.Error, 
                "Error Inesperado", 
                $"Ocurrió un error inesperado: {ex.Message}"
            );
        }
        finally
        {
            guardando = false;
        }
    }

    private async Task Cancelar()
    {
        await LogHelper.Info("Usuario canceló la edición de inmueble");
        
        var confirmar = await MostrarConfirmacion(
            "¿Estás seguro de que quieres cancelar? Se perderán todos los cambios no guardados.",
            "Confirmar Cancelación",
            "Sí, cancelar",
            "No, continuar"
        );

        if (confirmar)
        {
            IrA($"/inmuebles/{Id}");
        }
    }
}