@page "/caracteristicas"

@inherits BaseComponent

@using AdmIn.Common.Entidades
@using AdmIn.Common
@using AdmIn.UI.Services
@using AdmIn.UI.Services.UtilityServices
@using Microsoft.AspNetCore.Components.Authorization

@inject IServ_Caracteristica Serv_caracteristica;

<MiRadzenButton ButtonStyle="ButtonStyle.Primary" Text="Agregar característica" OnClick="@(() => Agregar())" />

<RadzenDataGrid class="rz-m-2" @ref="grilla" IsLoading=@isLoading Count="@count" Data="@items" EmptyText="No hay registros para mostrar"
LoadData="@LoadData" AllowSorting="true" AllowFiltering="true" FilterMode="FilterMode.Simple" AllowPaging="true" PageSize="5"
PagerHorizontalAlign="HorizontalAlign.Center" TItem="Caracteristica">
    <Columns>
        <RadzenDataGridColumn TItem="Caracteristica" Property="Nombre" Title="Nombre" MinWidth="200px" />
        <RadzenDataGridColumn TItem="Caracteristica" Property="Tipo" Title="Tipo" MinWidth="150px" />
        <RadzenDataGridColumn TItem="Caracteristica" Property="Descripcion" Title="Descripción" MinWidth="300px" />
        <RadzenDataGridColumn Width="250px" TItem="Caracteristica" Context="car" MinWidth="250px">
            <Template>
                <MiRadzenButton ButtonStyle="ButtonStyle.Primary" Variant="Variant.Outlined" Shade="Shade.Lighter" Title="Ver" Icon="visibility" Size="ButtonSize.ExtraSmall" OnClick=@(() => Ver(car)) />
                <AuthorizeView Roles="admin_usuario">
                    <Authorized>
                        <MiRadzenButton ButtonStyle="ButtonStyle.Primary" Variant="Variant.Outlined" Shade="Shade.Lighter" Title="Editar" Icon="edit" Size="ButtonSize.ExtraSmall" OnClick=@(() => Editar(car)) />
                        <MiRadzenButton ButtonStyle="ButtonStyle.Danger" Variant="Variant.Outlined" Shade="Shade.Lighter" Title="Eliminar" Icon="delete" Size="ButtonSize.ExtraSmall" OnClick=@(() => Eliminar(car)) />
                    </Authorized>
                </AuthorizeView>
            </Template>
        </RadzenDataGridColumn>
    </Columns>
</RadzenDataGrid>

@code {
    RadzenDataGrid<Caracteristica> grilla;

    bool isLoading = false;
    int count;
    IEnumerable<Caracteristica> items;

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        base.EstablecerTituloPagina("Características", "Listado");
    }

    async Task LoadData(LoadDataArgs args)
    {
        isLoading = true;

        try
        {
            Filtros_paginado filtros = new Filtros_paginado
            {
                Skip = args.Skip.HasValue ? args.Skip.Value : 0,
                Top = args.Top.HasValue ? args.Top.Value : 5,
                OrderBy = !string.IsNullOrEmpty(args.OrderBy) ? args.OrderBy : "Nombre",
                Filter = args.Filter
            };

            var rta = await Serv_caracteristica.Obtener_paginado(filtros);

            if (rta.Correcto)
            {
                items = rta.Datos.Items;
                count = rta.Datos.Total_items;
            }
            else
            {
                base.MostrarNotificacion(NotificationSeverity.Error, "Error!", rta.Mensaje);
            }
        }
        catch (Exception ex)
        {
            base.MostrarNotificacion(NotificationSeverity.Error, "Error!", $"Error al cargar características: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    void Agregar()
    {
        base.IrA("/caracteristicas/nuevo");
    }

    void Ver(Caracteristica caracteristica)
    {
        base.IrA($"/caracteristicas/detalle/{caracteristica.Id}");
    }

    void Editar(Caracteristica caracteristica)
    {
        base.IrA($"/caracteristicas/modificar/{caracteristica.Id}");
    }

    async Task Eliminar(Caracteristica caracteristica)
    {
        try
        {
            var confirmResult = await base.MostrarConfirmacion("¿Está seguro de eliminar la característica '" + caracteristica.Nombre + "'?", "Confirmar eliminación");

            if (confirmResult == true)
            {
                var rta = await Serv_caracteristica.Eliminar(caracteristica.Id);

                if (rta.Correcto)
                {
                    base.MostrarNotificacion(NotificationSeverity.Success, "Éxito!", "Característica eliminada correctamente");
                    await grilla.Reload();
                }
                else
                {
                    base.MostrarNotificacion(NotificationSeverity.Error, "Error!", rta.Mensaje);
                }
            }
        }
        catch (Exception ex)
        {
            base.MostrarNotificacion(NotificationSeverity.Error, "Error!", $"Error al eliminar característica: {ex.Message}");
        }
    }
}