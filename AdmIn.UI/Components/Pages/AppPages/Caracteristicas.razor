@page "/caracteristicas"

@inherits BaseComponent

@using AdmIn.Common.Entidades
@using AdmIn.Common
@using AdmIn.UI.Services
@using AdmIn.UI.Services.UtilityServices
@using Microsoft.AspNetCore.Components.Authorization

@inject IServ_Caracteristica Serv_caracteristica;

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3>Gestión de Características</h3>
    <button class="btn btn-primary" @onclick="NuevaCaracteristica">
        <i class="fas fa-plus"></i> Nueva Característica
    </button>
</div>

<!-- Filtros Avanzados -->
<div class="card mb-4">
    <div class="card-body">
        <div class="row g-3">
            <div class="col-md-4">
                <label class="form-label">Buscar:</label>
                <input type="text" class="form-control" @bind="filtroTexto" 
                       @onkeypress="@(async (e) => { if (e.Key == "Enter") await RecargarGrilla(); })"
                       placeholder="Nombre o descripción..." />
            </div>
            <div class="col-md-2">
                <label class="form-label">Ordenar por:</label>
                <select class="form-select" @bind="ordenarPor" @bind:after="RecargarGrilla">
                    <option value="Nombre">Nombre</option>
                    <option value="Tipo">Tipo</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label">Tipo:</label>
                <select class="form-select" @bind="filtroTipo" @bind:after="RecargarGrilla">
                    <option value="todos">Todos</option>
                    <option value="texto">Texto</option>
                    <option value="numerico">Numérico</option>
                    <option value="booleano">Booleano</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label">Por página:</label>
                <select class="form-select" @bind="tamanioPagina" @bind:after="RecargarGrilla">
                    <option value="5">5</option>
                    <option value="10">10</option>
                    <option value="25">25</option>
                    <option value="50">50</option>
                </select>
            </div>
            <div class="col-md-2 d-flex align-items-end">
                <button class="btn btn-outline-primary w-100" @onclick="RecargarGrilla">
                    <i class="fas fa-search"></i> Buscar
                </button>
            </div>
        </div>
    </div>
</div>

<RadzenDataGrid class="rz-m-2" @ref="grilla" IsLoading=@isLoading Count="@count" Data="@items" EmptyText="No hay registros para mostrar"
LoadData="@LoadData" AllowSorting="false" AllowFiltering="false" AllowPaging="true" PageSize="@tamanioPagina"
PagerHorizontalAlign="HorizontalAlign.Center" TItem="Caracteristica">
    <Columns>
        <RadzenDataGridColumn TItem="Caracteristica" Property="Nombre" Title="Nombre" MinWidth="200px" />
        <RadzenDataGridColumn TItem="Caracteristica" Title="Tipo" MinWidth="150px">
            <Template Context="caracteristica">
                <span class="badge bg-info">@caracteristica.Tipo</span>
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="Caracteristica" Property="Descripcion" Title="Descripción" MinWidth="300px">
            <Template Context="caracteristica">
                @if (!string.IsNullOrEmpty(caracteristica.Descripcion))
                {
                    @caracteristica.Descripcion
                }
                else
                {
                    <em class="text-muted">Sin descripción</em>
                }
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Width="250px" TItem="Caracteristica" Context="car" MinWidth="250px">
            <Template>
                <MiRadzenButton ButtonStyle="ButtonStyle.Primary" Variant="Variant.Outlined" Shade="Shade.Lighter" Title="Ver" Icon="visibility" Size="ButtonSize.ExtraSmall" OnClick=@(() => Ver(car)) />
                <AuthorizeView Roles="admin_usuario">
                    <Authorized>
                        <MiRadzenButton ButtonStyle="ButtonStyle.Primary" Variant="Variant.Outlined" Shade="Shade.Lighter" Title="Editar" Icon="edit" Size="ButtonSize.ExtraSmall" OnClick=@(() => Editar(car)) />
                        <MiRadzenButton ButtonStyle="ButtonStyle.Danger" Variant="Variant.Outlined" Shade="Shade.Lighter" Title="Eliminar" Icon="delete" Size="ButtonSize.ExtraSmall" OnClick=@(() => Eliminar(car)) />
                    </Authorized>
                </AuthorizeView>
            </Template>
        </RadzenDataGridColumn>
    </Columns>
</RadzenDataGrid>

@code {
    RadzenDataGrid<Caracteristica> grilla;

    bool isLoading = false;
    int count;
    IEnumerable<Caracteristica> items;
    
    // Filtros avanzados
    string filtroTexto = "";
    string ordenarPor = "Nombre";
    string filtroTipo = "todos";
    int tamanioPagina = 10;

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        base.EstablecerTituloPagina("Características", "Listado");
    }

    async Task LoadData(LoadDataArgs args)
    {
        isLoading = true;

        try
        {
            Filtros_paginado filtros = new Filtros_paginado
            {
                Skip = args.Skip.HasValue ? args.Skip.Value : 0,
                Top = args.Top.HasValue ? args.Top.Value : tamanioPagina,
                OrderBy = ordenarPor,
                Filter = filtroTexto
            };

            var rta = await Serv_caracteristica.Obtener_paginado(filtros);

            if (rta.Correcto)
            {
                var caracteristicas = rta.Datos.Items.ToList();

                // Aplicar filtro por tipo si es necesario
                if (filtroTipo != "todos")
                {
                    caracteristicas = caracteristicas.Where(c => c.Tipo.ToLower() == filtroTipo.ToLower()).ToList();
                }

                items = caracteristicas;
                count = caracteristicas.Count; // Para simplicidad, usamos el conteo filtrado
            }
            else
            {
                base.MostrarNotificacion(NotificationSeverity.Error, "Error!", rta.Mensaje);
            }
        }
        catch (Exception ex)
        {
            base.MostrarNotificacion(NotificationSeverity.Error, "Error!", $"Error al cargar características: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    async Task RecargarGrilla()
    {
        if (grilla != null)
        {
            await grilla.FirstPage();
        }
    }

    void NuevaCaracteristica()
    {
        base.IrA("/caracteristicas/nuevo");
    }

    void Ver(Caracteristica caracteristica)
    {
        base.IrA($"/caracteristicas/detalle/{caracteristica.Id}");
    }

    void Editar(Caracteristica caracteristica)
    {
        base.IrA($"/caracteristicas/modificar/{caracteristica.Id}");
    }

    async Task Eliminar(Caracteristica caracteristica)
    {
        try
        {
            var confirmResult = await base.MostrarConfirmacion("¿Está seguro de eliminar la característica '" + caracteristica.Nombre + "'?", "Confirmar eliminación");

            if (confirmResult == true)
            {
                var rta = await Serv_caracteristica.Eliminar(caracteristica.Id);

                if (rta.Correcto)
                {
                    base.MostrarNotificacion(NotificationSeverity.Success, "Éxito!", "Característica eliminada correctamente");
                    await grilla.Reload();
                }
                else
                {
                    base.MostrarNotificacion(NotificationSeverity.Error, "Error!", rta.Mensaje);
                }
            }
        }
        catch (Exception ex)
        {
            base.MostrarNotificacion(NotificationSeverity.Error, "Error!", $"Error al eliminar característica: {ex.Message}");
        }
    }
}