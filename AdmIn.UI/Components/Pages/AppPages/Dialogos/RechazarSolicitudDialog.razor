@using AdmIn.Common.Entidades
@using AdmIn.UI.Services
@inject IServ_TrabajoProveedor TrabajoService
@inject NotificationService NotificationService
@inject DialogService DialogService
@inject Microsoft.AspNetCore.Components.Authorization.AuthenticationStateProvider AuthState

<RadzenCard>
    <RadzenTemplateForm TItem="Model" Data="model" Submit="OnSubmit">
        <div style="padding:12px;">
            <div style="margin-bottom:8px;">
                <label style="font-weight:600;">Motivo del rechazo</label>
                <div>
                    <RadzenTextArea @bind-Value="model.Comentario" Style="width:100%" />
                </div>
            </div>

            <div style="display:flex; gap:8px; margin-top:12px; justify-content:flex-end;">
                <RadzenButton ButtonStyle="ButtonStyle.Danger" Text="Rechazar" ButtonType="ButtonType.Submit" />
                <RadzenButton ButtonStyle="ButtonStyle.Secondary" Text="Cancelar" Click="Cancel" Style="margin-left:8px;" />
            </div>
        </div>
    </RadzenTemplateForm>
</RadzenCard>

@code{
    [Parameter] public TrabajoProveedor trabajo { get; set; }

    class Model { public string Comentario { get; set; } = string.Empty; }
    private Model model = new();

    private async Task<int> GetCurrentUsuarioId()
    {
        try
        {
            var auth = await AuthState.GetAuthenticationStateAsync();
            var user = auth.User;
            var idClaim = user.FindFirst("Id")?.Value ?? user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? user.FindFirst("sub")?.Value;
            if (!string.IsNullOrEmpty(idClaim) && int.TryParse(idClaim, out var parsed)) return parsed;
        }
        catch { }
        return 0;
    }

    private async Task OnSubmit()
    {
        if (trabajo == null)
        {
            NotificationService.Notify(new NotificationMessage { Severity = NotificationSeverity.Error, Summary = "Error", Detail = "Trabajo no especificado." });
            DialogService.Close(false);
            return;
        }

        var usuarioId = await GetCurrentUsuarioId();
        if (usuarioId == 0)
        {
            NotificationService.Notify(new NotificationMessage { Severity = NotificationSeverity.Error, Summary = "Error", Detail = "No se pudo identificar el usuario." });
            return;
        }

        var req = new TrabajoAccionRequest { TrabajoId = trabajo.Id, UsuarioId = usuarioId, Comentario = string.IsNullOrWhiteSpace(model.Comentario) ? null : model.Comentario };
        var r = await TrabajoService.RechazarTrabajo(req);
        if (r != null && r.Correcto)
        {
            NotificationService.Notify(new NotificationMessage { Severity = NotificationSeverity.Success, Summary = "Rechazado", Detail = r.Mensaje });
            DialogService.Close(true);
        }
        else
        {
            NotificationService.Notify(new NotificationMessage { Severity = NotificationSeverity.Error, Summary = "Error", Detail = r?.Mensaje ?? "Error al rechazar" });
        }
    }

    private void Cancel() => DialogService.Close(false);
}
