@using AdmIn.Common.Entidades
@using AdmIn.UI.Services
@using AdmIn.UI.Components.Shared
@inject IServ_DetalleTrabajo DetalleService
@inject IServ_HistorialDetalleTrabajo HistorialDetalleService
@inject IServ_TrabajoProveedor TrabajoService
@inject NotificationService NotificationService
@inject DialogService DialogService
@inject IJSRuntime JSRuntime
@inject Microsoft.AspNetCore.Components.Authorization.AuthenticationStateProvider AuthenticationStateProvider

<RadzenCard>
    <RadzenStack Gap="0.5rem">
        <div style="display:flex;justify-content:space-between;align-items:flex-start;gap:1rem;"> <!-- align-items:flex-start -->
            <div style="flex:1">
                <div style="font-weight:700;color:#374151;">Descripción</div>
                <div style="white-space:pre-wrap;color:#111827;margin-top:6px;">@detalle.Descripcion</div>
            </div>

            <div style="min-width:160px;text-align:right;align-self:flex-start;"> <!-- ensure top alignment -->
                <div style="color:#6b7280;font-weight:700;">Costo</div>
                <div style="font-size:1.25rem;font-weight:800;color:#059669;">@detalle.Costo.ToString("C")</div>

                <div style="margin-top:10px;color:#6b7280;font-weight:700;">A cargo de</div>
                <div style="font-weight:700;color:#111827;">@ResponsableLabel</div>
            </div>
        </div>

        <div style="display:flex;justify-content:flex-end;gap:0.5rem;margin-top:12px;">
            @if (showPasarAPropietario)
            {
                <RadzenButton ButtonStyle="ButtonStyle.Secondary" Click="ConfirmarPasarAPropietario">Pasar a propietario</RadzenButton>
            }

            @if (showPasarAInquilinoBlocked)
            {
                <RadzenButton ButtonStyle="ButtonStyle.Secondary" Click="PasarAInquilinoBloqueado">Devolver al inquilino y bloquear</RadzenButton>
            }
        </div>
    </RadzenStack>
</RadzenCard>

<!-- Images card with thumbnails -->
<RadzenCard Class="mt-3">
    <RadzenStack Gap="0.5rem">
        <div class="card-title">Imágenes del detalle</div>
        @if (detalle.Imagenes != null && detalle.Imagenes.Any())
        {
            <div class="thumbs" style="display:flex;gap:8px;overflow-x:auto;padding-top:8px;">
                @foreach (var img in detalle.Imagenes)
                {
                    <button class="thumb-btn" @onclick="() => AbrirLightbox(img)" style="border:none;background:transparent;padding:0;cursor:pointer;">
                        <img src="@(string.IsNullOrEmpty(img.UrlThumb) ? ObtenerUrlImagen(img) : img.UrlThumb)" alt="@img.Nombre" style="width:120px;height:90px;object-fit:cover;border-radius:6px;border:2px solid transparent;" />
                    </button>
                }
            </div>
        }
        else
        {
            <div>No hay imágenes asociadas a este detalle</div>
        }
    </RadzenStack>
</RadzenCard>

<!-- Footer with close button aligned to bottom-right for the entire dialog -->
<div style="display:flex;justify-content:flex-end;margin-top:12px;">
    <RadzenButton Text="Cerrar" Click="Cerrar" ButtonStyle="ButtonStyle.Secondary" />
</div>

@code{
    [Parameter] public DetalleTrabajo detalle { get; set; } = new DetalleTrabajo();

    private int currentUsuarioId = 0;
    private TrabajoProveedor? trabajoPadre;
    private bool showPasarAPropietario = false;
    private bool showPasarAInquilinoBlocked = false;

    private string ResponsableLabel
    {
        get
        {
            var estado = (detalle?.Estado ?? string.Empty).Trim();
            if (string.IsNullOrEmpty(estado))
            {
                // infer from trabajoPadre occupancy
                if (trabajoPadre != null)
                {
                    // If inmueble occupied, assigned to tenant, else owner
                    return (trabajoPadre.InmuebleId != 0) ? "Asignado Inquilino" : "Asignado Propietario";
                }
                return "Asignado Inquilino"; // default
            }

            return estado;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        currentUsuarioId = await GetCurrentUsuarioId();
        // Load parent trabajo to determine owner and inmueble
        try
        {
            var tRes = await TrabajoService.Obtener_por_id(detalle.TrabajoProveedorId);
            if (tRes != null && tRes.Correcto && tRes.Datos != null)
            {
                trabajoPadre = tRes.Datos;
            }
        }
        catch { }

        EvaluatePermissions();
    }

    private void EvaluatePermissions()
    {
        var isTenant = detalle.UsuarioId != 0 && detalle.UsuarioId == currentUsuarioId;
        var ownerId = trabajoPadre?.UsuarioCreador ?? 0;
        var isOwner = ownerId != 0 && ownerId == currentUsuarioId;

        var estado = (detalle?.Estado ?? string.Empty).Trim();

        // Determine who it's currently assigned to
        bool assignedToTenant = string.IsNullOrEmpty(estado) || estado.IndexOf("Inquilino", StringComparison.OrdinalIgnoreCase) >= 0;
        bool assignedToOwner = estado.IndexOf("Propietario", StringComparison.OrdinalIgnoreCase) >= 0;

        // Tenant can pass to provider unless the detail is in terminal 'Reasignado Inquilino'
        showPasarAPropietario = isTenant && assignedToTenant && !estado.Equals("Reasignado Inquilino", StringComparison.OrdinalIgnoreCase);

        // Owner can pass back to tenant and make it terminal when currently assigned to owner
        showPasarAInquilinoBlocked = isOwner && assignedToOwner && !estado.Equals("Reasignado Inquilino", StringComparison.OrdinalIgnoreCase);
    }

    private async Task<int> GetCurrentUsuarioId()
    {
        try
        {
            var auth = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var user = auth.User;
            var idClaim = user.FindFirst("Id")?.Value ?? user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? user.FindFirst("sub")?.Value;
            if (!string.IsNullOrEmpty(idClaim) && int.TryParse(idClaim, out var parsed)) return parsed;
        }
        catch { }
        return 0;
    }

    private async Task AbrirLightbox(Imagen img)
    {
        try
        {
            // Open the ImageLightbox passing the actual Imagen object in the Images parameter
            var imagesParam = new List<Imagen> { img };
            await DialogService.OpenAsync<ImageLightbox>(null,
                new Dictionary<string, object>
                {
                    { "Images", imagesParam },
                    { "CurrentIndex", 0 },
                    { "Alt", img.Nombre }
                },
                new DialogOptions { Width = "90%", Height = "90%" });
        }
        catch (Exception ex)
        {
            try { await JSRuntime.InvokeVoidAsync("console.error", ex.Message); } catch { }
        }
    }

    private async Task ConfirmarPasarAPropietario()
    {
        var mensaje = $"El costo de {detalle.Costo.ToString("C")} pasará a quedar a cargo del propietario y está sujeto a que este lo acepte. ¿Desea continuar?";
        var confirmed = await DialogService.Confirm(mensaje, "Confirmar reasignación",
            new ConfirmOptions { OkButtonText = "Pasar a propietario", CancelButtonText = "Cancelar", Width = "600px" });
        if (confirmed == true)
        {
            await PasarAPropietario();
        }
    }

    private async Task PasarAPropietario()
    {
        try
        {
            if (currentUsuarioId == 0 || detalle.UsuarioId != currentUsuarioId)
            {
                NotificationService.Notify(new NotificationMessage { Severity = NotificationSeverity.Warning, Summary = "No autorizado", Detail = "No puede realizar esta acción." });
                return;
            }

            // Tenant indicates owner should pay => Reasignado Propietario
            detalle.Estado = "Reasignado Propietario";
            var res = await DetalleService.Actualizar(detalle);
            if (res != null && res.Correcto)
            {
                try
                {
                    var hist = new HistorialDetalleTrabajo
                    {
                        DetalleTrabajoId = detalle.DetalleTrabajoId,
                        Fecha = DateTime.Now,
                        Estado = detalle.Estado,
                        UsuarioId = currentUsuarioId,
                        Comentario = "Reasignado al propietario por inquilino"
                    };

                    var hres = await HistorialDetalleService.Crear(hist);
                    if (hres == null || !hres.Correcto)
                    {
                        NotificationService.Notify(new NotificationMessage { Severity = NotificationSeverity.Warning, Summary = "Advertencia", Detail = "Detalle actualizado pero no se pudo registrar historial" });
                    }
                }
                catch (Exception exHist)
                {
                    await JSRuntime.InvokeVoidAsync("console.error", exHist.Message);
                }

                NotificationService.Notify(new NotificationMessage { Severity = NotificationSeverity.Success, Summary = "Actualizado", Detail = "Detalle reasignado al propietario" });
                DialogService.Close(true);
            }
            else
            {
                NotificationService.Notify(new NotificationMessage { Severity = NotificationSeverity.Error, Summary = "Error", Detail = res?.Mensaje ?? "No se pudo actualizar detalle" });
            }
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("console.error", ex.Message);
            NotificationService.Notify(new NotificationMessage { Severity = NotificationSeverity.Error, Summary = "Error", Detail = ex.Message });
        }
    }

    private async Task PasarAInquilinoBloqueado()
    {
        try
        {
            var ownerId = trabajoPadre?.UsuarioCreador ?? 0;
            if (currentUsuarioId == 0 || ownerId != currentUsuarioId)
            {
                NotificationService.Notify(new NotificationMessage { Severity = NotificationSeverity.Warning, Summary = "No autorizado", Detail = "No puede realizar esta acción." });
                return;
            }

            var estadoActual = (detalle?.Estado ?? string.Empty).Trim();
            if (!estadoActual.IndexOf("Propietario", StringComparison.OrdinalIgnoreCase).Equals(-1))
            {
                // Owner decides it must be paid by tenant -> terminal state
            }

            detalle.Estado = "Reasignado Inquilino"; // terminal state
            var res = await DetalleService.Actualizar(detalle);
            if (res != null && res.Correcto)
            {
                try
                {
                    var hist = new HistorialDetalleTrabajo
                    {
                        DetalleTrabajoId = detalle.DetalleTrabajoId,
                        Fecha = DateTime.Now,
                        Estado = detalle.Estado,
                        UsuarioId = currentUsuarioId,
                        Comentario = "Reasignado al inquilino por propietario (final)"
                    };

                    var hres = await HistorialDetalleService.Crear(hist);
                    if (hres == null || !hres.Correcto)
                    {
                        NotificationService.Notify(new NotificationMessage { Severity = NotificationSeverity.Warning, Summary = "Advertencia", Detail = "Detalle actualizado pero no se pudo registrar historial" });
                    }
                }
                catch (Exception exHist)
                {
                    await JSRuntime.InvokeVoidAsync("console.error", exHist.Message);
                }

                NotificationService.Notify(new NotificationMessage { Severity = NotificationSeverity.Success, Summary = "Actualizado", Detail = "Detalle reasignado al inquilino (final)" });
                DialogService.Close(true);
            }
            else
            {
                NotificationService.Notify(new NotificationMessage { Severity = NotificationSeverity.Error, Summary = "Error", Detail = res?.Mensaje ?? "No se pudo actualizar detalle" });
            }
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("console.error", ex.Message);
            NotificationService.Notify(new NotificationMessage { Severity = NotificationSeverity.Error, Summary = "Error", Detail = ex.Message });
        }
    }

    private void Cerrar() => DialogService.Close(false);

    private string ObtenerUrlImagen(Imagen img)
    {
        if (img == null || string.IsNullOrEmpty(img.Url)) return "/images/placeholder.jpg";
        if (img.Url.StartsWith("http")) return img.Url;
        return "/" + img.Url.TrimStart('/');
    }

}
