@page "/trabajos/{Id:int}"
@using AdmIn.Common.Entidades
@using AdmIn.UI.Services
@using AdmIn.UI.Components.Pages.AppPages.Dialogos
@using AdmIn.UI.Components.Shared
@inject IServ_TrabajoProveedor TrabajoService
@inject IServ_HistorialTrabajo HistorialService
@inject IServ_DetalleTrabajo DetalleService
@inject Microsoft.AspNetCore.Components.Authorization.AuthenticationStateProvider authStateProvider
@inject NotificationService NotificationService
@inject DialogService DialogService
@inject NavigationManager Navigation
@inject IServ_Proveedor ProveedorService
@inject IServ_Inmueble InmuebleService
@inject IServ_Usuario UsuarioService
@using AdmIn.Common
@inject IHttpClientFactory HttpClientFactory
@inject AdmIn.UI.Services.UtilityServices.ITokenService TokenService
@inject IJSRuntime JSRuntime
@inject IServ_CalificacionProveedor CalificacionService

<PageTitle>Detalle Trabajo</PageTitle>

<RadzenCard Class="trabajo-detalle-card">
    @if (trabajo == null)
    {
        <div class="loading-placeholder">Cargando...</div>
    }
    else
    {
        <RadzenStack Gap="1rem">
            <div class="header-row">
                <div class="title-wrap">
                    <RadzenText TextStyle="TextStyle.H5" Text=@($"Trabajo #{trabajo.Id}") />
                    <div class="status-badge">@trabajo.Estado</div>
                </div>
                <div class="meta-wrap">
                    <div class="meta-item"><strong>Solicitado:</strong> @trabajo.Fecha.ToString("g")</div>
                    <div class="meta-item"><strong>Creado por:</strong> @(usuarioSolicitante ?? "-")</div>
                </div>

                <!-- Actions for provider/admin depending on permissions -->
                <div class="actions">
                    @if (puedeAceptar)
                    {
                        <RadzenButton ButtonStyle="ButtonStyle.Primary" Text="Aceptar trabajo" Click="@(async () => await AbrirAceptarDialog(trabajo))" />
                        <RadzenButton ButtonStyle="ButtonStyle.Secondary" Text="Rechazar solicitud" Click="@(async () => await AbrirRechazarDialog())" Style="margin-left:8px;" />
                    }

                    @* Reordered buttons: Agregar detalle, Agregar documento, Finalizar trabajo *@
                    @if (puedeAgregarDetalle)
                    {
                        <RadzenButton ButtonStyle="ButtonStyle.Secondary" Text="Agregar detalle" Click="@(async () => await AbrirAgregarDetalle())" Style="margin-left:8px;" />
                    }

                    @if (puedeAgregarDocumento)
                    {
                        <RadzenButton ButtonStyle="ButtonStyle.Primary" Text="Agregar documento" Click="@(async () => await SubirDocumento())" Style="margin-left:8px;" />
                    }

                    @if (puedeFinalizar)
                    {
                        <RadzenButton ButtonStyle="ButtonStyle.Danger" Text="Finalizar trabajo" Click="@(async () => await AbrirFinalizarDialog())" Style="margin-left:8px;" />
                    }

                    @if (puedeRevisarFinalizacion)
                    {
                        <RadzenButton ButtonStyle="ButtonStyle.Primary" Text="Revisar finalización" Click="@(async () => await AbrirRevisarFinalizacionDialog())" Style="margin-left:8px;" />
                    }

                    @* Cancelar trabajo should be always available to owner/admin *@
                    @if (puedeCancelar)
                    {
                        <RadzenButton ButtonStyle="ButtonStyle.Secondary" Text="Cancelar trabajo" Click="@(async () => await AbrirConfirmarCancelarDialog())" Style="margin-left:8px;" />
                    }
                </div>
            </div>

            <RadzenRow Gap="1.5rem">
                <RadzenColumn Size="12" SizeMD="5">
                    <div class="images-panel">
                        @if (trabajo.Imagenes != null && trabajo.Imagenes.Any())
                        {
                            <div class="main-image">
                                <img src="@ObtenerUrlImagen(trabajo.Imagenes.First())" alt="Imagen principal" />
                            </div>

                            <div class="thumbs">
                                @foreach (var img in trabajo.Imagenes)
                                {
                                    <button class="thumb-btn" @onclick="() => SeleccionarImagen(img)">
                                        <img src="@ObtenerUrlImagen(img)" alt="@img.Nombre" />
                                    </button>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="no-images">No hay imágenes para este trabajo</div>
                        }
                    </div>
                </RadzenColumn>

                <RadzenColumn Size="12" SizeMD="7">
                    <RadzenStack Gap="0.5rem">
                        <!-- Inmueble compact card -->
                        <RadzenCard Class="info-card compact">
                            <div class="card-title">Inmueble #@(inmueble?.Id ?? trabajo.InmuebleId) - Nombre: @(inmueble?.Nombre ?? inmuebleNombre ?? "-")</div>
                            <div class="card-body">
                                <div class="card-row">
                                    <div class="card-label">Dirección</div>
                                    <div class="card-data">@(inmueble?.Direccion ?? inmuebleDireccion ?? "-")</div>
                                </div>
                            </div>
                        </RadzenCard>

                        <!-- Proveedor: si hay proveedor asignado, mostrar tarjeta; si no, ofrecer botón para abrir popup -->
                        @if (trabajo.ProveedorId.HasValue && trabajo.ProveedorId.Value != 0 && proveedor != null)
                        {
                            <RadzenCard Class="info-card compact">
                                <div class="card-title">Proveedor #@(proveedor?.Id ?? trabajo.ProveedorId) - Nombre: @(proveedor?.Nombre ?? proveedorNombre ?? "-")</div>
                                <div class="card-body">
                                    <div class="card-row">
                                        <div class="card-label">Dirección</div>
                                        <div class="card-data">@(proveedor?.Direccion ?? proveedorDireccion ?? "-")</div>
                                    </div>

                                    <div class="card-row">
                                        <div class="card-label">Email</div>
                                        <div class="card-data contact-data">
                                            @if (!string.IsNullOrWhiteSpace(proveedor?.Email ?? proveedorEmail))
                                            {
                                                <a href="mailto:@(proveedor?.Email ?? proveedorEmail)">@(proveedor?.Email ?? proveedorEmail)</a>
                                            }
                                            else
                                            {
                                                <span>-</span>
                                            }
                                        </div>

                                        <div class="card-label small-label">Teléfono</div>
                                        <div class="card-data contact-data">
                                            @if (!string.IsNullOrWhiteSpace(proveedor?.Telefono ?? proveedorTelefono))
                                            {
                                                <a href="tel:@(proveedor?.Telefono ?? proveedorTelefono)">@(proveedor?.Telefono ?? proveedorTelefono)</a>
                                            }
                                            else
                                            {
                                                <span>-</span>
                                            }
                                        </div>
                                    </div>

                                    <div class="card-row" style="margin-top:8px; align-items:center; gap:8px;">
                                        <div style="font-weight:700;">Calificación:</div>
                                        <div style="display:flex; align-items:center; gap:8px;">
                                            <RadzenRating Value="@((int)System.Math.Round((double)(proveedor?.CalificacionPromedio ?? 0m)))" Max="5" ReadOnly="true" Style="height:20px;" />
                                            <div style="color:#6b7280; font-size:0.9rem;">(@(proveedor?.TrabajosRealizados ?? 0) trabajos)</div>
                                        </div>
                                    </div>
                                </div>
                            </RadzenCard>
                        }
                        else
                        {
                            <RadzenCard Class="info-card compact">
                                <div class="card-title">No hay proveedor encargado</div>
                                <div class="card-body">
                                    <div>No se ha asignado ningún proveedor a este trabajo.</div>

                                    @if (puedeAsignarProveedor)
                                    {
                                        <div style="margin-top:8px;">
                                            <RadzenButton ButtonStyle="ButtonStyle.Primary" Text="Asignar proveedor y solicitar" Click="@(async () => await MostrarProveedorPicker())" />
                                        </div>
                                    }
                                </div>
                            </RadzenCard>
                        }

                        <!-- Descripción card -->
                        <RadzenCard Class="info-card">
                            <RadzenStack Gap="0.5rem">
                                <div class="card-title">Descripción</div>
                                <div class="card-row">
                                    <div class="card-data descripcion">@trabajo.Descripcion</div>
                                </div>
                            </RadzenStack>
                        </RadzenCard>

                        <!-- Costs card moved under description -->
                        <RadzenCard Class="info-card">
                            <RadzenStack Gap="0.5rem">
                                <RadzenRow>
                                    <RadzenColumn Size="6">
                                        <div class="label">Costo presupuestado</div>
                                        <div class="value estimate">@(trabajo.CostoAproximado?.ToString("C") ?? "-")</div>
                                    </RadzenColumn>
                                    <RadzenColumn Size="6">
                                        <div class="label">Costo acumulado</div>
                                        <div id="costo-acumulado" title="@($"A cargo del inquilino: {TotalInquilino:C}\nA cargo del propietario: {TotalPropietario:C}")" class="value cost">@CostoAcumulado.ToString("C")</div>
                                    </RadzenColumn>
                                </RadzenRow>

                                <RadzenRow>
                                    <RadzenColumn Size="6">
                                        <div class="label">A cargo del inquilino</div>
                                        <div class="value">@TotalInquilino.ToString("C")</div>
                                    </RadzenColumn>
                                    <RadzenColumn Size="6">
                                        <div class="label">A cargo del propietario</div>
                                        <div class="value">@TotalPropietario.ToString("C")</div>
                                    </RadzenColumn>
                                </RadzenRow>

                                <!-- formula row removed: tooltip provides breakdown -->

                            </RadzenStack>
                        </RadzenCard>

                        
                    </RadzenStack>
                </RadzenColumn>
            </RadzenRow>

            <!-- Historial card moved to full width (below main row) -->
            <RadzenCard Class="info-card">
                <RadzenText TextStyle="TextStyle.H6" Text="Historial" />


                @if (historial == null || !historial.Any())
                {
                    <div>No hay historial</div>
                }
                else
                {
                    <div class="historial-list">
                        @foreach (var h in historial)
                        {
                            <div class="historial-item">
                                <div class="hist-date">@h.Fecha.ToString("g")</div>
                                <div class="hist-body">
                                    <div class="hist-state">@h.Estado</div>
                                    <div class="hist-comment">@h.Comentario</div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </RadzenCard>

            <!-- Listado de detalles cargados -->
            <RadzenCard>
                <RadzenText TextStyle="TextStyle.H6" Text="Detalles del trabajo" />


                @if (detalles == null || !detalles.Any())
                {
                    <div>No hay detalles cargados</div>
                }
                else
                {
                    <div class="detalles-list">
                        @foreach (var d in detalles.OrderByDescending(d => d.Fecha))
                        {
                            <RadzenCard Class="detalle-item">
                                <div class="detalle-row">
                                    <div class="detalle-date">@d.Fecha.ToString("g")</div>

                                    <div class="detalle-body">
                                        <div class="detalle-firstline">
                                            <div class="detalle-desc">@d.Descripcion</div>
                                            <div class="detalle-costo">@d.Costo.ToString("C")</div>
                                        </div>

                                        <div class="detalle-secondline">
                                            <div class="detalle-responsable">@GetResponsableLabel(d)</div>
                                            <div class="detalle-actions">
                                                <RadzenButton Size="ButtonSize.Small" Click="@(async () => MostrarDetalle(d))">Ver</RadzenButton>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </RadzenCard>
                        }
                    </div>
                }
            </RadzenCard>

            <!-- Documents card -->
            <RadzenCard Class="info-card">
                <RadzenText TextStyle="TextStyle.H6" Text="Documentos" />


                @* Upload button removed from Documents card; upload is available in header for permitted users *@
                <!--<div class="document-upload">
                    <RadzenButton Text="Subir documento" Click="SubirDocumento" />
                </div>-->

                @if (documentos == null || !documentos.Any())
                {
                    <div>No hay documentos</div>
                }
                else
                {
                    <ul class="document-list">
                        @foreach (var doc in documentos)
                        {
                            <li>
                                <div class="doc-row">
                                    <div class="doc-date">@doc.FechaSubida.ToString("g")</div>

                                    <div class="doc-body">
                                        <div class="doc-firstline">
                                            <div class="doc-desc">@(!string.IsNullOrWhiteSpace(doc.Descripcion) ? doc.Descripcion : (string.IsNullOrWhiteSpace(doc.NombreArchivo) ? "Documento" : doc.NombreArchivo))</div>
                                        </div>

                                        <div class="doc-secondline">
                                            <div class="doc-meta-line">
                                                <span class="doc-uploader-meta">@(string.IsNullOrWhiteSpace(doc.NombreSubidor) ? "-" : doc.NombreSubidor)</span>
                                                <span class="doc-sep"> &nbsp;-&nbsp; </span>
                                                <span class="doc-info-meta">@GetFileTypeLabel(doc)</span>
                                            </div>
                                            <div class="doc-actions">
                                                <RadzenButton Size="ButtonSize.Small" Click="@(async () => await AbrirPreview(doc))">Ver</RadzenButton>
                                            </div>
                                        </div>
                                     </div>
                                 </div>
                             </li>
                         }
                     </ul>
                 }
             </RadzenCard>

            @* Calificación del proveedor (mostrar si existe) *@
            @if (trabajo != null && (trabajo.Estado == TrabajoEstados.Finalizado || trabajo.Estado == TrabajoEstados.FinalizacionAceptadaConObservaciones) && calificacion != null)
            {
                <RadzenCard Class="info-card">
                    <RadzenText TextStyle="TextStyle.H6" Text="Calificación del proveedor" />
                    <div style="display:flex;align-items:center;gap:12px;margin-top:8px;">
                        <RadzenRating Value="calificacion.Valor" Max="5" ReadOnly="true" Style="height:36px;" />
                        <div>
                            <div style="font-weight:700;">@(calificacionUsuarioName ?? "Usuario")</div>
                            <div style="color:#6b7280;font-size:0.95rem;">@calificacion.Fecha.ToString("g")</div>
                        </div>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(calificacion.Comentario))
                    {
                        <div style="margin-top:8px; white-space:pre-wrap;">@calificacion.Comentario</div>
                    }
                </RadzenCard>
            }

        </RadzenStack>
     }
 </RadzenCard>
 
