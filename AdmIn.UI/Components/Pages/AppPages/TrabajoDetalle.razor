@page "/trabajos/{Id:int}"
@using AdmIn.Common.Entidades
@using AdmIn.UI.Services
@using AdmIn.UI.Components.Pages.AppPages.Dialogos
@inject IServ_TrabajoProveedor TrabajoService
@inject IServ_HistorialTrabajo HistorialService
@inject Microsoft.AspNetCore.Components.Authorization.AuthenticationStateProvider authStateProvider
@inject NotificationService NotificationService
@inject DialogService DialogService
@inject NavigationManager Navigation
@inject IServ_Proveedor ProveedorService
@inject IServ_Inmueble InmuebleService
@inject IServ_Usuario UsuarioService

<PageTitle>Detalle Trabajo</PageTitle>

<RadzenCard Class="trabajo-detalle-card">
    @if (trabajo == null)
    {
        <div class="loading-placeholder">Cargando...</div>
    }
    else
    {
        <RadzenStack Gap="1rem">
            <div class="header-row">
                <div class="title-wrap">
                    <RadzenText TextStyle="TextStyle.H5" Text=@($"Trabajo #{trabajo.Id}") />
                    <div class="status-badge">@trabajo.Estado</div>
                </div>
                <div class="meta-wrap">
                    <div class="meta-item"><strong>Solicitado:</strong> @trabajo.Fecha.ToString("g")</div>
                    <div class="meta-item"><strong>Creado por:</strong> @(usuarioSolicitante ?? "-")</div>
                </div>
            </div>

            <RadzenRow Gap="1.5rem">
                <RadzenColumn Size="12" SizeMD="5">
                    <div class="images-panel">
                        @if (trabajo.Imagenes != null && trabajo.Imagenes.Any())
                        {
                            <div class="main-image">
                                <img src="@ObtenerUrlImagen(trabajo.Imagenes.First())" alt="Imagen principal" />
                            </div>

                            <div class="thumbs">
                                @foreach (var img in trabajo.Imagenes)
                                {
                                    <button class="thumb-btn" @onclick="() => SeleccionarImagen(img)">
                                        <img src="@ObtenerUrlImagen(img)" alt="@img.Nombre" />
                                    </button>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="no-images">No hay imágenes para este trabajo</div>
                        }
                    </div>
                </RadzenColumn>

                <RadzenColumn Size="12" SizeMD="7">
                    <div class="details-panel">
                        <div class="row">
                            <div class="label">Inmueble</div>
                            <div class="value inmueble-name">@(inmuebleNombre ?? trabajo.InmuebleId.ToString())</div>
                        </div>

                        <div class="row">
                            <div class="label">Proveedor</div>
                            <div class="value proveedor-name">@(proveedorNombre ?? trabajo.ProveedorId.ToString())</div>
                        </div>

                        <div class="row">
                            <div class="label">Descripción</div>
                            <div class="value descripcion">@trabajo.Descripcion</div>
                        </div>

                        <div class="row two-cols">
                            <div>
                                <div class="label">Costo acumulado</div>
                                <div class="value cost">@trabajo.Costo.ToString("C")</div>
                            </div>
                            <div>
                                <div class="label">Costo presupuestado</div>
                                <div class="value estimate">@(trabajo.CostoAproximado?.ToString("C") ?? "-")</div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="label">Fecha Inicio</div>
                            <div class="value">@(trabajo.FechaInicio?.ToString("g") ?? "-")</div>
                        </div>

                        <div class="actions">
                            @if (puedeAceptar)
                            {
                                <RadzenButton ButtonStyle="ButtonStyle.Success" Click="Aceptar">Aceptar</RadzenButton>
                            }
                            @if (puedeAgregarDetalle)
                            {
                                <RadzenButton Click="AgregarDetalle">Agregar detalle</RadzenButton>
                            }
                            @if (puedeFinalizar)
                            {
                                <RadzenButton ButtonStyle="ButtonStyle.Primary" Click="Finalizar">Finalizar</RadzenButton>
                            }
                        </div>
                    </div>
                </RadzenColumn>
            </RadzenRow>

            <RadzenText TextStyle="TextStyle.H6" Text="Historial" />
            @if (historial == null || !historial.Any())
            {
                <div>No hay historial</div>
            }
            else
            {
                <div class="historial-list">
                    @foreach (var h in historial)
                    {
                        <div class="historial-item">
                            <div class="hist-date">@h.Fecha.ToString("g")</div>
                            <div class="hist-body">
                                <div class="hist-state">@h.Estado</div>
                                <div class="hist-comment">@h.Comentario</div>
                            </div>
                        </div>
                    }
                </div>
            }
        </RadzenStack>
    }
</RadzenCard>

<style>
    .trabajo-detalle-card { padding: 1rem; }
    .header-row { display:flex; justify-content:space-between; align-items:center; gap:1rem; }
    .title-wrap { display:flex; align-items:center; gap:1rem; }
    .status-badge { background:#f3f4f6; padding:6px 10px; border-radius:12px; font-weight:600; color:#374151; }
    .meta-wrap { text-align:right; font-size:0.9rem; color:#6b7280; }

    .images-panel { border:1px solid #e5e7eb; padding:8px; border-radius:8px; }
    .main-image img { width:100%; height:320px; object-fit:cover; border-radius:6px; }
    .thumbs { display:flex; gap:8px; margin-top:8px; overflow-x:auto; }
    .thumb-btn { border: none; background: transparent; padding:0; cursor:pointer; }
    .thumb-btn img { width:80px; height:60px; object-fit:cover; border-radius:6px; border:2px solid transparent; }
    .thumb-btn img:hover { border-color:var(--rz-primary); }
    .no-images { padding:2rem; color:#6b7280; text-align:center; }

    .details-panel { display:flex; flex-direction:column; gap:0.75rem; }
    .details-panel .row { display:flex; flex-direction:column; gap:0.25rem; }
    .details-panel .row.two-cols { display:flex; justify-content:space-between; gap:1rem; }
    .label { color:#6b7280; font-weight:700; font-size:0.85rem; }
    .value { font-size:1rem; color:#111827; }
    .inmueble-name { font-weight:700; }
    .proveedor-name { font-weight:700; }
    .descripcion { white-space:pre-wrap; }
    .cost { color:#059669; font-weight:700; }
    .estimate { color:#f59e0b; font-weight:700; }

    .actions { margin-top:0.5rem; display:flex; gap:0.5rem; }

    .historial-list { display:flex; flex-direction:column; gap:0.75rem; }
    .historial-item { display:flex; gap:1rem; padding:0.5rem; border-left:4px solid #e5e7eb; background:#fafafa; border-radius:6px; }
    .hist-date { font-size:0.85rem; color:#6b7280; min-width:140px; }
    .hist-state { font-weight:700; }
    .hist-comment { color:#374151; }

    @@media (max-width: 768px) {
        .main-image img { height:200px; }
        .header-row { flex-direction:column; align-items:flex-start; }
        .meta-wrap { text-align:left; }
    }
</style>

@code{
    [Parameter] public int Id { get; set; }

    private TrabajoProveedor? trabajo;
    private List<HistorialTrabajo>? historial = new();
    private bool puedeAceptar = false;
    private bool puedeAgregarDetalle = false;
    private bool puedeFinalizar = false;

    // display helpers
    private string? inmuebleNombre;
    private string? proveedorNombre;
    private string? usuarioSolicitante;

    protected override async Task OnInitializedAsync()
    {
        await Cargar();
    }

    private async Task Cargar()
    {
        var res = await TrabajoService.Obtener_por_id(Id);
        if (res != null && res.Correcto && res.Datos != null)
        {
            trabajo = res.Datos;
            // cargar historial
            var h = await HistorialService.Obtener_por_trabajo(Id);
            if (h != null && h.Correcto && h.Datos != null)
            {
                historial = h.Datos.ToList();
            }

            // cargar nombres descriptivos
            try
            {
                var inmRes = await InmuebleService.Obtener_por_id(trabajo.InmuebleId);
                if (inmRes != null && inmRes.Correcto && inmRes.Datos != null)
                {
                    inmuebleNombre = inmRes.Datos.Nombre;
                }
            }
            catch { }

            try
            {
                var provRes = await ProveedorService.Obtener_por_id(trabajo.ProveedorId);
                if (provRes != null && provRes.Correcto && provRes.Datos != null)
                {
                    proveedorNombre = provRes.Datos.Nombre;
                }
            }
            catch { }

            try
            {
                if (trabajo.UsuarioCreador.HasValue)
                {
                    var usrRes = await UsuarioService.Obtener_por_id(trabajo.UsuarioCreador.Value);
                    if (usrRes != null && usrRes.Correcto && usrRes.Datos != null)
                    {
                        usuarioSolicitante = usrRes.Datos.Nombre;
                    }
                }
            }
            catch { }

            var auth = await authStateProvider.GetAuthenticationStateAsync();
            var user = auth.User;

            // Obtener proveedor asociado al usuario actual (por email) y comparar con trabajo.ProveedorId
            var userEmail = user.Identity?.Name;
            int? proveedorIdFromUser = null;
            if (!string.IsNullOrEmpty(userEmail))
            {
                try
                {
                    var provRes2 = await ProveedorService.Obtener_por_email(userEmail);
                    if (provRes2 != null && provRes2.Correcto && provRes2.Datos != null)
                    {
                        proveedorIdFromUser = provRes2.Datos.Id;
                    }
                }
                catch { /* ignore errors */ }
            }

            // Determinar permisos usando el proveedor asociado si existe, si no usar claim Id como fallback
            var userIdClaim = user.FindFirst("Id");
            int.TryParse(userIdClaim?.Value, out int uid);

            var compareId = proveedorIdFromUser ?? uid;

            if (compareId != 0)
            {
                puedeAceptar = (trabajo.ProveedorId == compareId && trabajo.Estado != TrabajoEstados.EnEjecucion && trabajo.Estado != TrabajoEstados.Finalizado);
                puedeAgregarDetalle = trabajo.Estado == TrabajoEstados.EnEjecucion && trabajo.ProveedorId == compareId;
                puedeFinalizar = trabajo.ProveedorId == compareId && trabajo.Estado == TrabajoEstados.EnEjecucion;
            }
        }
        else
        {
            NotificationService.Notify(new NotificationMessage { Severity = NotificationSeverity.Error, Summary = "Error", Detail = "No se pudo cargar el trabajo" });
            Navigation.NavigateTo("/reparaciones");
        }
    }

    private async Task Aceptar()
    {
        var auth = await authStateProvider.GetAuthenticationStateAsync();
        var user = auth.User;
        var userIdClaim = user.FindFirst("Id");
        if (userIdClaim == null || !int.TryParse(userIdClaim.Value, out int uid))
        {
            NotificationService.Notify(new NotificationMessage { Severity = NotificationSeverity.Warning, Summary = "Sin usuario", Detail = "No se pudo identificar el usuario autenticado." });
            return;
        }

        var req = new AceptarTrabajoRequest { TrabajoId = trabajo.Id, UsuarioId = uid, FechaInicio = DateTime.Now, CostoAproximado = trabajo.CostoAproximado ?? 0m };
        var r = await TrabajoService.AceptarTrabajo(req);
        if (r != null && r.Correcto)
        {
            NotificationService.Notify(new NotificationMessage { Severity = NotificationSeverity.Success, Summary = "Aceptado", Detail = r.Mensaje });
            await Cargar();
        }
        else
        {
            NotificationService.Notify(new NotificationMessage { Severity = NotificationSeverity.Error, Summary = "Error", Detail = r?.Mensaje ?? "Error aceptando trabajo" });
        }
    }

    private async Task AgregarDetalle()
    {
        var result = await DialogService.OpenAsync<AgregarDetalleDialog>("Agregar Detalle", new Dictionary<string, object> { { "trabajoid", trabajo.Id } }, new DialogOptions { Width = "600px", Height = "400px" });
        if (result == true) await Cargar();
    }

    private async Task Finalizar()
    {
        if (trabajo == null) return;
        trabajo.Estado = TrabajoEstados.Finalizado;
        var r = await TrabajoService.Actualizar(trabajo);
        if (r != null && r.Correcto)
        {
            NotificationService.Notify(new NotificationMessage { Severity = NotificationSeverity.Success, Summary = "Finalizado", Detail = r.Mensaje });
            await Cargar();
        }
        else
        {
            NotificationService.Notify(new NotificationMessage { Severity = NotificationSeverity.Error, Summary = "Error", Detail = r?.Mensaje ?? "Error finalizando trabajo" });
        }
    }

    private Imagen? imagenSeleccionada;
    private void SeleccionarImagen(Imagen img)
    {
        imagenSeleccionada = img;
        if (imagenSeleccionada != null)
        {
            // desplazar la imagen principal a la seleccionada
            // simple replace in the list: move selected to first position
            if (trabajo?.Imagenes != null)
            {
                var list = trabajo.Imagenes;
                if (list.Contains(img))
                {
                    list.Remove(img);
                    list.Insert(0, img);
                }
            }
        }
    }

    private string ObtenerUrlImagen(Imagen img)
    {
        if (img == null || string.IsNullOrEmpty(img.Url)) return "/images/placeholder.jpg";
        if (img.Url.StartsWith("http")) return img.Url;
        return "/" + img.Url.TrimStart('/');
    }
}
