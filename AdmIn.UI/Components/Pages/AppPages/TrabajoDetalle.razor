 @code{
    [Parameter] public int Id { get; set; }

    private TrabajoProveedor? trabajo;
    private List<HistorialTrabajo>? historial = new();
    private List<DetalleTrabajo>? detalles = new();
    private bool puedeAceptar = false;
    private bool puedeAgregarDetalle = false;
    private bool puedeFinalizar = false;
    private bool puedeAgregarDocumento = false;
    private bool puedeRevisarFinalizacion = false;
    private bool puedeCancelar = false;

    // NUEVAS VARIABLES para asignación (solo flags)
    private bool puedeAsignarProveedor = false;

    // documentos
    private List<TrabajoProveedorDocumento>? documentos = new();

    // full objects
    private Inmueble? inmueble;
    private Proveedor? proveedor;

    // calificacion
    private CalificacionProveedor? calificacion = null;
    private string? calificacionUsuarioName;

    // display helpers
    private string? inmuebleNombre;
    private string? inmuebleDireccion;
    private string? proveedorNombre;
    private string? proveedorDireccion;
    private string? proveedorTelefono;
    private string? proveedorEmail;
    private string? usuarioSolicitante;
    private string? currentUserName;
    private int currentUserId = 0;

    private decimal CostoAcumulado => (detalles?.Sum(d => d.Costo) ?? 0m);
    private decimal TotalInquilino => (detalles?.Where(d => ResponsableEsInquilino(d)).Sum(d => d.Costo) ?? 0m);
    private decimal TotalPropietario => (detalles?.Where(d => !ResponsableEsInquilino(d)).Sum(d => d.Costo) ?? 0m);

    protected override async Task OnInitializedAsync()
    {
        await Cargar();
    }

    private bool InmuebleOcupado()
    {
        try
        {
            if (inmueble == null) return false;
            if (inmueble.Contratos == null) return false;
            var now = DateTime.UtcNow;
            return inmueble.Contratos.Any(c => c.InquilinoId != 0 && (string.IsNullOrEmpty(c.Estado) || c.Estado.Equals("Activo", StringComparison.OrdinalIgnoreCase) || (c.FechaInicio.HasValue && c.FechaInicio.Value <= now && (!c.FechaFin.HasValue || c.FechaFin.Value >= now))));
        }
        catch { return false; }
    }

    private bool ResponsableEsInquilino(DetalleTrabajo d)
    {
        // If estado empty -> depends on inmueble occupancy
        var estado = (d?.Estado ?? string.Empty).Trim();
        if (string.IsNullOrEmpty(estado)) return InmuebleOcupado();

        if (estado.IndexOf("inquilino", StringComparison.OrdinalIgnoreCase) >= 0) return true;
        if (estado.IndexOf("propietario", StringComparison.OrdinalIgnoreCase) >= 0) return false;
        // fallback: if contains reasignado logic, treat accordingly
        return InmuebleOcupado();
    }

    private string GetResponsableLabel(DetalleTrabajo d)
    {
        var estado = (d?.Estado ?? string.Empty).Trim();
        if (string.IsNullOrEmpty(estado)) return InmuebleOcupado() ? "Asignado Inquilino" : "Asignado Propietario";
        if (estado.Equals("Reasignado Inquilino", StringComparison.OrdinalIgnoreCase)) return "Reasignado Inquilino";
        if (estado.Equals("Reasignado Propietario", StringComparison.OrdinalIgnoreCase)) return "Reasignado Propietario";
        if (estado.IndexOf("inquilino", StringComparison.OrdinalIgnoreCase) >= 0) return "A cargo del inquilino";
        if (estado.IndexOf("propietario", StringComparison.OrdinalIgnoreCase) >= 0) return "A cargo del propietario";
        return estado;
    }

    private async Task Cargar()
    {
        var res = await TrabajoService.Obtener_por_id(Id);
        if (res == null || !res.Correcto || res.Datos == null)
        {
            NotificationService.Notify(new NotificationMessage { Severity = NotificationSeverity.Error, Summary = "Error", Detail = "No se pudo cargar el trabajo" });
            Navigation.NavigateTo("/reparaciones");
            return;
        }

        trabajo = res.Datos;

        // cargar historial primero (para posibles fallbacks de usuario)
        try
        {
            var h = await HistorialService.Obtener_por_trabajo(Id);
            if (h != null && h.Correcto && h.Datos != null) historial = h.Datos.ToList();
        }
        catch { }

        // cargar detalles asociados usando endpoint por trabajo para incluir imagenes
        try
        {
            var dres = await DetalleService.Obtener_por_trabajo(trabajo.Id);
            if (dres != null && dres.Correcto && dres.Datos != null)
            {
                detalles = dres.Datos.ToList();
            }
            else
            {
                detalles = new List<DetalleTrabajo>();
            }
        }
        catch { detalles = new List<DetalleTrabajo>(); }

        // cargar documentos
        await CargarDocumentos();

        // cargar nombre del usuario creador si existe (fallback a historial si es necesario)
        try
        {
            if (trabajo.UsuarioCreador.HasValue)
            {
                var usrRes = await UsuarioService.Obtener_por_id(trabajo.UsuarioCreador.Value);
                if (usrRes != null && usrRes.Correcto && usrRes.Datos != null)
                {
                    usuarioSolicitante = usrRes.Datos.Nombre;
                }
            }

            if (string.IsNullOrWhiteSpace(usuarioSolicitante) && historial != null && historial.Any())
            {
                var entryWithUser = historial.FirstOrDefault(h => h.UsuarioId != 0);
                if (entryWithUser != null)
                {
                    try
                    {
                        var u2 = await UsuarioService.Obtener_por_id(entryWithUser.UsuarioId);
                        if (u2 != null && u2.Correcto && u2.Datos != null) usuarioSolicitante = u2.Datos.Nombre;
                    }
                    catch { }
                }
            }
        }
        catch { }

        // obtener auth y posible proveedor asociado por email
        var auth = await authStateProvider.GetAuthenticationStateAsync();
        var user = auth.User;
        var userEmail = user.Identity?.Name;
        currentUserName = user.Identity?.Name;
        int? proveedorIdFromUser = null;
        try
        {
            if (!string.IsNullOrEmpty(userEmail))
            {
                var provByEmail = await ProveedorService.Obtener_por_email(userEmail);
                if (provByEmail != null && provByEmail.Correcto && provByEmail.Datos != null)
                {
                    proveedorIdFromUser = provByEmail.Datos.Id;
                }
            }

            // Fallback: si no se obtuvo proveedor por email, intentar buscar proveedor cuyo UsuarioId coincida con el claim 'Id'
            if (!proveedorIdFromUser.HasValue)
            {
                var userIdClaim = user.FindFirst("Id")?.Value ?? user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
                if (!string.IsNullOrEmpty(userIdClaim) && int.TryParse(userIdClaim, out int userId))
                {
                    try
                    {
                        var allProv = await ProveedorService.Obtener_todos();
                        if (allProv != null && allProv.Correcto && allProv.Datos != null)
                        {
                            var match = allProv.Datos.FirstOrDefault(pr => pr.UsuarioId.HasValue && pr.UsuarioId.Value == userId);
                            if (match != null) proveedorIdFromUser = match.Id;
                        }
                    }
                    catch { /* ignore fallback errors */ }
                }
            }
        }
        catch { }

        // inmueble
        try
        {
            var inmRes = await InmuebleService.Obtener_por_id(trabajo.InmuebleId);
            if (inmRes != null && inmRes.Correcto && inmRes.Datos != null)
            {
                inmueble = inmRes.Datos;
                inmuebleNombre = inmueble?.Nombre;
                inmuebleDireccion = inmueble?.Direccion;
            }
            else
            {
                try
                {
                    var all = await InmuebleService.Obtener_todos();
                    if (all != null && all.Correcto && all.Datos != null)
                    {
                        inmueble = all.Datos.FirstOrDefault(i => i.Id == trabajo.InmuebleId);
                        inmuebleNombre = inmueble?.Nombre;
                        inmuebleDireccion = inmueble?.Direccion;
                    }
                }
                catch { }
            }
        }
        catch { }

        // proveedor
        try
        {
            if (trabajo.ProveedorId.HasValue && trabajo.ProveedorId.Value != 0)
            {
                var provRes = await ProveedorService.Obtener_por_id(trabajo.ProveedorId.Value);
                if (provRes != null && provRes.Correcto && provRes.Datos != null)
                {
                    proveedor = provRes.Datos;
                    proveedorNombre = proveedor?.Nombre;
                    proveedorDireccion = proveedor?.Direccion;
                    proveedorTelefono = proveedor?.Telefono;
                    proveedorEmail = proveedor?.Email;
                }
                else if (proveedorIdFromUser.HasValue && proveedorIdFromUser.Value == trabajo.ProveedorId)
                {
                    try
                    {
                        var pByEmail = await ProveedorService.Obtener_por_email(userEmail);
                        if (pByEmail != null && pByEmail.Correcto && pByEmail.Datos != null)
                        {
                            proveedor = pByEmail.Datos;
                            proveedorNombre = proveedor?.Nombre;
                            proveedorDireccion = proveedor?.Direccion;
                            proveedorTelefono = proveedor?.Telefono;
                            proveedorEmail = proveedor?.Email;
                        }
                    }
                    catch { }
                }
            }
        }
        catch { }

        // permisos
        try
        {
            var userIdClaim = user.FindFirst("Id");
            int.TryParse(userIdClaim?.Value, out int uid);
            currentUserId = uid;
            var compareId = proveedorIdFromUser ?? uid;

            // Compute role flags once to avoid redeclaration/scoping issues
            var isProveedorRole = user.IsInRole("proveedor") || user.Claims.Any(c => c.Type == "role" && c.Value == "proveedor");
            var isAdminRole = user.IsInRole("admin_usuario") || user.IsInRole("admin_propiedad") || user.Claims.Any(c => c.Type == "role" && (c.Value == "admin_usuario" || c.Value == "admin_propiedad"));
            var isPropietarioRole = user.IsInRole("propietario") || user.Claims.Any(c => c.Type == "role" && c.Value == "propietario");

            if (compareId != 0 && trabajo != null)
            {
                // Only allow "Aceptar trabajo" when current user is in 'proveedor' role AND the provider record
                // associated to the current user matches the trabajo.ProveedorId, and state is Creado o Solicitado
                puedeAceptar = isProveedorRole && proveedorIdFromUser.HasValue && trabajo.ProveedorId == proveedorIdFromUser.Value && (trabajo.Estado == TrabajoEstados.Creado || trabajo.Estado == TrabajoEstados.Solicitado);

                // Only allow adding details when current user is the assigned provider
                puedeAgregarDetalle = isProveedorRole && proveedorIdFromUser.HasValue && trabajo.Estado == TrabajoEstados.EnEjecucion && trabajo.ProveedorId == proveedorIdFromUser.Value;

                // Only the assigned provider (role 'proveedor') can finalize the trabajo when it's in execution
                puedeFinalizar = isProveedorRole && proveedorIdFromUser.HasValue && trabajo.ProveedorId == proveedorIdFromUser.Value && trabajo.Estado == TrabajoEstados.EnEjecucion;

                // If current user is the creator/owner or has admin roles, allow reviewing finalization when it's pending
                var esOwnerOrAdmin = false;
                if (trabajo.UsuarioCreador.HasValue && trabajo.UsuarioCreador.Value == uid) esOwnerOrAdmin = true;
                if (isAdminRole) esOwnerOrAdmin = true;

                puedeRevisarFinalizacion = esOwnerOrAdmin && trabajo.Estado == TrabajoEstados.FinalizadoPorAprobar;
            }

            // document upload allowed for provider, propietario/admin and the creator
            try
            {
                var esPropietario = false;

                // If user has explicit propietario role, allow
                if (isPropietarioRole) esPropietario = true;

                // If inmueble has an administrador and it matches current user, consider as propietario/admin
                if (!esPropietario && inmueble != null && uid != 0 && inmueble.AdministradorId.HasValue && inmueble.AdministradorId.Value == uid)
                {
                    esPropietario = true;
                }

                // Fallback: if the current user is the creator of the trabajo, allow uploading
                var esCreador = trabajo?.UsuarioCreador.HasValue == true && trabajo.UsuarioCreador.Value == uid;

                puedeAgregarDocumento = isProveedorRole || isAdminRole || esPropietario || esCreador;

                // If trabajo is pending review, owners/admins can review finalization
                if (trabajo != null && trabajo.Estado == TrabajoEstados.FinalizadoPorAprobar)
                {
                    puedeRevisarFinalizacion = isAdminRole || isPropietarioRole || (trabajo.UsuarioCreador.HasValue && trabajo.UsuarioCreador.Value == uid);
                }

                // Owner / admin can cancel at any time (except when trabajo is Finalizado, server will reject)
                var isOwner = trabajo?.UsuarioCreador.HasValue == true && trabajo.UsuarioCreador.Value == uid;
                puedeCancelar = isAdminRole || isPropietarioRole || isOwner;

                // Permitir asignar proveedor si es admin o el creador (owner)
                puedeAsignarProveedor = isAdminRole || isOwner;
            }
            catch { }
        }
        catch { }

        // If trabajo is already finalizado o cancelado, disable actions and uploading
        if (trabajo.Estado == TrabajoEstados.Finalizado || trabajo.Estado == TrabajoEstados.Cancelado || trabajo.Estado == TrabajoEstados.FinalizacionAceptadaConObservaciones)
        {
            puedeAceptar = false;
            puedeAgregarDetalle = false;
            puedeFinalizar = false;
            puedeAgregarDocumento = false;
            puedeRevisarFinalizacion = false;
            puedeCancelar = false;
        }

        // cargar calificación (si existe) asociada al trabajo (buscar por TrabajoProveedorId, fallback a proveedor)
        try
        {
            var allCalif = await CalificacionService.Obtener_todos();
            if (allCalif != null && allCalif.Correcto && allCalif.Datos != null)
            {
                var list = allCalif.Datos.ToList();
                calificacion = list.Where(c => c.TrabajoProveedorId == trabajo.Id).OrderByDescending(c => c.Fecha).FirstOrDefault()
                    ?? list.Where(c => c.ProveedorId == trabajo.ProveedorId).OrderByDescending(c => c.Fecha).FirstOrDefault();

                if (calificacion != null)
                {
                    try
                    {
                        var ures = await UsuarioService.Obtener_por_id(calificacion.UsuarioId);
                        if (ures != null && ures.Correcto && ures.Datos != null) calificacionUsuarioName = ures.Datos.Nombre;
                    }
                    catch { }
                }
            }
        }
        catch { }

        StateHasChanged();
    }

