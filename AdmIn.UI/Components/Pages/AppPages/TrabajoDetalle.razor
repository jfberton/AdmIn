    private string GetFileTypeLabel(TrabajoProveedorDocumento doc)
    {
        if (!string.IsNullOrWhiteSpace(doc.ContentType))
        {
            // Use common friendly names for some content types
            var ct = doc.ContentType.ToLowerInvariant();
            if (ct.Contains("pdf")) return "PDF";
            if (ct.Contains("image")) return "Imagen";
            if (ct.Contains("word") || ct.Contains("officedocument.wordprocessingml")) return "Documento Word";
            if (ct.Contains("excel") || ct.Contains("officedocument.spreadsheetml")) return "Hoja de cálculo";
            return doc.ContentType;
        }

        // fallback to extension from filename
        try
        {
            var ext = System.IO.Path.GetExtension(doc.NombreArchivo ?? string.Empty);
            if (string.IsNullOrEmpty(ext)) return "Archivo";
            return ext.TrimStart('.').ToUpperInvariant();
        }
        catch { return "Archivo"; }
    }

