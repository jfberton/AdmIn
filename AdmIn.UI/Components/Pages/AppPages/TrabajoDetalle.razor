    private async Task DescargarDocumento(int documentoId)
    {
        try
        {
            var res = await TrabajoService.ObtenerDocumentoPorId(documentoId);
            if (res == null || !res.Correcto || res.Datos == null)
            {
                NotificationService.Notify(new NotificationMessage { Severity = NotificationSeverity.Error, Summary = "Error", Detail = res?.Mensaje ?? "No se pudo obtener el documento" });
                return;
            }

            var doc = res.Datos;
            if (doc.Contenido == null || doc.Contenido.Length == 0)
            {
                NotificationService.Notify(new NotificationMessage { Severity = NotificationSeverity.Error, Summary = "Error", Detail = "Contenido no disponible" });
                return;
            }

            var filename = string.IsNullOrWhiteSpace(doc.NombreArchivo) ? "documento" : doc.NombreArchivo;
            var contentType = string.IsNullOrWhiteSpace(doc.ContentType) ? "application/octet-stream" : doc.ContentType;

            await JSRuntime.InvokeVoidAsync("blazorDownloadFile", filename, contentType, Convert.ToBase64String(doc.Contenido));
        }
        catch (Exception ex)
        {
            NotificationService.Notify(new NotificationMessage { Severity = NotificationSeverity.Error, Summary = "Error", Detail = ex.Message });
        }
    }

