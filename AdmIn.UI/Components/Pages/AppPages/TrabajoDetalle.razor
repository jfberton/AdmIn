    // Asigna proveedor, actualiza trabajo y solicita (genera historial y notifica) — reusa servicio backend
    private async Task SelectProveedorParaTrabajo(Proveedor? p)
    {
        if (p == null || trabajo == null) return;

        // Asignar proveedor localmente sin cambiar estado todavía
        trabajo.ProveedorId = p.Id;

        var upd = await TrabajoService.Actualizar(trabajo);
        if (upd == null || !upd.Correcto)
        {
            NotificationService.Notify(new NotificationMessage { Severity = NotificationSeverity.Error, Summary = "Error", Detail = upd?.Mensaje ?? "No se pudo asignar proveedor" });
            return;
        }

        // Construir comentario para el historial: preferir nombre de usuario asociado al proveedor si existe
        string comentario = $"Solicitado a {p.Nombre}";
        if (p.UsuarioId.HasValue && p.UsuarioId.Value != 0)
        {
            try
            {
                var ures = await UsuarioService.Obtener_por_id(p.UsuarioId.Value);
                if (ures != null && ures.Correcto && ures.Datos != null && !string.IsNullOrWhiteSpace(ures.Datos.Nombre))
                {
                    comentario = $"Solicitado al proveedor {ures.Datos.Nombre}";
                }
            }
            catch { /* no bloquear */ }
        }

        // Llamar al endpoint de solicitar para que el servidor cambie el estado y cree el historial
        try
        {
            var sol = await TrabajoService.SolicitarTrabajo(new TrabajoAccionRequest { TrabajoId = trabajo.Id, UsuarioId = currentUserId, Comentario = comentario });
            if (sol != null && sol.Correcto)
            {
                NotificationService.Notify(new NotificationMessage { Severity = NotificationSeverity.Success, Summary = "Ok", Detail = "Proveedor asignado y solicitud enviada." });
            }
            else
            {
                NotificationService.Notify(new NotificationMessage { Severity = NotificationSeverity.Warning, Summary = "Advertencia", Detail = sol?.Mensaje ?? "Proveedor asignado pero no se pudo enviar la solicitud." });
            }
        }
        catch (Exception ex)
        {
            NotificationService.Notify(new NotificationMessage { Severity = NotificationSeverity.Warning, Summary = "Advertencia", Detail = "Proveedor asignado pero error enviando solicitud: " + ex.Message });
        }

        // recargar vista para leer historial actualizado
        await Cargar();
    }
