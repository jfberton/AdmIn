@page "/admin/password-migration-status"
@using AdmIn.Business.Servicios
@using AdmIn.Common.Utilidades
@using AdmIn.UI.Components.Pages.AppPages
@inherits BaseComponent
@inject IServ_Usuario serv_usuario
@inject IPasswordService passwordService

<PageTitle>Estado de Migración de Contraseñas</PageTitle>

<RadzenCard>
    <RadzenText TextStyle="TextStyle.H4" TagName="TagName.H1">
        Estado de Migración de Contraseñas
    </RadzenText>
    
    <RadzenText TextStyle="TextStyle.Body1" class="rz-mb-4">
        Monitoreo del progreso de migración de contraseñas SHA512 a bcrypt.
    </RadzenText>

    @if (loading)
    {
        <RadzenProgressBarCircular ShowValue="false" Mode="ProgressBarMode.Indeterminate" />
        <RadzenText>Cargando estadísticas...</RadzenText>
    }
    else if (estadisticas != null)
    {
        <RadzenRow Gap="2rem" class="rz-mb-4">
            <RadzenColumn Size="12" SizeMD="3">
                <RadzenCard>
                    <RadzenStack Orientation="Orientation.Vertical" AlignItems="AlignItems.Center">
                        <RadzenText TextStyle="TextStyle.H6">Total Usuarios</RadzenText>
                        <RadzenText TextStyle="TextStyle.H4" class="rz-color-success">
                            @estadisticas.TotalUsuarios
                        </RadzenText>
                    </RadzenStack>
                </RadzenCard>
            </RadzenColumn>
            
            <RadzenColumn Size="12" SizeMD="3">
                <RadzenCard>
                    <RadzenStack Orientation="Orientation.Vertical" AlignItems="AlignItems.Center">
                        <RadzenText TextStyle="TextStyle.H6">Con bcrypt</RadzenText>
                        <RadzenText TextStyle="TextStyle.H4" class="rz-color-success">
                            @estadisticas.UsuariosConBcrypt
                        </RadzenText>
                    </RadzenStack>
                </RadzenCard>
            </RadzenColumn>
            
            <RadzenColumn Size="12" SizeMD="3">
                <RadzenCard>
                    <RadzenStack Orientation="Orientation.Vertical" AlignItems="AlignItems.Center">
                        <RadzenText TextStyle="TextStyle.H6">Con SHA512</RadzenText>
                        <RadzenText TextStyle="TextStyle.H4" class="rz-color-warning">
                            @estadisticas.UsuariosConSHA512
                        </RadzenText>
                    </RadzenStack>
                </RadzenCard>
            </RadzenColumn>
            
            <RadzenColumn Size="12" SizeMD="3">
                <RadzenCard>
                    <RadzenStack Orientation="Orientation.Vertical" AlignItems="AlignItems.Center">
                        <RadzenText TextStyle="TextStyle.H6">% Migrado</RadzenText>
                        <RadzenText TextStyle="TextStyle.H4" class="rz-color-info">
                            @estadisticas.PorcentajeMigrado.ToString("F1")%
                        </RadzenText>
                    </RadzenStack>
                </RadzenCard>
            </RadzenColumn>
        </RadzenRow>

        <RadzenCard class="rz-mb-4">
            <RadzenText TextStyle="TextStyle.H6" class="rz-mb-2">Progreso de Migración</RadzenText>
            <RadzenProgressBar Value="@estadisticas.PorcentajeMigrado" Max="100" ShowValue="true" />
        </RadzenCard>

        <RadzenAlert AlertStyle="AlertStyle.Info" Variant="Variant.Flat" Shade="Shade.Light">
            <RadzenText TextStyle="TextStyle.Body2">
                <strong>Información:</strong> La migración de contraseñas se realiza automáticamente cuando los usuarios inician sesión.
                No es necesaria ninguna acción manual. Los usuarios con SHA512 migrarán gradualmente a bcrypt.
            </RadzenText>
        </RadzenAlert>

        @if (estadisticas.UsuariosConSHA512 > 0)
        {
            <RadzenAlert AlertStyle="AlertStyle.Warning" Variant="Variant.Flat" Shade="Shade.Light" class="rz-mt-3">
                <RadzenText TextStyle="TextStyle.Body2">
                    <strong>Pendientes:</strong> @estadisticas.UsuariosConSHA512 usuarios aún tienen contraseñas SHA512.
                    Migrarán automáticamente en su próximo inicio de sesión.
                </RadzenText>
            </RadzenAlert>
        }
        else
        {
            <RadzenAlert AlertStyle="AlertStyle.Success" Variant="Variant.Flat" Shade="Shade.Light" class="rz-mt-3">
                <RadzenText TextStyle="TextStyle.Body2">
                    <strong>¡Migración Completa!</strong> Todos los usuarios han migrado exitosamente a bcrypt.
                </RadzenText>
            </RadzenAlert>
        }
    }
    else if (error != null)
    {
        <RadzenAlert AlertStyle="AlertStyle.Danger">
            <RadzenText>Error al cargar estadísticas: @error</RadzenText>
        </RadzenAlert>
    }

    <RadzenStack Orientation="Orientation.Horizontal" Gap="1rem" class="rz-mt-4">
        <RadzenButton Icon="refresh" Text="Actualizar" Click="@LoadStatistics" ButtonStyle="ButtonStyle.Primary" />
    </RadzenStack>
</RadzenCard>

@code {
    private bool loading = true;
    private string? error = null;
    private EstadisticasMigracion? estadisticas = null;

    public class EstadisticasMigracion
    {
        public int TotalUsuarios { get; set; }
        public int UsuariosConBcrypt { get; set; }
        public int UsuariosConSHA512 { get; set; }
        public double PorcentajeMigrado => TotalUsuarios > 0 ? (double)UsuariosConBcrypt / TotalUsuarios * 100 : 0;
    }

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        EstablecerTituloPagina("Estado de Migración de Contraseñas", "Administración");
        await LoadStatistics();
    }

    private async Task LoadStatistics()
    {
        loading = true;
        error = null;
        estadisticas = null;

        try
        {
            var usuariosResult = await serv_usuario.Obtener_todos();
            
            if (usuariosResult.Correcto && usuariosResult.Datos != null)
            {
                var usuarios = usuariosResult.Datos.ToList();
                
                estadisticas = new EstadisticasMigracion
                {
                    TotalUsuarios = usuarios.Count,
                    UsuariosConBcrypt = usuarios.Count(u => MiHash.EsHashBcrypt(u.Password)),
                    UsuariosConSHA512 = usuarios.Count(u => !MiHash.EsHashBcrypt(u.Password))
                };
            }
            else
            {
                error = usuariosResult.Mensaje ?? "Error al obtener usuarios";
            }
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            loading = false;
        }
    }
}