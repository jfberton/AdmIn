@using AdmIn.Common.Entidades
@using Microsoft.AspNetCore.Components

<div class="proveedor-card @((Selectable) ? "selectable" : "") @(Selected ? "selected" : "")" role="button" @onclick="HandleClick">
    <div class="card-body d-flex gap-3 align-items-start">
        <div class="avatar-wrap">
            @if (!string.IsNullOrEmpty(ImageUrl))
            {
                <img src="@ImageUrl" alt="@Proveedor?.Nombre" class="avatar-img" />
            }
            else
            {
                <div class="avatar-placeholder"><i class="fas fa-user"></i></div>
            }
        </div>

        <div class="proveedor-info flex-grow-1">
            <div class="small text-muted mb-1">PROVEEDOR</div>
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <div class="proveedor-name">@Proveedor?.Nombre</div>
                    @if (ServiciosDisplay != null)
                    {
                        <div class="proveedor-services small text-muted">@ServiciosDisplay</div>
                    }
                </div>
                <div class="text-end stats-wrap">
                    <div class="rating-badge" title="Calificación promedio de este proveedor">
                        <i class="fas fa-star" aria-hidden="true"></i>
                        @((Rating.HasValue) ? Rating.Value.ToString("0.0") : "-")
                    </div>
                    @{
                        // Fallback: usar JobsCount si llegó desde el padre, sino usar Proveedor.TrabajosRealizados
                        string jobsDisplay;
                        if (JobsCount.HasValue)
                        {
                            jobsDisplay = $"{JobsCount.Value} trabajos";
                        }
                        else if (Proveedor?.TrabajosRealizados > 0)
                        {
                            jobsDisplay = $"{Proveedor.TrabajosRealizados} trabajos";
                        }
                        else
                        {
                            jobsDisplay = "-";
                        }
                    }
                    <div class="jobs-count small text-muted" title="Cantidad de trabajos completados por este proveedor">
                        <i class="fas fa-key jobs-icon" aria-hidden="true"></i>
                        @jobsDisplay
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
.proveedor-card {
    width: 320px;
    border-radius: 8px;
    background: #ffffff;
    box-shadow: 0 6px 18px rgba(0,0,0,0.08);
    overflow: hidden;
    border: 1px solid #e6e6e6;
    cursor: default;
}
.proveedor-card.selectable { cursor: pointer; transition: transform 0.15s ease, box-shadow 0.15s ease; }
.proveedor-card.selectable:hover { transform: translateY(-4px); box-shadow: 0 10px 26px rgba(0,0,0,0.12); }
.proveedor-card.selected { border-color: #0ea5e9; box-shadow: 0 10px 26px rgba(14,165,233,0.12); }
.card-body { padding: 1rem; }
.avatar-wrap { width: 64px; height: 64px; flex: 0 0 64px; }
.avatar-img { width: 64px; height: 64px; border-radius: 50%; object-fit: cover; border: 3px solid #f3f4f6; }
.avatar-placeholder { width: 64px; height: 64px; border-radius: 50%; background: #f3f4f6; display:flex; align-items:center; justify-content:center; color:#9ca3af; font-size:24px; border: 3px solid #e9e9e9; }
.proveedor-name { font-weight:700; font-size:1rem; color:#1f2937; }
.proveedor-services { margin-top:0.25rem; max-width: calc(100% - 90px); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

/* Rating and jobs styles */
.stats-wrap { min-width: 92px; display:flex; flex-direction:column; align-items:flex-end; gap:6px; }
.rating-badge { display:inline-flex; align-items:center; gap:6px; background:#f3f4f6; padding:0.25rem 0.5rem; border-radius:6px; font-weight:600; color:#111827; margin-bottom:0.25rem; }
.rating-icon { color:#f59e0b; font-size:0.95rem; }

/* Jobs with key icon */
.jobs-count { display:inline-flex; align-items:center; gap:6px; color:#6b7280; font-size:0.85rem; }
.jobs-icon { color:#6b7280; font-size:0.95rem; }

/* Responsive tweaks */
@@media (max-width: 480px) {
    .proveedor-card { width: 100%; }
}
</style>

@code {
    [Parameter] public Proveedor? Proveedor { get; set; }
    [Parameter] public bool Selectable { get; set; } = true;
    [Parameter] public EventCallback<Proveedor?> OnSelect { get; set; }

    // Optional overrides
    [Parameter] public string? ImageUrl { get; set; }
    [Parameter] public IEnumerable<TipoServicio>? Servicios { get; set; }
    [Parameter] public decimal? Rating { get; set; }
    [Parameter] public int? JobsCount { get; set; }
    [Parameter] public bool Selected { get; set; }

    private string? ServiciosDisplay => (Servicios != null && Servicios.Any()) ? string.Join(", ", Servicios.Select(s => s.Nombre)) : null;

    private async Task HandleClick()
    {
        if (Selectable)
        {
            await OnSelect.InvokeAsync(Proveedor);
        }
    }
}
