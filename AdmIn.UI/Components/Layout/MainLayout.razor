@using AdmIn.Common.Entidades
@using AdmIn.UI.Authentication
@using AdmIn.UI.Services;
@using AdmIn.UI.Services.UtilityServices;
@using Microsoft.AspNetCore.Components.Authorization
@using Radzen
@using AdmIn.UI.Components.Shared

@inherits LayoutComponentBase
@implements IDisposable

@inject NavigationManager navManager
@inject AuthenticationStateProvider authStateProvider
@inject IServ_Usuario serv_Usuario;
@inject DialogService dialogService
@inject NotificationService notificationService
@inject IJSRuntime JS
@inject DeviceService DeviceService
@inject PageTitleService PageTitleService
@inject IServ_Notificacion servNotificacion

<RadzenDialog />
<RadzenNotification />
<RadzenContextMenu />
<RadzenTooltip />
<RadzenComponents />

<RadzenComponents @rendermode="InteractiveServer" />

<RadzenLayout>
    @if (DeviceService.IsMobileDevice())
    {
        <RadzenHeader>
            <RadzenRow>
                <RadzenColumn Size="12">
                    <div class="header-content">
                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                            <RadzenSidebarToggle Click="@(() => sidebar1Expanded = !sidebar1Expanded)" />
                            <RadzenImage class="header-logo scaled"
                                         Path="@GetLogoPath()"
                                         Style="max-height: 56px; max-width: 180px; height: 56px; width: auto; object-fit: contain;" />
                        </RadzenStack>
                        <div class="header-title">
                            <strong>@PageTitleService.Titulo</strong>
                            @if (!string.IsNullOrEmpty(PageTitleService.Subtitulo))
                            {
                                <span>&nbsp;- @PageTitleService.Subtitulo</span>
                            }
                        </div>
                    </div>
                </RadzenColumn>
            </RadzenRow>
        </RadzenHeader>
    }
    else
    {
        <RadzenHeader>
            <RadzenRow>
                <RadzenColumn Size="12">
                    <div class="header-content">
                        <div class="header-left" style="display:flex;align-items:center;gap:0.5rem;flex:0 0 auto;">
                            <RadzenSidebarToggle Click="@(() => sidebar1Expanded = !sidebar1Expanded)" />
                            <RadzenImage class="header-logo scaled"
                                         Path="@GetLogoPath()"
                                         Style="max-height: 56px; max-width: 150px; height: 56px; width: auto; object-fit: contain;" />
                        </div>

                        <div class="header-title">
                            <strong>@PageTitleService.Titulo</strong>
                            @if (!string.IsNullOrEmpty(PageTitleService.Subtitulo))
                            {
                                <span>&nbsp;- @PageTitleService.Subtitulo</span>
                            }
                        </div>

                        <div class="header-actions">
                            <AuthorizeView>
                                <Authorized>
                                    <div style="display:flex;align-items:center;gap:0.5rem;">
                                        <NotificationBell />
                                        <RadzenProfileMenu>
                                            <Template>
                                                @if (usuarioActual?.ObtenerUrlImagenPerfil() != null)
                                                {
                                                    <ProfilePhotoComponent Usuario="@usuarioActual" Tamaño="32" />
                                                }
                                                else
                                                {
                                                    <div style="width: 32px; height: 32px; border-radius: 50%; background: #f3f4f6; display: flex; align-items: center; justify-content: center; border: 2px solid #e5e7eb;">
                                                        <RadzenIcon Icon="account_circle" Style="font-size: 20px; color: #6b7280;" />
                                                    </div>
                                                }
                                            </Template>
                                            <ChildContent>
                                                <RadzenStack Gap="0" Orientation="Orientation.Vertical" AlignItems="AlignItems.Center" class="rz-p-2">
                                                    <ProfilePhotoComponent Usuario="@usuarioActual" Tamaño="64" ClasesAdicionales="mb-2" />
                                                    <RadzenText TextStyle="TextStyle.Overline">Bienvenido</RadzenText>
                                                    <RadzenText TextStyle="TextStyle.Body1"><b>@userName</b></RadzenText>
                                                    <RadzenButton Icon="person" Variant="Variant.Text" Size="ButtonSize.Small" Click="@(() => IrAPerfil())">Ver mi perfil</RadzenButton>
                                                    <RadzenButton Icon="lock_reset" Variant="Variant.Text" Size="ButtonSize.Small" Click="@(() => CambiarPassword())">Cambiar contraseña</RadzenButton>
                                                    <RadzenButton Icon="logout" Variant="Variant.Text" Size="ButtonSize.Small" Click="@(() => Logout())">Cerrar sesión</RadzenButton>
                                                </RadzenStack>
                                            </ChildContent>
                                        </RadzenProfileMenu>
                                    </div>
                                </Authorized>
                            </AuthorizeView>
                        </div>
                    </div>
                </RadzenColumn>
            </RadzenRow>
        </RadzenHeader>
    }

    <RadzenSidebar @bind-Expanded="@sidebar1Expanded">
        <RadzenPanelMenu>
            <MenuItem Text="Mi Perfil" Icon="person" Path="/mi-perfil" Roles="admin_usuario" OnMenuItemClick="@OnMenuItemClick" />
            <MenuItem Text="Usuarios" Icon="person_outline" Path="/usuarios" Roles="admin_usuario" OnMenuItemClick="@OnMenuItemClick" />
            <MenuItem Text="Características" Icon="category" Path="/caracteristicas" Roles="admin_usuario" OnMenuItemClick="@OnMenuItemClick" />
            <MenuItem Text="Tipos de Servicio" Icon="construction" Path="/tipos-servicio" Roles="admin_usuario" OnMenuItemClick="@OnMenuItemClick" />
            <MenuItem Text="Proveedores" Icon="business" Path="/proveedores" Roles="admin_usuario" OnMenuItemClick="@OnMenuItemClick" />
            <MenuItem Text="Monedas" Icon="currency_exchange" Path="/monedas" Roles="admin_usuario" OnMenuItemClick="@OnMenuItemClick" />
            <MenuItem Text="Inmuebles" Icon="apartment" Path="/inmuebles" Roles="admin_propiedad, propietario" OnMenuItemClick="@OnMenuItemClick" />
            <MenuItem Text="Reparaciones" Icon="build" Path="/reparaciones" Roles="add_reparacion, admin_reparacion, proveedor" OnMenuItemClick="@OnMenuItemClick" />
            <MenuItem Text="Prueba de Email" Icon="email" Path="/admin/test-email" Roles="admin_sistema" OnMenuItemClick="@OnMenuItemClick" />
        </RadzenPanelMenu>
    </RadzenSidebar>

    <RadzenBody>
        <div class="rz-p-4">
            <AuthorizeView>
                <Authorized>
                    @Body
                </Authorized>
                <NotAuthorized>
                    @{
                    // If the current route is the public password reset page, render the page body
                    var relative = navManager.Uri.Replace(navManager.BaseUri, "/");
                    var path = relative.TrimStart('/');
                    var isPublicReset = path.StartsWith("request-password-reset", StringComparison.OrdinalIgnoreCase) ||
    path.StartsWith("confirm-password-reset", StringComparison.OrdinalIgnoreCase);
                    }
                    @if (isPublicReset)
                    {
                    @Body
                    }
                    else
                    {
                    <div>
                    <h1>Hola invitado!</h1>
                    <p>Debes <a href="/">iniciar sesión</a> para acceder a la aplicación.</p>
                    </div>
                    }
                </NotAuthorized>
            </AuthorizeView>
        </div>
    </RadzenBody>
    <RadzenFooter>
        <div class="d-flex justify-content-center">@footerText</div>
    </RadzenFooter>
</RadzenLayout>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>

<style>
    .mb-2 {
        margin-bottom: 0.5rem;
    }

    /* Mantener altura del header y permitir que la imagen escalada se dibuje por encima sin aumentar el alto */
    .header-content {
        height: 56px;
        display: flex;
        align-items: center;
        justify-content: space-between; /* asegurar que logo y acciones queden a los extremos */
        gap: 0.75rem;
        width: 100%;
        overflow: visible; /* permitir overflow para que la imagen escalada no recorte */
        flex-wrap: nowrap; /* evitar que elementos hagan wrap a otra línea */
    }

    /* Contenedor del título dentro del header: evitar que haga wrap y permitir truncado */
    .header-title {
        margin-left: 0.5rem;
        flex: 1 1 auto; /* permitir que ocupe el espacio restante */
        min-width: 0; /* imprescindible para que text-overflow funcione en flex items */
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        display: block;
    }

    .header-actions {
        flex: 0 0 auto;
        display: flex;
        align-items: center;
        gap: 0.5rem;
        min-width: 0;
    }

    .header-logo {
        height: 56px;
        transition: transform 0.12s ease;
        transform-origin: left center;
        display: inline-block;
        flex: 0 0 auto; /* no permitir que el logo se estire */
        max-width: 150px; /* limit actual width so layout reserves space */
        width: auto;
    }

    /* Ajuste visual: aumentar tamaño reservando espacio en el layout */
    .header-logo.scaled {
        transform: none; /* remove visual scaling to avoid overlapping title */
        height: 56px;
        max-width: 150px;
        width: auto;
    }
</style>

<script>
    // Ensure helper exists for downloads (used by blazor components)
    window.blazorDownloadFile = window.blazorDownloadFile || function (filename, contentType, base64Data) {
        try {
            var link = document.createElement('a');
            link.href = 'data:' + (contentType || 'application/octet-stream') + ';base64,' + base64Data;
            link.download = filename || 'download';
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
        } catch (e) {
            console.error('blazorDownloadFile error', e);
        }
    };

    window.openBlobFromBase64 = window.openBlobFromBase64 || function (contentType, base64Data) {
        try {
            var byteCharacters = atob(base64Data);
            var byteNumbers = new Array(byteCharacters.length);
            for (var i = 0; i < byteCharacters.length; i++) {
                byteNumbers[i] = byteCharacters.charCodeAt(i);
            }
            var byteArray = new Uint8Array(byteNumbers);
            var blob = new Blob([byteArray], { type: contentType });
            var url = URL.createObjectURL(blob);
            window.open(url, '_blank');
            // Optionally revoke object URL after some time
            setTimeout(function () { URL.revokeObjectURL(url); }, 60000);
        } catch (e) {
            console.error('openBlobFromBase64 error', e);
            alert('No se pudo abrir el documento en nueva pestaña.');
        }
    };
</script>

@code {
    bool sidebar1Expanded = true;
    string footerText = $"Sistema de administración de inmuebles - {DateTime.Now.Year}";
    private string userName;
    private Usuario? usuarioActual;

    protected override async Task OnInitializedAsync()
    {
        var authState = await authStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        userName = user.FindFirst("Nombre")?.Value ?? "Invitado";
        
        // Cargar datos completos del usuario incluyendo imagen de perfil
        await CargarUsuarioCompleto();
        
        // Si el usuario es un proveedor autenticado y está en la home/root, redirigir a su panel de trabajos
        try
        {
            var isProveedor = user.IsInRole("proveedor") || user.Claims.Any(c => c.Type == "role" && c.Value == "proveedor");
            if (isProveedor)
            {
                var current = navManager.Uri.Replace(navManager.BaseUri, "/");
                // normalize
                if (string.IsNullOrEmpty(current) || current == "/" || current.Equals("/home", StringComparison.OrdinalIgnoreCase))
                {
                    // navegar al panel de reparaciones para proveedores
                    navManager.NavigateTo("/reparaciones");
                }
            }
        }
        catch { }
    }

    private string GetLogoPath()
    {
        // Use the transparent PNG logo in wwwroot/img
        return "img/logo.png";
    }

    private async Task CargarUsuarioCompleto()
    {
        try
        {
            var authState = await authStateProvider.GetAuthenticationStateAsync();
            var userEmail = authState.User.Identity?.Name;
            
            if (!string.IsNullOrEmpty(userEmail))
            {
                var resultado = await serv_Usuario.Obtener_usuario_por_email(userEmail);
                if (resultado != null && resultado.Correcto && resultado.Datos != null)
                {
                    usuarioActual = resultado.Datos;
                }
                else
                {
                    // No usuario completo disponible for this email (e.g. external roles like proveedor)
                    usuarioActual = null;
                }
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            // Manejar error silenciosamente para no afectar la carga de la página
            Console.WriteLine($"[MainLayout] Error cargando usuario completo: {ex.Message}");
        }
    }

    protected override void OnInitialized()
    {
        PageTitleService.Register(async () => await InvokeAsync(StateHasChanged));
        
        // Suscribirse a cambios de navegación para recargar usuario
        navManager.LocationChanged += OnLocationChanged;
    }

    private async void OnLocationChanged(object sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        // Recargar usuario cuando se navega a mi-perfil (por si cambió la foto)
        if (e.Location.Contains("/mi-perfil"))
        {
            await CargarUsuarioCompleto();
        }
    }

    protected override void OnParametersSet()
    {
        PageTitleService.ResetTitle();
    }

    public void Dispose()
    {
        navManager.LocationChanged -= OnLocationChanged;
    }

    private async Task Logout()
    {
        if (authStateProvider is CustomAuthenticationStateProvider customAuthStateProvider)
        {
            await customAuthStateProvider.Logout();
            navManager.NavigateTo("/", true);
        }
    }

    private async Task OnMenuItemClick()
    {
        if (DeviceService.IsMobileDevice())
        {
            sidebar1Expanded = false;
        }
    }

    private void IrAPerfil()
    {
        navManager.NavigateTo("/mi-perfil");
    }

    private async Task CambiarPassword()
    {
        Usuario usuario = new Usuario();
        var authState = await authStateProvider.GetAuthenticationStateAsync();
        usuario.Email = authState.User.Identity.Name;

        if (usuario.Email.Contains("@mock.com"))
        {
            notificationService.Notify(NotificationSeverity.Warning, "Atención!", "No se puede editar contraseña de usuario mock");
        }
        else
        {
            var rta_usuario = await serv_Usuario.Obtener_usuario_por_email(usuario.Email);

            if (rta_usuario.Correcto)
            {
                usuario = rta_usuario.Datos;
                navManager.NavigateTo($"/usuarios/update-password/{usuario.Id}/home");
            }
        }
    }
}